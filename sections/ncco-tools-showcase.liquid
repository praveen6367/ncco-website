{%- assign accent = section.settings.accent_color | default: '#FECB07' -%}
{%- assign cta_variant = section.settings.cta_variant | default: 'blue' -%}
{%- assign image_blocks = section.blocks | where: 'type', 'image' -%}
<section class="ncco-tshow" style="--brand-accent:{{ accent }}">
  <div class="ncco-tshow__inner">
    <div class="ncco-tshow__head">
      <div class="ncco-tshow__eyebrow-wrap ncco-reveal">
        <span class="ncco-tshow__eyebrow-bar"></span>
        {% if section.settings.eyebrow != blank %}
          <p class="ncco-tshow__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
      </div>
      <div class="ncco-tshow__row">
        <div class="ncco-tshow__text-col ncco-reveal ncco-reveal--d1">
          {% if section.settings.heading != blank %}
            <h2 class="ncco-tshow__heading">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.body != blank %}
            <p class="ncco-tshow__body">{{ section.settings.body }}</p>
          {% endif %}
        </div>
        {% if section.settings.cta_label != blank %}
          <div class="ncco-tshow__cta ncco-reveal ncco-reveal--d2">
            {%- render 'ncco-cta', label: section.settings.cta_label, url: section.settings.cta_url, variant: cta_variant -%}
          </div>
        {% endif %}
      </div>
    </div>

    {% if image_blocks.size > 0 %}
      <div class="ncco-tshow__images">
        {% for block in image_blocks %}
          <div class="ncco-tshow__img-wrap ncco-reveal ncco-reveal--d{{ forloop.index | plus: 2 }}" {{ block.shopify_attributes }}>
            {% if block.settings.asset != blank %}
              <img src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.alt }}" loading="lazy">
            {% elsif block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.alt }}" loading="lazy">
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
.ncco-tshow {
  padding: 120px 0 100px;
  background: #fff;
}
.ncco-tshow__inner {
  max-width: 1856px; margin: 0 auto;
  padding: 0 16px;
  display: flex; flex-direction: column; gap: 50px;
}

.ncco-tshow__head {
  max-width: 1440px; width: 100%; margin: 0 auto;
  padding: 0 24px; box-sizing: border-box;
  display: flex; flex-direction: column; gap: 40px;
}
.ncco-tshow__eyebrow-wrap {
  display: flex; flex-direction: column; align-items: flex-start; gap: 8px;
}
.ncco-tshow__eyebrow-bar {
  display: block; width: 28px; height: 2px; background: var(--brand-accent, #FECB07);
}
.ncco-tshow__eyebrow {
  font-family: 'Geist', sans-serif;
  font-size: 16px; font-weight: 500;
  color: #647082; text-transform: uppercase; margin: 0;
  letter-spacing: 0;
}

.ncco-tshow__row {
  display: flex; justify-content: space-between; align-items: flex-end;
  gap: 40px;
}
.ncco-tshow__text-col {
  max-width: 630px;
  display: flex; flex-direction: column; gap: 50px;
}
.ncco-tshow__heading {
  font-family: 'Geist', sans-serif;
  font-size: 58px; font-weight: 500; line-height: 68px;
  color: #081D3A; margin: 0;
  letter-spacing: -1.4px;
  max-width: 420px;
}
.ncco-tshow__body {
  font-family: 'Geist', sans-serif;
  font-size: 18px; font-weight: 400; line-height: 24px;
  color: #647082; margin: 0;
}

.ncco-tshow__cta { flex-shrink: 0; }

.ncco-tshow__images {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 30px;
  padding: 0 16px;
}
.ncco-tshow__img-wrap {
  aspect-ratio: 448 / 352;
  border-radius: 22px;
  overflow: hidden;
  background: rgba(137, 156, 168, 0.08);
  border: 1px solid rgba(8, 29, 58, 0.08);
}
.ncco-tshow__img-wrap img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: transform 0.5s ease;
}
.ncco-tshow__img-wrap:hover img { transform: scale(1.04); }

@media (max-width: 1024px) {
  .ncco-tshow { padding: 80px 0 60px; }
  .ncco-tshow__row { flex-direction: column; align-items: flex-start; gap: 32px; }
  .ncco-tshow__heading { font-size: 40px; line-height: 50px; }
  .ncco-tshow__images { grid-template-columns: repeat(2, 1fr); gap: 20px; }
}
@media (max-width: 600px) {
  .ncco-tshow { padding: 60px 0 40px; }
  .ncco-tshow__head { padding: 0 16px; }
  .ncco-tshow__heading { font-size: 30px; line-height: 40px; }
  .ncco-tshow__images { grid-template-columns: 1fr; padding: 0 16px; }
}
</style>

{% schema %}
{
  "name": "NCCO Tools Showcase",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "textarea", "id": "body", "label": "Body text"},
    {"type": "text", "id": "cta_label", "label": "CTA text"},
    {"type": "url", "id": "cta_url", "label": "CTA URL"},
    {"type": "select", "id": "cta_variant", "label": "CTA style", "options": [
      {"value": "yellow", "label": "Yellow"},
      {"value": "blue", "label": "Blue"},
      {"value": "teal", "label": "Teal"}
    ], "default": "blue"},
    {"type": "text", "id": "accent_color", "label": "Accent color (hex)", "default": "#FECB07"}
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image tile",
      "settings": [
        {"type": "image_picker", "id": "image", "label": "Image"},
        {"type": "text", "id": "asset", "label": "Or asset filename"},
        {"type": "text", "id": "alt", "label": "Alt text"}
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{"name": "NCCO Tools Showcase"}]
}
{% endschema %}
