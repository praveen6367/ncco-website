{%- assign accent = section.settings.accent_color | default: '#D9AC32' -%}
{%- assign cta_variant = section.settings.cta_variant | default: 'blue' -%}
<section class="ncco-csplit" style="--brand-accent:{{ accent }}">
  <div class="ncco-csplit__inner">
    <div class="ncco-csplit__left ncco-reveal">
      <div class="ncco-csplit__head">
        <div class="ncco-csplit__eyebrow-wrap">
          <span class="ncco-csplit__eyebrow-bar"></span>
          {% if section.settings.eyebrow != blank %}
            <p class="ncco-csplit__eyebrow">{{ section.settings.eyebrow }}</p>
          {% endif %}
        </div>
        {% if section.settings.heading != blank %}
          <h2 class="ncco-csplit__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.body != blank %}
          <p class="ncco-csplit__body">{{ section.settings.body }}</p>
        {% endif %}
      </div>
      {% if section.settings.cta_label != blank %}
        <div class="ncco-csplit__cta">
          {%- render 'ncco-cta', label: section.settings.cta_label, url: section.settings.cta_url, variant: cta_variant -%}
        </div>
      {% endif %}
    </div>
    <div class="ncco-csplit__right ncco-reveal ncco-reveal--d1">
      {% if section.settings.featured_asset != blank %}
        <img src="{{ section.settings.featured_asset | asset_url }}" alt="{{ section.settings.heading }}" loading="lazy">
      {% elsif section.settings.featured_image != blank %}
        <img src="{{ section.settings.featured_image | image_url: width: 1200 }}" alt="{{ section.settings.heading }}" loading="lazy">
      {% endif %}
    </div>
  </div>
</section>

<style>
.ncco-csplit {
  padding: 120px 240px;
  background: #fff;
}
.ncco-csplit__inner {
  max-width: 1440px; margin: 0 auto;
  display: flex; justify-content: space-between; align-items: center; gap: 60px;
}

.ncco-csplit__left {
  flex: 0 0 592px; max-width: 592px;
  display: flex; flex-direction: column; justify-content: space-between; gap: 60px;
  align-self: stretch;
}
.ncco-csplit__head { display: flex; flex-direction: column; gap: 40px; }
.ncco-csplit__eyebrow-wrap {
  display: flex; flex-direction: column; align-items: flex-start; gap: 8px;
}
.ncco-csplit__eyebrow-bar {
  display: block; width: 28px; height: 2px; background: var(--brand-accent, #D9AC32);
}
.ncco-csplit__eyebrow {
  font-family: 'Geist', sans-serif;
  font-size: 16px; font-weight: 500;
  color: #647082; text-transform: uppercase; margin: 0;
  letter-spacing: 0;
}
.ncco-csplit__heading {
  font-family: 'Geist', sans-serif;
  font-size: 58px; font-weight: 500; line-height: 68px;
  color: #081D3A; margin: 0;
  letter-spacing: -1.4px;
}
.ncco-csplit__body {
  font-family: 'Geist', sans-serif;
  font-size: 18px; font-weight: 400; line-height: 24px;
  color: #647082; margin: 0;
}
.ncco-csplit__cta { align-self: flex-start; }
.ncco-csplit .ncco-cta { align-self: flex-start; }

.ncco-csplit__right {
  flex: 1 1 0; min-width: 0;
  display: flex; justify-content: flex-end;
}
.ncco-csplit__right img {
  width: 100%; height: auto; max-width: 720px;
  display: block;
}

@media (max-width: 1400px) {
  .ncco-csplit { padding: 100px 80px; }
}
@media (max-width: 1024px) {
  .ncco-csplit { padding: 80px 24px; }
  .ncco-csplit__inner { flex-direction: column; gap: 60px; align-items: stretch; }
  .ncco-csplit__left { flex: 1 1 auto; max-width: 100%; }
  .ncco-csplit__heading { font-size: 40px; line-height: 50px; }
  .ncco-csplit__right { justify-content: center; }
}
@media (max-width: 600px) {
  .ncco-csplit { padding: 60px 16px; }
  .ncco-csplit__heading { font-size: 30px; line-height: 40px; }
  .ncco-csplit__head { gap: 24px; }
}
</style>

{% schema %}
{
  "name": "NCCO Cert Split",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Certifications"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Certified Safe. Trusted Worldwide."},
    {"type": "textarea", "id": "body", "label": "Body text"},
    {"type": "image_picker", "id": "featured_image", "label": "Cert grid image"},
    {"type": "text", "id": "featured_asset", "label": "Or asset filename", "default": "ncco-certifications-web.png"},
    {"type": "text", "id": "cta_label", "label": "CTA text"},
    {"type": "url", "id": "cta_url", "label": "CTA URL"},
    {"type": "select", "id": "cta_variant", "label": "CTA style", "options": [
      {"value": "yellow", "label": "Yellow"},
      {"value": "blue", "label": "Blue"},
      {"value": "teal", "label": "Teal"}
    ], "default": "blue"},
    {"type": "text", "id": "accent_color", "label": "Accent color (hex)", "default": "#D9AC32"}
  ],
  "presets": [{"name": "NCCO Cert Split"}]
}
{% endschema %}
