<section class="ncco-resba">
  <div class="ncco-resba__media">
    {%- if section.settings.image_before != blank -%}
      <div class="ncco-resba__half">
        <img src="{{ section.settings.image_before | asset_url }}" alt="{{ section.settings.label_before | default: 'Before' }}" loading="lazy">
        <span class="ncco-resba__fade ncco-resba__fade--left"></span>
        <p class="ncco-resba__label ncco-resba__label--left">{{ section.settings.label_before | default: 'Before' }}</p>
      </div>
    {%- endif -%}
    {%- if section.settings.image_after != blank -%}
      <div class="ncco-resba__half">
        <img src="{{ section.settings.image_after | asset_url }}" alt="{{ section.settings.label_after | default: 'After' }}" loading="lazy">
        <span class="ncco-resba__fade ncco-resba__fade--right"></span>
        <p class="ncco-resba__label ncco-resba__label--right">{{ section.settings.label_after | default: 'After' }}</p>
      </div>
    {%- endif -%}
    <span class="ncco-resba__divider" aria-hidden="true"></span>
  </div>
  <div class="ncco-resba__content">
    {%- if section.settings.eyebrow != blank -%}
      <div class="ncco-resba__eyebrow-wrap">
        <span class="ncco-resba__eyebrow-bar"></span>
        <p class="ncco-resba__eyebrow-text">{{ section.settings.eyebrow }}</p>
      </div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="ncco-resba__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="ncco-resba__body">{{ section.settings.body }}</div>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: '#' }}" class="ncco-resba__cta">
        <span>{{ section.settings.cta_label }}</span>
        <span class="ncco-resba__cta-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 13L13 3M13 3H6M13 3V10" stroke="#081D3A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </a>
    {%- endif -%}
  </div>
</section>

<style>
.ncco-resba{ padding:120px clamp(24px,12.5vw,240px); background:#fff; box-sizing:border-box; display:flex; gap:100px; align-items:center; }
.ncco-resba__media{ position:relative; flex:0 0 clamp(320px,34.79vw,668px); width:clamp(320px,34.79vw,668px); height:clamp(260px,28.23vw,542px); border-radius:28px; overflow:hidden; display:flex; }
.ncco-resba__half{ position:relative; flex:1 1 50%; min-width:0; overflow:hidden; }
.ncco-resba__half img{ display:block; width:100%; height:100%; object-fit:cover; }
.ncco-resba__fade{ position:absolute; top:0; left:0; right:0; height:35%; pointer-events:none; }
.ncco-resba__fade--left{ background:linear-gradient(180deg,rgba(2,10,20,0.78),rgba(2,10,20,0)); }
.ncco-resba__fade--right{ background:linear-gradient(180deg,rgba(2,10,20,0.78),rgba(2,10,20,0)); }
.ncco-resba__divider{ position:absolute; top:0; bottom:0; left:50%; width:4px; background:#fff; transform:translateX(-50%); }
.ncco-resba__label{
  position:absolute; top:28px; left:28px; margin:0;
  font-family:'Geist',sans-serif; font-weight:600; font-size:clamp(22px,3.4vw,34px); letter-spacing:-1.2px;
  text-transform:uppercase; color:#fff; white-space:nowrap;
}

.ncco-resba__content{ flex:1 1 auto; min-width:0; display:flex; flex-direction:column; gap:24px; }
.ncco-resba__eyebrow-wrap{ display:flex; flex-direction:column; gap:8px; }
.ncco-resba__eyebrow-bar{ width:28px; height:2px; background:#FECB07; display:block; }
.ncco-resba__eyebrow-text{ margin:0; font-family:'Geist',sans-serif; font-size:16px; font-weight:500; letter-spacing:-0.32px; text-transform:uppercase; color:#647082; }
.ncco-resba__heading{ margin:0; font-family:'Geist',sans-serif; font-weight:500; font-size:48px; line-height:61px; letter-spacing:-2px; color:#081D3A; }
.ncco-resba__body{ font-family:'Geist',sans-serif; font-size:18px; font-weight:400; line-height:1.6; letter-spacing:-0.36px; color:#647082; }
.ncco-resba__body p{ margin:0 0 16px; }
.ncco-resba__body p:last-child{ margin-bottom:0; }

.ncco-resba__cta{
  align-self:flex-start; display:inline-flex; align-items:center; gap:24px;
  background:#003DA5; color:#fff; padding:8px 8px 8px 28px; border-radius:78px;
  font-family:'Geist',sans-serif; font-size:16px; font-weight:500; text-transform:uppercase; letter-spacing:-0.32px;
  text-decoration:none; box-shadow:0 8px 14px rgba(0,61,165,0.16); transition:filter .2s ease,transform .2s ease;
  margin-top:8px;
}
.ncco-resba__cta:hover{ filter:brightness(.95); color:#fff; transform:translateY(-1px); }
.ncco-resba__cta-icon{ width:38px; height:38px; min-width:38px; display:flex; align-items:center; justify-content:center; border-radius:50%; background:#FECB07; }

@media(max-width:1100px){
  .ncco-resba{ flex-direction:column; gap:48px; }
  .ncco-resba__media{ width:100%; flex-basis:auto; }
}
@media(max-width:600px){
  .ncco-resba{ padding:56px 20px; }
  .ncco-resba__media{ height:300px; border-radius:20px; }
  .ncco-resba__label{ font-size:16px; top:18px; }
  .ncco-resba__heading{ font-size:28px; letter-spacing:-1px; }
  .ncco-resba__body{ font-size:16px; }
  .ncco-resba__content{ gap:20px; }
}
</style>

{% schema %}
{
  "name": "NCCO Home Before/After",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "image_before", "label": "Before image asset filename (assets/)", "default": "ncco-img-residential-room.png"},
    {"type": "text", "id": "label_before", "label": "Before label", "default": "Before"},
    {"type": "text", "id": "image_after", "label": "After image asset filename (assets/)", "default": "ncco-img-air-purifier-room.png"},
    {"type": "text", "id": "label_after", "label": "After label", "default": "After"},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "OUR IMPACT AT HOME"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Real Change You Can See and Breathe"},
    {"type": "richtext", "id": "body", "label": "Body text"},
    {"type": "text", "id": "cta_label", "label": "CTA label", "default": "Get a Free Consultation"},
    {"type": "url", "id": "cta_url", "label": "CTA URL"}
  ],
  "presets": [{"name": "NCCO Home Before/After"}]
}
{% endschema %}
