<section class="ncco-freshness">
  <div class="ncco-freshness__container">
    <div class="ncco-freshness__content">
      {% if section.settings.eyebrow != blank %}
        <div class="ncco-freshness__eyebrow">{{ section.settings.eyebrow }}</div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="ncco-freshness__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="ncco-freshness__description">{{ section.settings.description }}</div>
      {% endif %}
      <div class="ncco-freshness__features">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="ncco-freshness__feature" {{ block.shopify_attributes }}>
              <span class="ncco-freshness__feature-icon">{{ block.settings.icon }}</span>
              <div class="ncco-freshness__feature-text">{{ block.settings.text }}</div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      {% if section.settings.button_label != blank %}
        <div class="ncco-freshness__button-wrap">
          <a href="{{ section.settings.button_url | default: '#' }}" class="ncco-freshness__button">
            <span>{{ section.settings.button_label }}</span>
            <span class="ncco-freshness__button-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 13L13 3M13 3H6M13 3V10" stroke="#081D3A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        </div>
      {% endif %}
    </div>
    <div class="ncco-freshness__gallery{% if section.settings.gallery_layout == 'center_image' %} ncco-freshness__gallery--center{% endif %}">
      <div class="ncco-freshness__image ncco-freshness__image--image-1">
        {% if section.settings.image_1 != blank %}
          {{ section.settings.image_1 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 800, 900', sizes: '(max-width: 650px) 50vw, 30vw' }}
        {% else %}
          <div class="ncco-freshness__placeholder"></div>
        {% endif %}
      </div>
      <div class="ncco-freshness__image ncco-freshness__image--image-2">
        {% if section.settings.image_2 != blank %}
          {{ section.settings.image_2 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 800, 900', sizes: '(max-width: 650px) 50vw, 30vw' }}
        {% else %}
          <div class="ncco-freshness__placeholder"></div>
        {% endif %}
      </div>
      <div class="ncco-freshness__image ncco-freshness__image--image-3">
        {% if section.settings.image_3 != blank %}
          {{ section.settings.image_3 | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '500, 700, 900, 1100', sizes: '(max-width: 650px) 100vw, 60vw' }}
        {% else %}
          <div class="ncco-freshness__placeholder"></div>
        {% endif %}
      </div>
      <div class="ncco-freshness__image ncco-freshness__image--image-4">
        {% if section.settings.image_4 != blank %}
          {{ section.settings.image_4 | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 800, 900', sizes: '(max-width: 650px) 50vw, 30vw' }}
        {% else %}
          <div class="ncco-freshness__placeholder"></div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
<style>
.ncco-freshness{width:100%;background:#fff;padding:60px 50px;box-sizing:border-box}
.ncco-freshness__container{width:100%;max-width:1180px;margin:0 auto;display:grid;grid-template-columns:38% 62%;column-gap:40px;align-items:center}
.ncco-freshness__content{position:relative;padding:6px 10px 0 0;display:flex;flex-direction:column;box-sizing:border-box}
.ncco-freshness__eyebrow{margin-bottom:26px;font-family:'Geist',sans-serif;font-size:12px;line-height:16px;font-weight:400;color:#52677C;text-transform:uppercase}
.ncco-freshness__heading{margin:0 0 18px;font-family:'Geist',sans-serif;font-size:48px;line-height:56px;font-weight:500;letter-spacing:-1.5px;color:#0D2745}
.ncco-freshness__description{max-width:390px;margin-bottom:30px;font-family:'Geist',sans-serif;font-size:16px;line-height:24px;font-weight:400;color:#657A8F}
.ncco-freshness__description p{margin:0 0 12px}
.ncco-freshness__description p:last-child{margin-bottom:0}
.ncco-freshness__features{display:flex;flex-direction:column;gap:16px}
.ncco-freshness__feature{display:flex;align-items:center;gap:13px}
.ncco-freshness__feature-icon{width:32px;height:32px;min-width:32px;display:flex;align-items:center;justify-content:center;background:#FFF7D9;border-radius:50%;font-family:Arial,sans-serif;font-size:15px;line-height:1;color:#F4C400}
.ncco-freshness__feature-text{font-family:'Geist',sans-serif;font-size:14px;line-height:21px;font-weight:400;color:#172B43}
.ncco-freshness__button-wrap{margin-top:30px;padding-bottom:10px}
.ncco-freshness__button{position:relative;z-index:2;display:inline-flex;align-items:center;justify-content:space-between;gap:18px;background:#064FBE;color:#fff;font-family:'Geist',sans-serif;font-weight:500;font-size:12px;text-transform:uppercase;text-decoration:none;letter-spacing:-0.02em;padding:6px 6px 6px 20px;border-radius:78px;white-space:nowrap;box-shadow:0 8px 12px rgba(6,79,190,.22);transition:filter .2s ease}
.ncco-freshness__button:hover{filter:brightness(.95);color:#fff}
.ncco-freshness__button-icon{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;min-width:30px;background:#FECB07;border-radius:50%}
.ncco-freshness__button-icon svg{display:block}
.ncco-freshness__gallery{position:relative;width:100%;max-width:620px;height:520px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:8px}
.ncco-freshness__image{position:relative;overflow:hidden;background:#F4F6F7}
.ncco-freshness__image img{width:100%;height:100%;display:block;object-fit:cover}
.ncco-freshness__image--image-1{border-radius:18px 0 0 18px}
.ncco-freshness__image--image-2{border-radius:0 18px 0 0}
.ncco-freshness__image--image-3{border-radius:0 0 0 18px}
.ncco-freshness__image--image-4{border-radius:0 0 18px 0}
.ncco-freshness__placeholder{width:100%;height:100%;background:#F3F5F6}
.ncco-freshness__gallery--center .ncco-freshness__image--image-1{grid-column:1;grid-row:1;border-radius:18px 0 0 0}
.ncco-freshness__gallery--center .ncco-freshness__image--image-2{grid-column:2;grid-row:1;border-radius:0 18px 0 0}
.ncco-freshness__gallery--center .ncco-freshness__image--image-3{grid-column:1 / 3;grid-row:2;border-radius:0 0 18px 18px}
.ncco-freshness__gallery--center .ncco-freshness__image--image-4{position:absolute;z-index:5;left:50%;top:50%;transform:translate(-50%,-50%);width:165px;height:165px;background:#fff;border-radius:16px;box-shadow:0 8px 24px rgba(13,39,69,.16);border:1px solid #E8EAED}
.ncco-freshness__gallery--center .ncco-freshness__image--image-4 img{width:100%;height:100%;display:block;object-fit:contain;padding:18px;box-sizing:border-box}
@media(max-width:1050px){
.ncco-freshness{padding:50px 35px}
.ncco-freshness__container{grid-template-columns:40% 60%;column-gap:25px}
.ncco-freshness__heading{font-size:42px;line-height:50px}
.ncco-freshness__description{font-size:15px;line-height:22px}
.ncco-freshness__feature-text{font-size:13px;line-height:20px}
.ncco-freshness__gallery{max-width:560px;height:480px}
.ncco-freshness__gallery--center .ncco-freshness__image--image-4{width:145px;height:145px}
}
@media(max-width:750px){
.ncco-freshness{padding:45px 25px}
.ncco-freshness__container{display:flex;flex-direction:column;align-items:stretch}
.ncco-freshness__content{padding:0;margin-bottom:35px}
.ncco-freshness__gallery{width:100%;max-width:600px;height:500px;margin:0 auto}
}
@media(max-width:650px){
.ncco-freshness{padding:45px 20px}
.ncco-freshness__content{margin-bottom:35px}
.ncco-freshness__eyebrow{margin-bottom:20px;font-size:11px;line-height:15px}
.ncco-freshness__heading{font-size:34px;line-height:42px;letter-spacing:-1px;margin-bottom:16px}
.ncco-freshness__description{max-width:100%;font-size:15px;line-height:23px;margin-bottom:28px}
.ncco-freshness__features{gap:15px}
.ncco-freshness__feature{gap:12px}
.ncco-freshness__feature-icon{width:30px;height:30px;min-width:30px;font-size:14px}
.ncco-freshness__feature-text{font-size:14px;line-height:21px}
.ncco-freshness__button-wrap{margin-top:28px;padding-top:0;padding-bottom:0}
.ncco-freshness__button{font-size:12px;padding:6px 6px 6px 20px;gap:18px}
.ncco-freshness__button-icon{width:30px;height:30px;min-width:30px}
.ncco-freshness__gallery{width:100%;max-width:100%;height:auto;aspect-ratio:1 / 1;grid-template-columns:1fr 1fr;gap:5px}
.ncco-freshness__image--image-1{border-radius:13px 0 0 13px}
.ncco-freshness__image--image-2{border-radius:0 13px 0 0}
.ncco-freshness__image--image-3{border-radius:0 0 0 13px}
.ncco-freshness__image--image-4{border-radius:0 0 13px 0}
.ncco-freshness__gallery--center .ncco-freshness__image--image-1{border-radius:13px 0 0 0}
.ncco-freshness__gallery--center .ncco-freshness__image--image-2{border-radius:0 13px 0 0}
.ncco-freshness__gallery--center .ncco-freshness__image--image-3{border-radius:0 0 13px 13px}
.ncco-freshness__gallery--center .ncco-freshness__image--image-4{width:125px;height:125px;border-radius:13px}
.ncco-freshness__gallery--center .ncco-freshness__image--image-4 img{padding:12px}
}
@media(max-width:420px){
.ncco-freshness{padding:38px 16px}
.ncco-freshness__heading{font-size:32px;line-height:39px}
.ncco-freshness__description{font-size:15px;line-height:22px}
.ncco-freshness__feature-text{font-size:13px;line-height:20px}
.ncco-freshness__button{font-size:12px;padding:6px 6px 6px 19px;gap:14px}
.ncco-freshness__button-icon{width:30px;height:30px;min-width:30px}
.ncco-freshness__gallery{aspect-ratio:1 / 1}
.ncco-freshness__gallery--center .ncco-freshness__image--image-4{width:110px;height:110px;border-radius:12px}
.ncco-freshness__gallery--center .ncco-freshness__image--image-4 img{padding:10px}
}
</style>
{% schema %}
{
  "name":"NCCO Freshness Showcase",
  "tag":"section",
  "settings":[
    {
      "type":"text",
      "id":"eyebrow",
      "label":"Eyebrow",
      "default":"ONE-BUTTON VACUUM STORAGE THAT KEEPS YOUR FOOD SAFER, LONGER"
    },
    {
      "type":"text",
      "id":"heading",
      "label":"Heading",
      "default":"Seal in Freshness"
    },
    {
      "type":"richtext",
      "id":"description",
      "label":"Description",
      "default":"<p>NCCO’s vacuum technology makes it easy to keep your food fresh, hygienic, and well-preserved all with a single touch.</p>"
    },
    {
      "type":"image_picker",
      "id":"image_1",
      "label":"Gallery Image 1"
    },
    {
      "type":"image_picker",
      "id":"image_2",
      "label":"Gallery Image 2"
    },
    {
      "type":"image_picker",
      "id":"image_3",
      "label":"Gallery Image 3"
    },
    {
      "type":"image_picker",
      "id":"image_4",
      "label":"Gallery Image 4"
    },
    {
      "type":"select",
      "id":"gallery_layout",
      "label":"Gallery Layout",
      "options":[
        {
          "value":"four_images",
          "label":"4 Images"
        },
        {
          "value":"center_image",
          "label":"Center Image"
        }
      ],
      "default":"four_images"
    },
    {
      "type":"text",
      "id":"button_label",
      "label":"Button label",
      "default":"BUY VACUUM STORAGE SET"
    },
    {
      "type":"url",
      "id":"button_url",
      "label":"Button URL"
    }
  ],
  "blocks":[
    {
      "type":"feature",
      "name":"Feature",
      "settings":[
        {
          "type":"text",
          "id":"icon",
          "label":"Icon",
          "default":"✦"
        },
        {
          "type":"text",
          "id":"text",
          "label":"Feature text",
          "default":"One-button vacuum sealing for instant airtight storage"
        }
      ]
    }
  ],
  "presets":[
    {
      "name":"NCCO Freshness Showcase",
      "blocks":[
        {
          "type":"feature",
          "settings":{
            "icon":"✦",
            "text":"One-button vacuum sealing for instant airtight storage"
          }
        },
        {
          "type":"feature",
          "settings":{
            "icon":"✦",
            "text":"Extends food freshness by 2–3x"
          }
        },
        {
          "type":"feature",
          "settings":{
            "icon":"✦",
            "text":"Prevents bacteria, oxidation, and moisture buildup"
          }
        },
        {
          "type":"feature",
          "settings":{
            "icon":"✦",
            "text":"USB-rechargeable, washable, and freezer-safe jars"
          }
        },
        {
          "type":"feature",
          "settings":{
            "icon":"✦",
            "text":"3 jar sizes suitable for daily household needs"
          }
        }
      ]
    }
  ]
}
{% endschema %}