{%- assign share_url = shop.url | append: article.url -%}
<section class="ncco-article">
  <div class="ncco-article__wrap">

    <a class="ncco-article__back" href="{{ blog.url }}">&#8592; {{ 'blogs.article.back_to_blog' | t | default: '返回網誌' }}</a>

    <header class="ncco-article__header">
      <div class="ncco-article__meta">
        <span class="ncco-article__author">{% if localization.language.iso_code == 'zh-TW' %}作者：{{ article.author }}{% else %}By {{ article.author }}{% endif %}</span>
        <span class="ncco-article__sep">&#xB7;</span>
        <span class="ncco-article__date">{{ article.published_at | date: '%b %d, %Y' }}</span>
        {% if article.tags != blank %}
          <span class="ncco-article__sep">&#xB7;</span>
          {% for tag in article.tags limit: 1 %}
            <span class="ncco-article__tag-badge">{{ tag }}</span>
          {% endfor %}
        {% endif %}
      </div>
      <h1 class="ncco-article__title">{{ article.title }}</h1>
    </header>

    {% if article.image %}
      <div class="ncco-article__featured">
        <img src="{{ article.image | image_url: width: 1200 }}"
             alt="{{ article.title }}" loading="eager">
      </div>
    {% endif %}

    <div class="ncco-article__body">
      <div class="ncco-article__content" id="ncco-article-content">
        {{ article.content }}
      </div>

      <aside class="ncco-article__sidebar">
        <div class="ncco-article__toc-card">
          <h3 class="ncco-article__sidebar-heading">{{ 'blogs.article.table_of_contents' | t | default: '目錄' }}</h3>
          <nav id="ncco-toc" class="ncco-article__toc-nav"></nav>
        </div>

        {% assign related_count = 0 %}
        {% for rel in blog.articles %}
          {% if rel.id != article.id and related_count < 3 %}
            {% if related_count == 0 %}
        <div class="ncco-article__related-card">
          <h3 class="ncco-article__sidebar-heading">{{ 'blogs.article.related_blogs' | t | default: '相關文章' }}</h3>
            {% endif %}
            <a class="ncco-article__related-item" href="{{ rel.url }}">
              {% if rel.image %}
                <img src="{{ rel.image | image_url: width: 120 }}" alt="{{ rel.title }}" loading="lazy">
              {% endif %}
              <div>
                <p class="ncco-article__related-title">{{ rel.title }}</p>
                <p class="ncco-article__related-date">{{ rel.published_at | date: '%b %d, %Y' }}</p>
              </div>
            </a>
            {%- assign related_count = related_count | plus: 1 -%}
          {% endif %}
        {% endfor %}
        {% if related_count > 0 %}</div>{% endif %}
      </aside>
    </div>

    <div class="ncco-article__share">
      <span class="ncco-article__share-label">{{ 'blogs.article.share' | t | default: '分享此文章' }}:</span>
      <a class="ncco-article__share-btn" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener" aria-label="Facebook">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
      </a>
      <a class="ncco-article__share-btn" href="https://twitter.com/intent/tweet?url={{ share_url | url_encode }}&text={{ article.title | url_encode }}" target="_blank" rel="noopener" aria-label="Twitter / X">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>
      <a class="ncco-article__share-btn" href="https://www.linkedin.com/sharing/share-offsite/?url={{ share_url | url_encode }}" target="_blank" rel="noopener" aria-label="LinkedIn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
.ncco-article { padding: 60px 240px 80px; background: #fff; }
.ncco-article__wrap { max-width: 100%; }
.ncco-article__back {
  display: inline-block; margin-bottom: 40px;
  font-family: 'Geist', sans-serif; font-size: 14px; font-weight: 500;
  color: #647082; text-decoration: none; letter-spacing: -0.2px;
}
.ncco-article__back:hover { color: #003da5; }
.ncco-article__header { margin-bottom: 32px; }
.ncco-article__meta {
  display: flex; align-items: center; flex-wrap: wrap; gap: 8px;
  font-family: 'Geist', sans-serif; font-size: 14px; color: #647082;
  margin-bottom: 16px;
}
.ncco-article__sep { color: rgba(8,29,58,0.2); }
.ncco-article__tag-badge {
  background: #FECB07; color: #081D3A;
  font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;
  padding: 3px 8px; border-radius: 20px;
}
.ncco-article__title {
  font-family: 'Geist', sans-serif;
  font-size: 48px; font-weight: 600; line-height: 56px; letter-spacing: -1.5px;
  color: #081D3A; margin: 0;
}
.ncco-article__featured { margin-bottom: 48px; }
.ncco-article__featured img {
  width: 100%; display: block; border-radius: 16px;
  max-height: 500px; object-fit: cover;
}
.ncco-article__body {
  display: grid; grid-template-columns: 1fr 300px;
  gap: 60px; align-items: start;
}
.ncco-article__content {
  font-family: 'Geist', sans-serif;
  font-size: 18px; line-height: 28px; color: #647082;
}
.ncco-article__content h2 {
  font-family: 'Geist', sans-serif; font-size: 26px; font-weight: 600;
  color: #081D3A; margin: 36px 0 16px; letter-spacing: -0.5px; line-height: 1.3;
}
.ncco-article__content h3 {
  font-family: 'Geist', sans-serif; font-size: 20px; font-weight: 600;
  color: #081D3A; margin: 28px 0 12px; letter-spacing: -0.3px; line-height: 1.3;
}
.ncco-article__content p { margin: 0 0 20px; }
.ncco-article__content a { color: #003da5; }
.ncco-article__content ul, .ncco-article__content ol { margin: 0 0 20px; padding-left: 24px; }
.ncco-article__content li { margin-bottom: 8px; }
.ncco-article__content img { max-width: 100%; border-radius: 12px; margin: 16px 0; }
.ncco-article__content blockquote {
  border-left: 3px solid #FECB07; padding-left: 20px;
  margin: 24px 0; color: #081D3A; font-style: italic;
}
.ncco-article__sidebar {
  position: sticky; top: 24px;
  display: flex; flex-direction: column; gap: 24px;
}
.ncco-article__toc-card, .ncco-article__related-card {
  background: #f9f9fa; border-radius: 16px; padding: 24px;
}
.ncco-article__sidebar-heading {
  font-family: 'Geist', sans-serif; font-size: 15px; font-weight: 600;
  color: #081D3A; margin: 0 0 16px; letter-spacing: -0.2px;
}
#ncco-toc:empty + .ncco-article__toc-card { display: none; }
.ncco-article__toc-nav ul { list-style: none; margin: 0; padding: 0; }
.ncco-article__toc-nav li { margin-bottom: 10px; }
.ncco-article__toc-nav li.ncco-toc__sub { padding-left: 14px; }
.ncco-article__toc-nav a {
  font-family: 'Geist', sans-serif; font-size: 14px; color: #647082;
  text-decoration: none; line-height: 1.5;
}
.ncco-article__toc-nav a:hover { color: #003da5; }
.ncco-article__related-item {
  display: flex; gap: 12px; align-items: flex-start;
  text-decoration: none; padding: 14px 0;
  border-bottom: 1px solid rgba(8,29,58,0.08);
}
.ncco-article__related-item:first-of-type { padding-top: 8px; }
.ncco-article__related-item:last-of-type { border-bottom: none; padding-bottom: 0; }
.ncco-article__related-item img {
  width: 64px; height: 52px; object-fit: cover;
  border-radius: 8px; flex-shrink: 0; display: block;
}
.ncco-article__related-title {
  font-family: 'Geist', sans-serif; font-size: 13px; font-weight: 500;
  color: #081D3A; line-height: 1.4; margin: 0 0 4px;
}
.ncco-article__related-date { font-size: 12px; color: #97A0AC; margin: 0; }
.ncco-article__share {
  display: flex; align-items: center; gap: 12px;
  margin-top: 48px; padding-top: 28px;
  border-top: 1px solid rgba(8,29,58,0.1);
}
.ncco-article__share-label {
  font-family: 'Geist', sans-serif; font-size: 14px; font-weight: 500; color: #647082;
}
.ncco-article__share-btn {
  display: flex; align-items: center; justify-content: center;
  width: 36px; height: 36px; border-radius: 50%;
  background: #081D3A; color: #fff; text-decoration: none;
  transition: background 0.2s;
}
.ncco-article__share-btn:hover { background: #003da5; }

@media (max-width: 1600px) { .ncco-article { padding: 60px 80px 80px; } }
@media (max-width: 1200px) {
  .ncco-article__body { grid-template-columns: 1fr 260px; gap: 40px; }
  .ncco-article__title { font-size: 40px; line-height: 48px; }
}
@media (max-width: 1024px) {
  .ncco-article { padding: 48px 40px 60px; }
  .ncco-article__title { font-size: 34px; line-height: 42px; letter-spacing: -1px; }
  .ncco-article__body { grid-template-columns: 1fr; }
  .ncco-article__sidebar { position: static; order: -1; }
  .ncco-article__toc-card { display: none; }
}
@media (max-width: 989px) {
  .ncco-article { padding: 40px 24px 48px; }
  .ncco-article__title { font-size: 28px; line-height: 36px; letter-spacing: -0.8px; }
  .ncco-article__content { font-size: 16px; line-height: 26px; }
  .ncco-article__content h2 { font-size: 22px; }
  .ncco-article__content h3 { font-size: 18px; }
}
@media (max-width: 600px) {
  .ncco-article { padding: 32px 16px 40px; }
  .ncco-article__title { font-size: 24px; line-height: 32px; letter-spacing: -0.5px; }
  .ncco-article__content { font-size: 15px; line-height: 25px; }
  .ncco-article__content img { max-width: 100%; border-radius: 8px; }
  .ncco-article__content ul, .ncco-article__content ol { padding-left: 18px; }
  .ncco-article__share { flex-wrap: wrap; gap: 8px; }
  .ncco-article__featured img { max-height: 240px; border-radius: 10px; }
}
</style>

<script>
(function() {
  function buildToc() {
    var content = document.getElementById('ncco-article-content');
    var nav = document.getElementById('ncco-toc');
    if (!content || !nav) return;
    var headings = content.querySelectorAll('h2, h3');
    if (!headings.length) {
      var card = nav.closest('.ncco-article__toc-card');
      if (card) card.style.display = 'none';
      return;
    }
    var html = '<ul>';
    headings.forEach(function(h, i) {
      var id = 'toc-h-' + i;
      h.id = id;
      var cls = h.tagName === 'H3' ? ' class="ncco-toc__sub"' : '';
      html += '<li' + cls + '><a href="#' + id + '">' + h.textContent + '</a></li>';
    });
    html += '</ul>';
    nav.innerHTML = html;
  }
  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', buildToc)
    : buildToc();
})();
</script>

{% schema %}
{
  "name": "NCCO Blog Article",
  "tag": "section",
  "settings": [],
  "presets": [{"name": "NCCO Blog Article"}]
}
{% endschema %}
