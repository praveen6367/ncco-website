{%- assign img_url = '' -%}
{%- if section.settings.image_asset != blank -%}
  {%- assign img_url = section.settings.image_asset | asset_url -%}
{%- elsif section.settings.image != blank -%}
  {%- assign img_url = section.settings.image | image_url: width: 1400 -%}
{%- endif -%}

<section class="ncco-tech-overview-wrap" id="ncco-tech-overview-{{ section.id }}">
  <div class="ncco-tech-overview__container">
    <div class="ncco-tech-overview__content-col">
      {%- if section.settings.eyebrow != blank -%}
        <div class="ncco-tech-overview__eyebrow-wrap">
          <span class="ncco-tech-overview__eyebrow-bar" aria-hidden="true"></span>
          <p class="ncco-tech-overview__eyebrow">{{ section.settings.eyebrow }}</p>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="ncco-tech-overview__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.intro != blank -%}
        <p class="ncco-tech-overview__intro">{{ section.settings.intro }}</p>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="ncco-tech-overview__list">
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank -%}
              <li class="ncco-tech-overview__item" {{ block.shopify_attributes }}>
                <span class="ncco-tech-overview__icon" aria-hidden="true">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                    <path d="M12 2C12 7.52 7.52 12 2 12C7.52 12 12 16.48 12 22C12 16.48 16.48 12 22 12C16.48 12 12 7.52 12 2Z" fill="#FECB07"/>
                  </svg>
                </span>
                <p class="ncco-tech-overview__item-text">{{ block.settings.text }}</p>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '#' }}" class="ncco-tech-overview__cta">
          <span>{{ section.settings.cta_label }}</span>
          <span class="ncco-tech-overview__cta-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
              <path d="M3 13L13 3M13 3H6M13 3V10" stroke="#081D3A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      {%- endif -%}
    </div>

    <div class="ncco-tech-overview__image-col">
      {%- if img_url != blank -%}
        <img
          src="{{ img_url }}"
          alt="{{ section.settings.heading | default: 'NCCO Technology Overview' | escape }}"
          class="ncco-tech-overview__image"
          loading="lazy"
        >
      {%- endif -%}
    </div>
  </div>
</section>

<style>
.ncco-tech-overview-wrap {
  width: 100%;
  background: #FFFFFF;
  padding: 88px 0;
  box-sizing: border-box;
}

.ncco-tech-overview__container {
  max-width: 1360px;
  margin: 0 auto;
  padding: 0 36px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 72px;
  box-sizing: border-box;
}

.ncco-tech-overview__content-col {
  flex: 1 1 52%;
  max-width: 610px;
  display: flex;
  flex-direction: column;
}

.ncco-tech-overview__eyebrow-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  margin-bottom: 14px;
}

.ncco-tech-overview__eyebrow-bar {
  width: 32px;
  height: 3px;
  background: #FECB07;
  border-radius: 2px;
  display: block;
}

.ncco-tech-overview__eyebrow {
  font-family: 'Geist', sans-serif;
  font-size: 15px;
  font-weight: 500;
  letter-spacing: -0.2px;
  color: #5A6678;
  margin: 0;
  line-height: 1.4;
}

.ncco-tech-overview__heading {
  font-family: 'Geist', sans-serif;
  font-size: 44px;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -1.2px;
  color: #081D3A;
  margin: 0 0 20px;
}

.ncco-tech-overview__intro {
  font-family: 'Geist', sans-serif;
  font-size: 14.5px;
  line-height: 1.65;
  letter-spacing: -0.15px;
  color: #4A5568;
  margin: 0 0 28px;
}

.ncco-tech-overview__list {
  display: flex;
  flex-direction: column;
  gap: 18px;
  margin: 0 0 10px;
  padding: 0;
  list-style: none;
}

.ncco-tech-overview__item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}

.ncco-tech-overview__icon {
  width: 28px;
  height: 28px;
  min-width: 28px;
  border-radius: 50%;
  background: #FEF9E6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2px;
}

.ncco-tech-overview__icon svg {
  display: block;
}

.ncco-tech-overview__item-text {
  font-family: 'Geist', sans-serif;
  font-size: 14.5px;
  line-height: 1.55;
  letter-spacing: -0.15px;
  color: #2D3748;
  margin: 0;
}

/* CTA Pill Button (navy pill + yellow circular arrow icon) */
.ncco-tech-overview__cta {
  display: inline-flex;
  align-self: flex-start;
  align-items: center;
  gap: 14px;
  background: #003DA5;
  color: #FFFFFF;
  font-family: 'Geist', sans-serif;
  font-weight: 700;
  font-size: 15px;
  letter-spacing: -0.2px;
  text-decoration: none;
  padding: 6px 6px 6px 24px;
  border-radius: 40px;
  box-shadow: 0 8px 18px rgba(0, 61, 165, 0.18);
  transition: all 0.25s ease;
  margin-top: 28px;
}

.ncco-tech-overview__cta:hover {
  background: #00338D;
  color: #FFFFFF;
  transform: translateY(-2px);
  box-shadow: 0 12px 24px rgba(0, 61, 165, 0.26);
}

.ncco-tech-overview__cta-icon {
  width: 36px;
  height: 36px;
  min-width: 36px;
  border-radius: 50%;
  background: #FECB07;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.25s ease;
}

.ncco-tech-overview__cta:hover .ncco-tech-overview__cta-icon {
  transform: translate(2px, -2px);
}

/* Right image */
.ncco-tech-overview__image-col {
  flex: 1 1 48%;
  max-width: 580px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.ncco-tech-overview__image {
  width: 100%;
  height: auto;
  max-height: 620px;
  object-fit: contain;
  display: block;
  border-radius: 28px;
}

/* Responsive */
@media (max-width: 1200px) {
  .ncco-tech-overview-wrap {
    padding: 72px 0;
  }
  .ncco-tech-overview__container {
    padding: 0 24px;
    gap: 48px;
  }
  .ncco-tech-overview__heading {
    font-size: 38px;
  }
}

@media (max-width: 989px) {
  .ncco-tech-overview-wrap {
    padding: 56px 0;
  }
  .ncco-tech-overview__container {
    flex-direction: column;
    align-items: stretch;
    gap: 40px;
    padding: 0 20px;
  }
  .ncco-tech-overview__content-col {
    max-width: 100%;
  }
  .ncco-tech-overview__image-col {
    max-width: 100%;
  }
  .ncco-tech-overview__heading {
    font-size: 32px;
  }
}

@media (max-width: 749px) {
  .ncco-tech-overview-wrap {
    padding: 44px 0;
  }
  .ncco-tech-overview__container {
    padding: 0 16px;
    gap: 32px;
  }
  .ncco-tech-overview__heading {
    font-size: 28px;
    line-height: 1.2;
  }
  .ncco-tech-overview__intro {
    font-size: 14px;
  }
  .ncco-tech-overview__item-text {
    font-size: 13.5px;
  }
}
</style>

{% schema %}
{
  "name": "NCCO Tech Overview",
  "tag": "section",
  "class": "ncco-tech-overview-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "為每個環境提供值得信賴的潔淨空氣解決方案"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "隱形保護，無所不在"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro paragraph",
      "default": "NCCO氧聚解空氣處理技術(Nano Confined Catalytic Oxidation) 是一種革命性的專利催化技術，它超越了傳統過濾的限制。NCCO在分子層面上分解污染物，將污染物（如病毒、VOCs）轉化為無害的水及二氧化碳。"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Image asset filename (assets/)",
      "default": "nccosecondsecrightimage.png"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right side image (optional upload)"
    },
    {
      "type": "header",
      "content": "CTA Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "了解NCCO運作"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Feature Point",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Point text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NCCO Tech Overview",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "text": "NCCO 技術通過旗下品牌（如 b-MOLA）應用於家庭，通過消除病毒、細菌、異味和有害氣體來確保家庭安全。"
          }
        },
        {
          "type": "point",
          "settings": {
            "text": "NCCO 為辦公室、學校、機場和公共場所提供 24/7 可靠的性能。它能有效對抗異味、VOCs 及細菌。"
          }
        },
        {
          "type": "point",
          "settings": {
            "text": "NCCO 技術是氣態污染物淨化專家，在工業應用中控制 VOCs、煙霧和有害氣體，且不會產生有毒副產品。"
          }
        },
        {
          "type": "point",
          "settings": {
            "text": "NCCO 系統已被全球超過 300 家醫院採用，在高敏感度環境（如醫院、實驗室）中提供最大的保護和持續保護。"
          }
        }
      ]
    }
  ]
}
{% endschema %}
