<section class="ncco-respoll-wrap">
  <div class="ncco-respoll">
    <div class="ncco-respoll__head">
      {%- if section.settings.eyebrow != blank -%}
        <div class="ncco-respoll__eyebrow-wrap">
          <span class="ncco-respoll__eyebrow-bar"></span>
          <p class="ncco-respoll__eyebrow-text">{{ section.settings.eyebrow }}</p>
        </div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ncco-respoll__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="ncco-respoll__body">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>
    <div class="ncco-respoll__grid">
      {%- for block in section.blocks -%}
        <div class="ncco-respoll__card{% if block.settings.light %} ncco-respoll__card--light{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <p class="ncco-respoll__card-title">{{ block.settings.title }}</p>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <div class="ncco-respoll__card-body">{{ block.settings.body }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
.ncco-respoll-wrap{ padding:0 16px; background:#fff; box-sizing:border-box; }
.ncco-respoll{ background:#081D3A; border-radius:32px; padding:100px clamp(24px,8vw,100px); display:flex; flex-direction:column; align-items:center; gap:48px; box-sizing:border-box; }

.ncco-respoll__head{ display:flex; flex-direction:column; align-items:center; gap:20px; text-align:center; max-width:800px; }
.ncco-respoll__eyebrow-wrap{ display:flex; flex-direction:column; align-items:center; gap:8px; }
.ncco-respoll__eyebrow-bar{ width:28px; height:2px; background:#FECB07; display:block; }
.ncco-respoll__eyebrow-text{ margin:0; font-family:'Geist',sans-serif; font-size:16px; font-weight:500; letter-spacing:-0.32px; text-transform:uppercase; color:#fff; }
.ncco-respoll__heading{ margin:0; font-family:'Geist',sans-serif; font-weight:500; font-size:clamp(32px,3vw,46px); line-height:1.18; letter-spacing:-1.8px; color:#fff; }
.ncco-respoll__body{ margin:0; font-family:'Geist',sans-serif; font-size:18px; font-weight:400; line-height:1.55; letter-spacing:-0.36px; color:#97A0AC; }

.ncco-respoll__grid{ width:100%; max-width:980px; display:grid; grid-template-columns:1fr 1fr; gap:20px; }
.ncco-respoll__card{
  background:rgba(255,255,255,0.12); border-radius:28px; padding:32px;
  display:flex; flex-direction:column; gap:16px; box-sizing:border-box;
}
.ncco-respoll__card--light{ background:#fff; }
.ncco-respoll__card-title{ margin:0; font-family:'Geist',sans-serif; font-weight:500; font-size:18px; letter-spacing:-0.4px; text-transform:uppercase; color:#fff; }
.ncco-respoll__card--light .ncco-respoll__card-title{ color:#081D3A; }
.ncco-respoll__card-body{ font-family:'Geist',sans-serif; font-size:15px; font-weight:400; line-height:1.55; letter-spacing:-0.3px; color:#97A0AC; }
.ncco-respoll__card--light .ncco-respoll__card-body{ color:#647082; }
.ncco-respoll__card-body p{ margin:0; }

@media(max-width:900px){
  .ncco-respoll{ padding:80px 32px; gap:48px; }
  .ncco-respoll__grid{ grid-template-columns:1fr; gap:20px; }
}
@media(max-width:600px){
  .ncco-respoll{ padding:56px 20px; border-radius:24px; }
  .ncco-respoll__heading{ font-size:26px; letter-spacing:-1px; }
  .ncco-respoll__body{ font-size:16px; }
  .ncco-respoll__card{ padding:28px; border-radius:20px; }
}
</style>

{% schema %}
{
  "name": "NCCO Home Pollutants",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "COMMON INDOOR POLLUTANTS"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "What's Lurking in Your Home's Air?"},
    {"type": "richtext", "id": "body", "label": "Body text"}
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {"type": "checkbox", "id": "light", "label": "Light (white) card", "default": false},
        {"type": "text", "id": "title", "label": "Title"},
        {"type": "richtext", "id": "body", "label": "Body text"}
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "NCCO Home Pollutants",
      "blocks": [
        {"type": "card", "settings": {"light": false, "title": "FORMALDEHYDE FROM FURNITURE", "body": "<p>Released from paints, wood products, and adhesives this harmful toxin can linger in indoor air for years.</p>"}},
        {"type": "card", "settings": {"light": true, "title": "PET DANDER & ALLERGENS", "body": "<p>Microscopic particles from pets, dust mites, and fabrics can trigger allergies and asthma.</p>"}},
        {"type": "card", "settings": {"light": true, "title": "COOKING ODORS & SMOKE", "body": "<p>Grease, smoke, and smells from daily cooking stick to furniture and linger long after meals.</p>"}},
        {"type": "card", "settings": {"light": false, "title": "VOCS FROM CLEANERS & SPRAYS", "body": "<p>Everyday cleaning products release VOCs that can irritate the skin, eyes, and respiratory system.</p>"}}
      ]
    }
  ]
}
{% endschema %}
