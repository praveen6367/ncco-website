      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "YOU ASK"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }

  ],

  "blocks": [

    {
      "type": "faq",
      "name": "Question",

      "settings": [

        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What makes NCCO-IG suitable for hospitals and clinical environments?"
