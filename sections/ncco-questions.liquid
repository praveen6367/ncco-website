<section class="ncco-questions">

  <div class="ncco-questions__container">

    <!-- HEADER -->
    <div class="ncco-questions__header">

      {% if section.settings.eyebrow != blank %}
        <div class="ncco-questions__eyebrow">
          <span></span>
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="ncco-questions__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      <div class="ncco-questions__accent"></div>

    </div>


    <!-- FAQ GRID -->
    <div class="ncco-questions__grid">

      {% for block in section.blocks %}

        <div
          class="ncco-questions__item{% if forloop.first %} ncco-questions__item--open{% endif %}"
          {{ block.shopify_attributes }}
        >

          <button
            type="button"
            class="ncco-questions__question"
            aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
          >

            <span class="ncco-questions__question-text">
              {{ block.settings.question }}
            </span>

            <span class="ncco-questions__icon">
              <span class="ncco-questions__plus">+</span>
            </span>

          </button>


          <div class="ncco-questions__answer">
            <div class="ncco-questions__answer-inner">
              {{ block.settings.answer }}
            </div>
          </div>

        </div>

      {% endfor %}

    </div>

  </div>

</section>


<style>

/* =================================
   SECTION
================================= */

.ncco-questions {
  width: 100%;
  background: #ffffff;
  padding: 90px 40px 100px;
  box-sizing: border-box;
}

.ncco-questions__container {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
}


/* =================================
   HEADER
================================= */

.ncco-questions__header {
  text-align: center;
  margin-bottom: 44px;
}

.ncco-questions__eyebrow {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;

  font-family: 'Geist', sans-serif;
  font-size: 11px;
  line-height: 14px;
  font-weight: 400;

  color: #8295A8;

  text-transform: uppercase;
}

.ncco-questions__eyebrow span {
  width: 20px;
  height: 2px;
  display: block;
  background: #55C2DF;
}


.ncco-questions__heading {
  margin: 18px 0 0;

  font-family: 'Geist', sans-serif;
  font-size: 42px;
  line-height: 50px;
  font-weight: 500;
  letter-spacing: -1.5px;

  color: #0D3B60;
}


.ncco-questions__accent {
  width: 13px;
  height: 2px;

  margin: 20px auto 0;

  background: #E83C9B;
}


/* =================================
   GRID
================================= */

.ncco-questions__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  column-gap: 22px;
  row-gap: 0;
}


/* =================================
   FAQ ITEM
================================= */

.ncco-questions__item {
  border-top: 1px solid #DCE4E9;
  border-bottom: 1px solid #DCE4E9;
}


/* =================================
   QUESTION
================================= */

.ncco-questions__question {
  width: 100%;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 15px;

  padding: 17px 0;

  margin: 0;

  border: 0;
  background: transparent;

  cursor: pointer;

  text-align: left;
}


.ncco-questions__question-text {
  font-family: 'Geist', sans-serif;

  font-size: 13px;
  line-height: 17px;
  font-weight: 500;

  color: #0D3B60;
}


.ncco-questions__icon {
  width: 21px;
  height: 21px;

  min-width: 21px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: #EAF0F3;
  border-radius: 3px;

  transition: background 0.2s ease;
}


.ncco-questions__plus {
  font-family: Arial, sans-serif;

  font-size: 16px;
  line-height: 16px;
  font-weight: 400;

  color: #0D3B60;

  transition: transform 0.25s ease;
}


/* =================================
   ANSWER
================================= */

.ncco-questions__answer {
  display: grid;
  grid-template-rows: 0fr;

  overflow: hidden;

  transition: grid-template-rows 0.3s ease;
}


.ncco-questions__answer-inner {
  min-height: 0;
  overflow: hidden;

  font-family: 'Geist', sans-serif;

  font-size: 12px;
  line-height: 18px;
  font-weight: 400;

  color: #8295A8;

  padding-right: 15px;
}


.ncco-questions__item--open .ncco-questions__answer {
  grid-template-rows: 1fr;
}


.ncco-questions__item--open .ncco-questions__answer-inner {
  padding-bottom: 16px;
}


.ncco-questions__item--open .ncco-questions__plus {
  transform: rotate(45deg);
}


/* =================================
   HOVER
================================= */

.ncco-questions__question:hover .ncco-questions__icon {
  background: #DDECF1;
}


/* =================================
   TABLET
================================= */

@media (max-width: 900px) {

  .ncco-questions {
    padding: 70px 30px 80px;
  }

  .ncco-questions__heading {
    font-size: 36px;
    line-height: 44px;
  }

  .ncco-questions__grid {
    grid-template-columns: repeat(2, 1fr);
    column-gap: 24px;
  }

}


/* =================================
   MOBILE
================================= */

@media (max-width: 600px) {

  .ncco-questions {
    padding: 55px 20px 65px;
  }

  .ncco-questions__header {
    margin-bottom: 35px;
  }

  .ncco-questions__heading {
    font-size: 30px;
    line-height: 38px;
    letter-spacing: -1px;
  }

  .ncco-questions__grid {
    grid-template-columns: 1fr;
  }

  .ncco-questions__question {
    padding: 16px 0;
  }

  .ncco-questions__question-text {
    font-size: 13px;
    line-height: 18px;
  }

  .ncco-questions__answer-inner {
    font-size: 12px;
    line-height: 18px;
  }

}

</style>


<script>

document.addEventListener('DOMContentLoaded', function () {

  const faqItems = document.querySelectorAll('.ncco-questions__item');

  faqItems.forEach(function (item) {

    const button = item.querySelector('.ncco-questions__question');

    if (!button) return;

    button.addEventListener('click', function () {

      const isOpen = item.classList.contains('ncco-questions__item--open');

      item.classList.toggle('ncco-questions__item--open');

      button.setAttribute(
        'aria-expanded',
        isOpen ? 'false' : 'true'
      );

    });

  });

});

</script>


{% schema %}

