          "default": "<p>NCCO-IG uses patented nano-catalytic oxidation to eliminate airborne bacteria, viruses, and harmful gases, making it ideal for sterile zones and healthcare facilities.</p>"
        }

      ]

    }

  ],

  "presets": [

    {
      "name": "NCCO Questions",

      "blocks": [
        {
          "type": "faq"
        },
        {
          "type": "faq"
        },
        {
          "type": "faq"
        },
        {
          "type": "faq"
        },
        {
          "type": "faq"
        },
        {
          "type": "faq"
        }
      ]

    }

  ]

}

{% endschema %}