{% assign img_asset = section.settings.asset %}
{% assign img_asset2 = section.settings.asset_secondary %}
{% assign layout = section.settings.layout | default: 'image_first' %}
{% assign dual = false %}
{% if img_asset != blank and img_asset2 != blank %}{% assign dual = true %}{% endif %}

{% assign bg_color = section.settings.bg_color | default: '#ffffff' %}
{% if section.settings.dark %}
  {% assign bg_color = '#081D3A' %}
{% endif %}

<section class="ncco-iwt-wrap">
  <div class="ncco-iwt{% if section.settings.dark %} ncco-section--dark{% endif %}" style="background: {{ bg_color }};">
    <div class="ncco-iwt__inner{% if layout == 'text_first' %} ncco-iwt__inner--reverse{% endif %}">
      <div class="ncco-iwt__img{% if dual %} ncco-iwt__img--dual{% endif %}">
        {% if dual %}
          <img class="ncco-iwt__img-top" src="{{ img_asset | asset_url }}" alt="{{ section.settings.heading }}" loading="lazy">
          <img class="ncco-iwt__img-bottom" src="{{ img_asset2 | asset_url }}" alt="" loading="lazy">
          {% if section.settings.overlay_text != blank %}
            <div class="ncco-iwt__overlay-card">{{ section.settings.overlay_text }}</div>
          {% endif %}
        {% elsif section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 1000 }}"
               alt="{{ section.settings.heading }}" loading="lazy">
        {% elsif img_asset != blank %}
          <img src="{{ img_asset | asset_url }}"
               alt="{{ section.settings.heading }}" loading="lazy">
        {% else %}
          <div class="ncco-iwt__placeholder"></div>
        {% endif %}
      </div>
      <div class="ncco-iwt__text">
        <div class="ncco-eyebrow-dash"></div>
        {% if section.settings.eyebrow != blank %}
          <p class="ncco-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="ncco-iwt__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.text != blank %}
          <div class="ncco-iwt__body">{{ section.settings.text }}</div>
        {% endif %}
        {% if section.settings.cta_label != blank %}
          <div class="ncco-iwt__cta">
            {%- render 'ncco-cta', label: section.settings.cta_label, url: section.settings.cta_url, variant: 'blue' -%}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
.ncco-iwt-wrap {
  width: 100%;
  max-width: 1360px;
  margin: 36px auto;
  padding: 0 16px;
  box-sizing: border-box;
}

.ncco-iwt {
  background: #ffffff;
  border-radius: 28px;
  padding: 64px 60px;
  box-sizing: border-box;
}

.ncco-iwt__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}

.ncco-iwt__inner--reverse .ncco-iwt__img { order: 2; }
.ncco-iwt__inner--reverse .ncco-iwt__text { order: 1; }

.ncco-iwt__img img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 24px;
}

.ncco-eyebrow-dash {
  width: 32px;
  height: 3px;
  background: #FECB07;
  border-radius: 2px;
  margin-bottom: 12px;
}

.ncco-iwt__text .ncco-eyebrow {
  font-family: 'Geist', sans-serif;
  font-size: 13px;
  font-weight: 600;
  color: #647082;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin: 0 0 12px;
}

.ncco-iwt__heading {
  font-family: 'Geist', sans-serif;
  font-size: 42px;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -1.2px;
  color: #081D3A;
  margin: 0 0 18px;
}

.ncco-iwt__body {
  font-family: 'Geist', sans-serif;
  font-size: 14.5px;
  font-weight: 400;
  line-height: 1.6;
  color: #647082;
}

.ncco-iwt__body p {
  margin: 0 0 16px;
}
.ncco-iwt__body p:last-child {
  margin-bottom: 0;
}

.ncco-iwt__body strong {
  display: block;
  font-size: 14px;
  font-weight: 700;
  color: #081D3A;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  margin-top: 22px;
  margin-bottom: 6px;
}

.ncco-iwt__cta {
  margin-top: 32px;
}

@media (max-width: 1024px) {
  .ncco-iwt { padding: 48px 36px; }
  .ncco-iwt__inner { grid-template-columns: 1fr; gap: 40px; }
  .ncco-iwt__heading { font-size: 34px; line-height: 42px; }
  .ncco-iwt__inner--reverse .ncco-iwt__img { order: unset; }
  .ncco-iwt__inner--reverse .ncco-iwt__text { order: unset; }
}

@media (max-width: 600px) {
  .ncco-iwt-wrap { padding: 0 12px; margin: 24px auto; }
  .ncco-iwt { padding: 36px 20px; border-radius: 20px; }
  .ncco-iwt__heading { font-size: 28px; line-height: 34px; letter-spacing: -0.8px; }
  .ncco-iwt__body { font-size: 14px; }
}
</style>

{% schema %}
{
  "name": "NCCO Image + Text",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "richtext", "id": "text", "label": "Body text"},
    {"type": "image_picker", "id": "image", "label": "Image (use Theme Editor)"},
    {"type": "text", "id": "asset", "label": "Image asset filename (e.g. ncco-img-commercial-office.png)"},
    {"type": "text", "id": "asset_secondary", "label": "Second image asset (stacked layout)"},
    {"type": "text", "id": "overlay_text", "label": "Overlay card text (stacked layout only)"},
    {"type": "select", "id": "layout", "label": "Layout", "options": [
      {"value": "image_first", "label": "Image left, text right"},
      {"value": "text_first", "label": "Text left, image right"}
    ], "default": "image_first"},
    {"type": "text", "id": "cta_label", "label": "Button text"},
    {"type": "url", "id": "cta_url", "label": "Button URL"},
    {"type": "checkbox", "id": "dark", "label": "Dark background", "default": false},
    {"type": "color", "id": "bg_color", "label": "Card background color", "default": "#ffffff"}
  ],
  "presets": [{"name": "NCCO Image + Text"}]
}
{% endschema %}
