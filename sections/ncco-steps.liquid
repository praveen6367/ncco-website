<section class="ncco-meaning-wrap">
  <div class="ncco-meaning">
    <div class="ncco-container">
      <div class="ncco-meaning__wrap">

      <div class="ncco-meaning__header">
        {% if section.settings.eyebrow != blank %}
          <p class="ncco-meaning__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="ncco-meaning__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.body != blank %}
          <p class="ncco-meaning__body">{{ section.settings.body }}</p>
        {% endif %}
      </div>

      <!-- 4-column N-C-C-O grid -->
      <div class="ncco-meaning__grid">

        {%- comment -%} Figma order: Nano (blue, offset), Confined (yellow, top), Catalytic (blue, offset), Oxidation (yellow, top) {%- endcomment -%}
        <div class="ncco-meaning__col ncco-meaning__col--offset">
                 <div class="ncco-meaning__text-block">
            <h3 class="ncco-meaning__letter-title"><span class="ncco-meaning__fl">N</span>ano</h3>
            <p class="ncco-meaning__letter-body">{{ section.settings.body_nano }}</p>
          </div>
          <div class="ncco-meaning__card ncco-meaning__card--blue">
            <img src="{{ 'ncco-icon-nano.png' | asset_url }}" alt="Nano" loading="lazy">
          </div>
   
        </div>

        <div class="ncco-meaning__col">
          <div class="ncco-meaning__text-block">
            <h3 class="ncco-meaning__letter-title"><span class="ncco-meaning__fl">C</span>onfined</h3>
            <p class="ncco-meaning__letter-body">{{ section.settings.body_confined }}</p>
          </div>
          <div class="ncco-meaning__card ncco-meaning__card--yellow">
            <img src="{{ 'ncco-icon-confined.png' | asset_url }}" alt="Confined" loading="lazy">
          </div>
          
        </div>

        <div class="ncco-meaning__col ncco-meaning__col--offset">
          <div class="ncco-meaning__text-block">
            <h3 class="ncco-meaning__letter-title"><span class="ncco-meaning__fl">C</span>atalytic</h3>
            <p class="ncco-meaning__letter-body">{{ section.settings.body_catalytic }}</p>
          </div>
          <div class="ncco-meaning__card ncco-meaning__card--blue">
            <img src="{{ 'ncco-icon-catalytic.png' | asset_url }}" alt="Catalytic" loading="lazy">
          </div>
          
        </div>

        <div class="ncco-meaning__col">
            <div class="ncco-meaning__text-block">
            <h3 class="ncco-meaning__letter-title"><span class="ncco-meaning__fl">O</span>xidation</h3>
            <p class="ncco-meaning__letter-body">{{ section.settings.body_oxidation }}</p>
          </div>
          <div class="ncco-meaning__card ncco-meaning__card--yellow">
            <img src="{{ 'ncco-icon-oxidation.png' | asset_url }}" alt="Oxidation" loading="lazy">
          </div>
        
        </div>

      </div>

      {% if section.settings.cta_label != blank %}
        {%- render 'ncco-cta', label: section.settings.cta_label, url: section.settings.cta_url, variant: 'blue', class: 'ncco-meaning__cta' -%}
      {% endif %}

    </div>
  </div>
  </div>
</section>

<style>
/* ── Figma NCCO Meaning (1423:25230, 1920×968) ── */
.ncco-meaning-wrap {
  width: 100%;
  max-width: 100%;
  padding: 0 16px;
  margin: 12px auto 44px;
  box-sizing: border-box;
  background: #fff;
}
.ncco-meaning {
  border-radius: 28px;
  padding: 64px 40px;
  background: #fff;
  width: 100%;
  max-width: 100%;
  margin: 0 auto;
  box-sizing: border-box;
}
.ncco-meaning .ncco-container {
  max-width: 1240px;
  margin: 0 auto;
  padding: 0;
  box-sizing: border-box;
}

/* Desktop: header top-left, CTA top-right, grid full-width below */
.ncco-meaning__wrap {
  display: grid;
  grid-template-columns: 1fr auto;
  grid-template-rows: auto auto;
  grid-template-areas: "header cta" "grid grid";
  column-gap: 48px;
  row-gap: 56px;
  align-items: start;
}
.ncco-meaning__header { grid-area: header; max-width: 752px; }
.ncco-meaning__grid   { grid-area: grid; }
.ncco-meaning__cta    { grid-area: cta; align-self: center; }

.ncco-meaning__eyebrow {
  font-family: 'Geist', sans-serif;
  font-size: 14px; font-weight: 500; letter-spacing: 0.05em;
  color: #647082; text-transform: uppercase; margin: 0 0 24px;
}
.ncco-meaning__eyebrow::before {
  content: ''; display: block; width: 28px; height: 2px; background: #FECB07; margin-bottom: 8px;
}
.ncco-meaning__heading {
  font-family: 'Geist', sans-serif;
  font-size: 48px; font-weight: 500; line-height: 1.15; letter-spacing: -1.8px;
  color: #081D3A; margin: 0 0 24px;
}
.ncco-meaning__body {
  font-family: 'Geist', sans-serif;
  font-size: 16px; font-weight: 400; line-height: 24px; letter-spacing: -0.32px;
  color: #647082; margin: 0;
}

/* 4-col grid — staggered zig-zag layout (Cols 1 & 3 offset down) */
.ncco-meaning__grid {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 30px; align-items: start;
}
.ncco-meaning__col {
  display: flex; flex-direction: column;
}
.ncco-meaning__col--offset { padding-top: 61px; }

.ncco-meaning__text-block { display: flex; flex-direction: column; margin-bottom: 24px; min-height: 130px; }
.ncco-meaning__letter-title {
  font-family: 'Geist', sans-serif;
  font-size: 20px; font-weight: 500; letter-spacing: -0.4px;
  color: #081D3A; text-transform: uppercase; margin: 0 0 16px;
  line-height: 1;
}
.ncco-meaning__fl {
  font-size: 38px; line-height: 1; letter-spacing: -1.52px;
  display: inline-block; vertical-align: baseline;
  margin-right: -1px;
}
.ncco-meaning__letter-body {
  font-family: 'Geist', sans-serif;
  font-size: 15px; font-weight: 400; line-height: 22px; letter-spacing: -0.3px;
  color: #647082; margin: 0;
}

/* Colored icon cards — soft pastel background, height 198, radius 20 */
.ncco-meaning__card {
  height: 198px; border-radius: 20px;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.ncco-meaning__card--blue   { background: #EEF3FA; }
.ncco-meaning__card--yellow { background: #FFF9E6; }
.ncco-meaning__card img {
  max-width: 50%; max-height: 70%; width: auto; height: auto; display: block;
  object-fit: contain;
}

@media (max-width: 1200px) {
  .ncco-meaning { padding: 48px 24px; }
  .ncco-meaning__grid { grid-template-columns: repeat(2, 1fr); }
  .ncco-meaning__col--offset { padding-top: 0; }
  .ncco-meaning__heading { font-size: 40px; line-height: 48px; letter-spacing: -1.2px; }
}
@media (max-width: 989px) {
  .ncco-meaning { padding: 60px 24px; }
  .ncco-meaning__wrap {
    grid-template-columns: 1fr;
    grid-template-areas: "header" "grid" "cta";
    row-gap: 48px;
  }
  .ncco-meaning__heading { font-size: 36px; line-height: 44px; letter-spacing: -1.2px; }
  .ncco-meaning__body { font-size: 16px; }
}
@media (max-width: 600px) {
  .ncco-meaning { padding: 40px 16px; }

  /* Center header */
  .ncco-meaning__header { text-align: center; }
  .ncco-meaning__eyebrow { display: flex; flex-direction: column; align-items: center; }
  .ncco-meaning__eyebrow::before { margin-bottom: 8px; }
  .ncco-meaning__heading { font-size: 28px; line-height: 36px; letter-spacing: -0.8px; }
  .ncco-meaning__body { font-size: 15px; }

  /* Horizontal scroll row */
  .ncco-meaning__grid {
    display: flex;
    flex-direction: row;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    gap: 12px;
    padding-bottom: 4px;
    scrollbar-width: none;
  }
  .ncco-meaning__grid::-webkit-scrollbar { display: none; }
  .ncco-meaning__col {
    flex: 0 0 calc(75vw - 28px);
    scroll-snap-align: start;
    padding-top: 0 !important;
  }
  .ncco-meaning__card { height: 180px; border-radius: 16px; }
  .ncco-meaning__text-block { margin-top: 16px; }
  .ncco-meaning__letter-title { font-size: 18px; margin-bottom: 10px; }
  .ncco-meaning__fl { font-size: 30px; }
  .ncco-meaning__letter-body { font-size: 14px; line-height: 20px; }

  /* Full-width CTA */
  .ncco-meaning__cta { width: 100% !important; }
  .ncco-meaning .ncco-cta { width: 100%; justify-content: space-between; }
}
</style>

{% schema %}
{
  "name": "NCCO Meaning",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NCCO MEANING"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Every Letter, Breakthrough. The Technology Behind NCCO"},
    {"type": "textarea", "id": "body", "label": "Body text", "default": "Each letter in NCCO reflects the scientific thinking that powers our innovation from nanotech structures to safe molecular oxidation. It\u2019s not just a name \u2014 it\u2019s our entire process, defined."},
    {"type": "text", "id": "cta_label", "label": "CTA label", "default": "Explore NCCO Technology"},
    {"type": "url", "id": "cta_url", "label": "CTA URL"},
    {"type": "header", "content": "N \u2014 Nano"},
    {"type": "textarea", "id": "body_nano", "label": "Nano body", "default": "The catalytic material is a synthetic mineral featuring nanoscale pores. It is non-toxic and fully reusable."},
    {"type": "header", "content": "C \u2014 Confined"},
    {"type": "textarea", "id": "body_confined", "label": "Confined body", "default": "The nanoporous structure effectively adsorbs airborne pollutants, thereby reducing their concentration in the air."},
    {"type": "header", "content": "C \u2014 Catalytic"},
    {"type": "textarea", "id": "body_catalytic", "label": "Catalytic body", "default": "The nanopores contain abundant transition metals that efficiently catalyze gaseous pollutants."},
    {"type": "header", "content": "O \u2014 Oxidation"},
    {"type": "textarea", "id": "body_oxidation", "label": "Oxidation body", "default": "Only clean air, water vapor, and CO\u2082 are released \u2014 filter lasts up to 12 years."}
  ],
  "presets": [{"name": "NCCO Meaning"}]
}
{% endschema %}
