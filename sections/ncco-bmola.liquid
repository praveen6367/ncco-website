<section class="ncco-bmola">
  <div class="ncco-bmola__inner">

    <!-- LEFT CONTENT -->
    <div class="ncco-bmola__content">

      {% if section.settings.eyebrow != blank %}
        <div class="ncco-bmola__eyebrow">
          <span></span>
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="ncco-bmola__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      <div class="ncco-bmola__points">

        {% if section.settings.point_1 != blank %}
          <div class="ncco-bmola__point">
            <span class="ncco-bmola__icon">+</span>
            <p>{{ section.settings.point_1 }}</p>
          </div>
        {% endif %}

        {% if section.settings.point_2 != blank %}
          <div class="ncco-bmola__point">
            <span class="ncco-bmola__icon">+</span>
            <p>{{ section.settings.point_2 }}</p>
          </div>
        {% endif %}

        {% if section.settings.point_3 != blank %}
          <div class="ncco-bmola__point">
            <span class="ncco-bmola__icon">+</span>
            <p>{{ section.settings.point_3 }}</p>
          </div>
        {% endif %}

        {% if section.settings.point_4 != blank %}
          <div class="ncco-bmola__point">
            <span class="ncco-bmola__icon">+</span>
            <p>{{ section.settings.point_4 }}</p>
          </div>
        {% endif %}

      </div>

      {% if section.settings.button_text != blank %}
        <a
          href="{{ section.settings.button_url }}"
          class="ncco-bmola__button"
        >
          <span>{{ section.settings.button_text }}</span>
          <span class="ncco-bmola__button-icon">↗</span>
        </a>
      {% endif %}

    </div>


    <!-- RIGHT IMAGE GRID -->
    <div class="ncco-bmola__images">

      <!-- IMAGE 1 -->
      <div class="ncco-bmola__image ncco-bmola__image--top">
        {% if section.settings.image_1 != blank %}
          {{
            section.settings.image_1
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              alt: section.settings.image_1.alt
          }}
        {% endif %}
      </div>

      <!-- IMAGE 2 -->
      <div class="ncco-bmola__image ncco-bmola__image--top">
        {% if section.settings.image_2 != blank %}
          {{
            section.settings.image_2
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              alt: section.settings.image_2.alt
          }}
        {% endif %}
      </div>

      <!-- IMAGE 3 -->
      <div class="ncco-bmola__image ncco-bmola__image--bottom">
        {% if section.settings.image_3 != blank %}
          {{
            section.settings.image_3
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              alt: section.settings.image_3.alt
          }}
        {% endif %}
      </div>

    </div>

  </div>
</section>


<style>

.ncco-bmola {
  width: 100%;
  padding: 80px 48px;
  box-sizing: border-box;
  background: transparent;
}

.ncco-bmola__inner {
  width: 100%;
  max-width: 1180px;
  margin: 0 auto;

  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 70px;
  align-items: center;
}


/* =========================
   LEFT CONTENT
   ========================= */

.ncco-bmola__content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.ncco-bmola__eyebrow {
  display: flex;
  flex-direction: column;
  gap: 8px;

  margin-bottom: 36px;

  font-family: 'Geist', sans-serif;
  font-size: 11px;
  font-weight: 500;
  line-height: 14px;
  letter-spacing: 0.3px;

  color: #647082;
  text-transform: uppercase;
}

.ncco-bmola__eyebrow span {
  width: 18px;
  height: 2px;
  background: #FECB07;
}


/* DESCRIPTION */

.ncco-bmola__description {
  max-width: 470px;

  margin-bottom: 38px;

  font-family: 'Geist', sans-serif;
  font-size: 16px;
  font-weight: 400;
  line-height: 24px;
  letter-spacing: -0.15px;

  color: #647082;
}


/* POINTS */

.ncco-bmola__points {
  display: flex;
  flex-direction: column;
  gap: 20px;

  margin-bottom: 46px;
}

.ncco-bmola__point {
  display: flex;
  align-items: center;
  gap: 14px;
}

.ncco-bmola__icon {
  flex: 0 0 28px;

  width: 28px;
  height: 28px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: rgba(254, 203, 7, 0.14);

  color: #FECB07;

  font-family: Arial, sans-serif;
  font-size: 17px;
  font-weight: 400;
  line-height: 28px;
}

.ncco-bmola__point p {
  margin: 0;

  font-family: 'Geist', sans-serif;
  font-size: 14px;
  font-weight: 400;
  line-height: 20px;

  color: #081D3A;
}


/* BUTTON */

.ncco-bmola__button {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;

  min-width: 160px;
  height: 44px;

  padding: 0 6px 0 18px;

  box-sizing: border-box;

  border-radius: 24px;

  background: #0845B5;

  color: #fff;

  text-decoration: none;

  font-family: 'Geist', sans-serif;
  font-size: 11px;
  font-weight: 600;
  line-height: 1;

  box-shadow: 0 8px 18px rgba(8, 69, 181, 0.18);
}

.ncco-bmola__button-icon {
  width: 32px;
  height: 32px;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #FECB07;

  color: #081D3A;

  font-size: 18px;
  line-height: 1;
}


/* =========================
   RIGHT IMAGE GRID
   ========================= */

.ncco-bmola__images {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 14px;

  align-items: stretch;
}


/* IMAGE BOX */

.ncco-bmola__image {
  overflow: hidden;

  border-radius: 16px;

  background: transparent;

  display: flex;
  align-items: center;
  justify-content: center;

  box-sizing: border-box;
}

.ncco-bmola__image--top {
  height: 235px;
}

.ncco-bmola__image--bottom {
  grid-column: 1 / -1;
  height: 235px;
}


/* IMAGE */

.ncco-bmola__image img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: contain;
  object-position: center;
}


/* =========================
   TABLET
   ========================= */

@media (max-width: 1024px) {

  .ncco-bmola {
    padding: 70px 36px;
  }

  .ncco-bmola__inner {
    gap: 45px;
  }

  .ncco-bmola__description {
    font-size: 15px;
    line-height: 23px;
  }

  .ncco-bmola__point p {
    font-size: 13px;
  }

  .ncco-bmola__image--top,
  .ncco-bmola__image--bottom {
    height: 200px;
  }

}


/* =========================
   PHONE
   ========================= */

@media (max-width: 768px) {

  .ncco-bmola {
    padding: 55px 24px;
  }

  .ncco-bmola__inner {
    grid-template-columns: 1fr;
    gap: 45px;
  }

  .ncco-bmola__description {
    max-width: 100%;

    font-size: 16px;
    line-height: 24px;

    margin-bottom: 30px;
  }

  .ncco-bmola__eyebrow {
    margin-bottom: 28px;
  }

  .ncco-bmola__points {
    gap: 17px;
    margin-bottom: 35px;
  }

  .ncco-bmola__point {
    gap: 12px;
  }

  .ncco-bmola__point p {
    font-size: 14px;
    line-height: 20px;
  }

  .ncco-bmola__icon {
    flex-basis: 26px;
    width: 26px;
    height: 26px;
    font-size: 16px;
  }

  .ncco-bmola__images {
    gap: 10px;
  }

  .ncco-bmola__image--top {
    height: 170px;
  }

  .ncco-bmola__image--bottom {
    height: 190px;
  }

}


/* =========================
   SMALL PHONE
   ========================= */

@media (max-width: 480px) {

  .ncco-bmola {
    padding: 45px 20px;
  }

  .ncco-bmola__images {
    grid-template-columns: 1fr 1fr;
  }

  .ncco-bmola__image--top {
    height: 145px;
  }

  .ncco-bmola__image--bottom {
    height: 170px;
  }

}

</style>


{% schema %}
{
  "name": "NCCO b-MOLA",
  "tag": "section",

  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CONSUMER AIR PURIFIERS"
    },

    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Designed for everyday comfort and convenience, b-MOLA brings advanced NCCO technology into compact devices for homes, cars, workspaces, and beyond."
    },

    {
      "type": "text",
      "id": "point_1",
      "label": "Point 1",
      "default": "Perfect for individuals, families, and remote work setups"
    },

    {
      "type": "text",
      "id": "point_2",
      "label": "Point 2",
      "default": "Combines high-performance filtration with elegant design."
    },

    {
      "type": "text",
      "id": "point_3",
      "label": "Point 3",
      "default": "Brings clean air to everyday spaces at home or on the move"
    },

    {
      "type": "text",
      "id": "point_4",
      "label": "Point 4",
      "default": "Easy to use, lightweight, and low-maintenance"
    },

    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },

    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },

    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },

    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "VIEW MORE DETAILS"
    },

    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }

  ],

  "presets": [
    {
      "name": "NCCO b-MOLA"
    }
  ]
}
{% endschema %}