{%- assign bg = section.settings.background_image -%}
{%- assign overlay = section.settings.overlay_opacity | divided_by: 100.0 -%}
{%- assign default_bg = 'ncco-hero-bg.jpg' | asset_url -%}
{%- assign bg_url = default_bg -%}
{%- if bg %}{% assign bg_url = bg | image_url: width: 2000 %}{% endif -%}
{%- if section.settings.background_asset != blank -%}
  {%- assign bg_url = section.settings.background_asset | asset_url -%}
{%- endif -%}

{%- assign has_bullets = false -%}
{%- if section.settings.bullet_1 != blank or section.settings.bullet_2 != blank or section.settings.bullet_3 != blank -%}
  {%- assign has_bullets = true -%}
{%- endif -%}

{%- assign brand_color = section.settings.brand_color | default: '#FECB07' -%}
{%- if brand_color == blank -%}{%- assign brand_color = '#FECB07' -%}{%- endif -%}
{%- assign cta_text_color = section.settings.cta_text_color | default: '#081D3A' -%}
{%- if cta_text_color == blank -%}{%- assign cta_text_color = '#081D3A' -%}{%- endif -%}

<section class="ncco-hero-wrap{% if section.settings.compact %} ncco-hero-wrap--compact{% endif %}">
  <div class="ncco-hero__bg" style="background-image: url('{{ bg_url }}')">
    <div class="ncco-hero__overlay"{% if section.settings.overlay_solid_color != blank %} style="background: {{ section.settings.overlay_solid_color }}"{% endif %}></div>

    <div class="ncco-hero__inner">
      <div class="ncco-hero__left">
        {%- if section.settings.logo_asset != blank -%}
          <img class="ncco-hero__logo" src="{{ section.settings.logo_asset | asset_url }}" alt="{{ section.settings.eyebrow }}" loading="eager">
        {%- elsif section.settings.eyebrow != blank -%}
          <p class="ncco-hero__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 class="ncco-hero__title">{{ section.settings.headline | remove: '<p>' | remove: '</p>' }}</h1>
        {%- if section.settings.subtext != blank -%}
          <p class="ncco-hero__sub"{% if section.settings.subtext_gap != blank %} style="margin-top:{{ section.settings.subtext_gap }}px"{% endif %}>{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>

      {%- if has_bullets or section.settings.cta_label != blank -%}
        <div class="ncco-hero__card" style="border-color:{{ brand_color }}">
          {%- if section.settings.card_image_asset != blank -%}
            <img class="ncco-hero__card-img" src="{{ section.settings.card_image_asset | asset_url }}" alt="" loading="eager">
          {%- endif -%}
          <div class="ncco-hero__card-shade"></div>

          {%- if has_bullets -%}
            <div class="ncco-hero__bullets">
              {%- if section.settings.bullet_1 != blank -%}<p>* {{ section.settings.bullet_1 }}</p>{%- endif -%}
              {%- if section.settings.bullet_2 != blank -%}<p>* {{ section.settings.bullet_2 }}</p>{%- endif -%}
              {%- if section.settings.bullet_3 != blank -%}<p>* {{ section.settings.bullet_3 }}</p>{%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.cta_label != blank -%}
            <a href="{{ section.settings.cta_url | default: '#' }}" class="ncco-hero__cta" style="background:{{ brand_color }};color:{{ cta_text_color }}">
              <span>{{ section.settings.cta_label }}</span>
              <span class="ncco-hero__cta-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M3 13L13 3M13 3H6M13 3V10" stroke="{{ brand_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
/* ── Full-width Hero with small side spacing ── */
.ncco-hero-wrap {
  width: 100%;
  max-width: 100%;
  margin: 10px 0 36px;
  padding: 0 16px;
  box-sizing: border-box;
  background: #fff;
}

/* Outer rounded card */
.ncco-hero__bg {
  position: relative;
  width: 100%;
  height: clamp(660px, 86vh, 760px);
  border-radius: 28px;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  overflow: hidden;
}

.ncco-hero__bg::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(2, 8, 17, 0.68) 0%,
    rgba(3, 19, 44, 0.68) 50%,
    rgba(4, 30, 70, 0.0544) 100%
  ) !important;
  z-index: 1;
}

.ncco-hero__overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 2;
  opacity: 1 !important;
}

/* Inner content — balanced flex row */
.ncco-hero__inner {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
  max-width: 1360px;
  margin: 0 auto;
  padding: 50px 36px;
  box-sizing: border-box;
  gap: 40px;
}

/* Left column */
.ncco-hero__left {
  flex: 1 1 auto;
  max-width: 580px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.ncco-hero__logo {
  height: 44px; width: auto; object-fit: contain; display: block; margin: 0 0 20px;
}
.ncco-hero__eyebrow {
  font-family: 'Geist', sans-serif;
  font-weight: 500; font-size: 15px; letter-spacing: -0.2px;
  color: #fff; margin: 0 0 16px;
}

.ncco-hero__title {
  font-family: 'Geist', sans-serif;
  font-weight: 600; font-size: 46px; line-height: 1.1; letter-spacing: -1.5px;
  color: #fff; margin: 0;
}
/* Accent color for <em> — gradient from brand_color (#FECB07) to white */
.ncco-hero__title em {
  font-style: normal;
  background: linear-gradient(90deg, {{ brand_color }} 0%, rgba(254, 203, 7, 0) 100%),
              linear-gradient(0deg, #FFFFFF, #FFFFFF);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  display: inline-block;
  padding-right: 0.2em;
  -webkit-box-decoration-break: clone;
  box-decoration-break: clone;
}

.ncco-hero__sub {
  font-family: 'Geist', sans-serif;
  font-weight: 400; font-size: 15px; line-height: 1.55; letter-spacing: -0.2px;
  color: rgba(255, 255, 255, 0.88); margin: 32px 0 0; max-width: 480px;
}

.ncco-hero__card {
  position: relative;
  width: 380px;
  height: 380px;
  flex: 0 0 380px;

  border: 1px solid #FECB07;
  border-radius: 28px;
  overflow: hidden;

  box-shadow: 0 8px 36px rgba(3, 12, 23, 0.6);

  display: flex;
  flex-direction: column;
  justify-content: flex-end;

  padding: 24px;
  box-sizing: border-box;
}

.ncco-hero__card-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center;

  display: block;
  z-index: 0;

  filter: brightness(0.65) saturate(0.75);
}

.ncco-hero__card::after {
  content: "";
  position: absolute;
  inset: 0;

  background: rgba(8, 29, 58, 0.55);

  z-index: 1;
  pointer-events: none;
}

.ncco-hero__card-shade {
  position: absolute;
  inset: 0;
  z-index: 1;

  background: rgba(8, 29, 58, 0.65) !important;
}

/* Bullets: sit above CTA */
.ncco-hero__bullets {
  position: relative; z-index: 2;
  display: flex; flex-direction: column; gap: 12px;
  margin-bottom: 20px;
}
.ncco-hero__bullets p {
  margin: 0; font-family: 'Geist', sans-serif;
  font-weight: 500; font-size: 15px; letter-spacing: -0.2px;
  color: #fff; line-height: 1.4;
}

/* CTA — pill anchored under bullets */
.ncco-hero__cta {
  position: relative; z-index: 2;
  display: inline-flex; align-self: flex-start;
  align-items: center; gap: 18px;
  background: #FECB07; color: #081D3A;
  font-family: 'Geist', sans-serif; font-weight: 600; font-size: 14px;
  text-transform: uppercase; text-decoration: none; letter-spacing: -0.01em;
  padding: 6px 6px 6px 22px; border-radius: 40px; white-space: nowrap;
  box-shadow: none;
  transition: filter .2s ease;
}
.ncco-hero__cta:hover { filter: brightness(0.95); color: #081D3A; }
.ncco-hero__cta-icon {
  display: inline-flex; align-items: center; justify-content: center;
  width: 34px; height: 34px; min-width: 34px;
  background: #081D3A; border-radius: 50%;
}

/* ── Responsive ── */
@media (max-width: 1200px) {
  .ncco-hero__inner { padding: 36px 28px; gap: 28px; }
  .ncco-hero__title { font-size: 38px; }
  .ncco-hero__sub { margin-top: 24px; font-size: 14px; }
  .ncco-hero__card { width: 340px; height: 340px; flex: 0 0 340px; padding: 20px; }
  .ncco-hero__bullets p { font-size: 14px; }
}

@media (max-width: 989px) {
  .ncco-hero-wrap { padding: 0 12px; margin: 8px auto 28px; }
  .ncco-hero__bg { height: auto; min-height: auto; border-radius: 28px; }
  .ncco-hero__inner {
    flex-direction: column; align-items: center; text-align: center;
    padding: 40px 20px 28px; gap: 22px;
  }
  .ncco-hero__left { max-width: 100%; align-items: center; text-align: center; }
  .ncco-hero__title { font-size: 34px; text-align: center; }
  .ncco-hero__sub { text-align: center; margin-left: auto; margin-right: auto; }
  .ncco-hero__card {
    width: 100%; max-width: 300px; height: auto; min-height: auto;
    flex: none; justify-content: flex-start;
    align-self: center; border-radius: 24px; padding: 18px 18px 16px;
    box-sizing: border-box;
  }
}

@media (max-width: 749px) {
  .ncco-hero-wrap { padding: 0 12px; margin: 6px auto 24px; }
  .ncco-hero__bg {
    border-radius: 28px;
    height: 643px;
    min-height: 643px;
  }
  .ncco-hero__inner {
    height: 100%;
    padding: 48px 16px 24px;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    box-sizing: border-box;
  }
  .ncco-hero__left {
    align-items: center; text-align: center; width: 100%; max-width: 100%;
  }
  .ncco-hero__eyebrow {
    font-size: 13.5px; font-weight: 500; margin-bottom: 12px; text-align: center;
    color: rgba(255, 255, 255, 0.95);
  }
  .ncco-hero__title {
    font-size: 28px; line-height: 1.15; letter-spacing: -1px;
    text-align: center; max-width: 295px; margin: 0 auto;
  }
  .ncco-hero__sub {
    font-size: 13px; line-height: 1.48; margin-top: 16px;
    text-align: center; max-width: 290px; margin-left: auto; margin-right: auto;
    color: rgba(255, 255, 255, 0.88);
  }
  .ncco-hero__card {
    width: 100%; max-width: 290px; height: auto; min-height: auto;
    flex: none; justify-content: flex-start;
    border: 1.5px solid #FECB07;
    border-radius: 24px; padding: 18px 18px 16px;
    margin: 0 auto; align-self: center; box-sizing: border-box;
    box-shadow: 0 8px 32px rgba(2, 8, 17, 0.5);
  }
  .ncco-hero__bullets {
    gap: 8px; margin-bottom: 16px; width: 100%;
  }
  .ncco-hero__bullets p {
    font-size: 13px; line-height: 1.35; text-align: left;
  }
  .ncco-hero__cta {
    display: flex; width: 100%; align-items: center;
    justify-content: space-between; align-self: stretch;
    padding: 4px 4px 4px 18px; border-radius: 40px;
    font-size: 12px; font-weight: 700; letter-spacing: 0.2px;
    gap: 10px; box-sizing: border-box;
  }
  .ncco-hero__cta-icon {
    width: 32px; height: 32px; min-width: 32px;
  }
  .ncco-hero__cta-icon svg {
    width: 13px; height: 13px;
  }
}
</style>

{% schema %}
{
  "name": "NCCO Hero",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow text"},
    {"type": "text", "id": "logo_asset", "label": "Logo asset filename (shows instead of eyebrow text)"},
    {"type": "text", "id": "brand_color", "label": "Brand accent color (hex, default #FECB07 yellow)"},
    {"type": "text", "id": "cta_text_color", "label": "CTA text color (hex, default #081D3A dark)"},
    {"type": "richtext", "id": "headline", "label": "Headline (use <em> for yellow gradient)"},
    {"type": "textarea", "id": "subtext", "label": "Subtext"},
    {"type": "header", "content": "Right card bullets (optional)"},
    {"type": "text", "id": "bullet_1", "label": "Bullet 1"},
    {"type": "text", "id": "bullet_2", "label": "Bullet 2"},
    {"type": "text", "id": "bullet_3", "label": "Bullet 3"},
    {"type": "header", "content": "CTA button"},
    {"type": "text", "id": "cta_label", "label": "Button text"},
    {"type": "url", "id": "cta_url", "label": "Button URL"},
    {"type": "header", "content": "Card image"},
    {"type": "text", "id": "card_image_asset", "label": "Card image filename (assets/)"},
    {"type": "header", "content": "Background"},
    {"type": "image_picker", "id": "background_image", "label": "Background image"},
    {"type": "text", "id": "background_asset", "label": "Background asset filename (overrides image picker)"},
    {"type": "checkbox", "id": "compact", "label": "Compact hero (shorter height, subtext tight below heading)", "default": false},
    {"type": "range", "id": "overlay_opacity", "min": 0, "max": 85, "step": 5, "unit": "%", "label": "Overlay opacity (unused — hero uses fixed 3-stop gradient)", "default": 55},
    {"type": "text", "id": "overlay_solid_color", "label": "Solid overlay color (e.g. rgba(8,29,58,0.78)) — overrides gradient"},
    {"type": "checkbox", "id": "dark", "label": "Dark background (unused)", "default": true},
    {"type": "number", "id": "subtext_gap", "label": "Subtext top gap (px, overrides default 255)"}
  ],
  "presets": [{"name": "NCCO Hero"}]
}
{% endschema %}
