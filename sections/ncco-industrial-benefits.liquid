<section class="ncco-industrial-benefits" id="ncco-industrial-benefits-{{ section.id }}">
  <div class="ncco-industrial-benefits__container">
    <div class="ncco-industrial-benefits__intro">
      <div class="ncco-industrial-benefits__intro-left">
        {% if section.settings.eyebrow != blank %}
          <div class="ncco-industrial-benefits__eyebrow-wrap">
            <span class="ncco-industrial-benefits__dash"></span>
            <span class="ncco-industrial-benefits__eyebrow">{{ section.settings.eyebrow }}</span>
          </div>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="ncco-industrial-benefits__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <a
            href="{{ section.settings.button_url | default: '#' }}"
            class="ncco-industrial-benefits__button"
          >
            <span class="ncco-industrial-benefits__button-text">{{ section.settings.button_text }}</span>
            <span class="ncco-industrial-benefits__button-icon">
              <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                <path d="M2.5 10.5L10.5 2.5M10.5 2.5H4.5M10.5 2.5V8.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        {% endif %}
      </div>

      {% if section.settings.description != blank %}
        <div class="ncco-industrial-benefits__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="ncco-industrial-benefits__grid-outer">
    <div class="ncco-industrial-benefits__grid-container">
      <div class="ncco-industrial-benefits__grid">
        <!-- Edge horizontal lines extending to screen edges -->
        <span class="ncco-industrial-benefits__edge-line ncco-industrial-benefits__edge-line--top-left"></span>
        <span class="ncco-industrial-benefits__edge-line ncco-industrial-benefits__edge-line--top-right"></span>
        <span class="ncco-industrial-benefits__edge-line ncco-industrial-benefits__edge-line--mid-left"></span>
        <span class="ncco-industrial-benefits__edge-line ncco-industrial-benefits__edge-line--mid-right"></span>
        <span class="ncco-industrial-benefits__edge-line ncco-industrial-benefits__edge-line--bot-left"></span>
        <span class="ncco-industrial-benefits__edge-line ncco-industrial-benefits__edge-line--bot-right"></span>
      {% for block in section.blocks %}
        {% assign icon_key = block.settings.icon %}
        {% if icon_key == blank %}
          {% case forloop.index %}
            {% when 1 %}{% assign icon_key = 'layers' %}
            {% when 2 %}{% assign icon_key = 'puzzle' %}
            {% when 3 %}{% assign icon_key = 'clock' %}
            {% when 4 %}{% assign icon_key = 'technology' %}
            {% when 5 %}{% assign icon_key = 'energy' %}
            {% when 6 %}{% assign icon_key = 'tools' %}
          {% endcase %}
        {% endif %}

        <div class="ncco-industrial-benefits__card" {{ block.shopify_attributes }}>
          <div class="ncco-industrial-benefits__icon">
            {% case icon_key %}
              {% when 'layers' %}
