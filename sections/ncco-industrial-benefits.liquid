            {% endcase %}
          </div>
          {% if block.settings.title != blank %}
            <h3 class="ncco-industrial-benefits__title">
              {{ block.settings.title }}
            </h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <div class="ncco-industrial-benefits__text">
              {{ block.settings.text }}
            </div>
