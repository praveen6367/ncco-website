<section class="ncco-industrial-benefits">
  <div class="ncco-industrial-benefits__container">
    <div class="ncco-industrial-benefits__intro">
      <div class="ncco-industrial-benefits__intro-left">
        {% if section.settings.eyebrow != blank %}
          <div class="ncco-industrial-benefits__eyebrow">
            <span></span>
            {{ section.settings.eyebrow }}
          </div>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="ncco-industrial-benefits__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
        {% if section.settings.button_text != blank %}
          <a
            href="{{ section.settings.button_url | default: '#' }}"
            class="ncco-industrial-benefits__button"
          >
            <span>{{ section.settings.button_text }}</span>
            <span class="ncco-industrial-benefits__button-icon">
              <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
                <path d="M2.5 10.5L10.5 2.5M10.5 2.5H4.5M10.5 2.5V8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        {% endif %}
      </div>
      {% if section.settings.description != blank %}
        <div class="ncco-industrial-benefits__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>
    <div class="ncco-industrial-benefits__grid">
      {% for block in section.blocks %}
        <div class="ncco-industrial-benefits__card" {{ block.shopify_attributes }}>
          <div class="ncco-industrial-benefits__icon">
            {% case block.settings.icon %}
              {% when 'layers' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M12 3L20 7.5L12 12L4 7.5L12 3Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  <path d="M4 12L12 16.5L20 12" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  <path d="M4 16.5L12 21L20 16.5" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                </svg>
              {% when 'puzzle' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M9 4.5C9 3.67 9.67 3 10.5 3C11.33 3 12 3.67 12 4.5V6H15V9H16.5C17.33 9 18 9.67 18 10.5C18 11.33 17.33 12 16.5 12H15V15H12V16.5C12 17.33 11.33 18 10.5 18C9.67 18 9 17.33 9 16.5V15H6V12H4.5C3.67 12 3 11.33 3 10.5C3 9.67 3.67 9 4.5 9H6V6H9V4.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  <path d="M15 15H18V16.5C18 17.33 18.67 18 19.5 18C20.33 18 21 17.33 21 16.5V15" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
              {% when 'clock' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.4"/>
                  <path d="M12 7V12L15 14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% when 'technology' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M5 18C8 15 8 9 11 6C12.5 4.5 14 4 16 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                  <path d="M8 19C11 16 11 11 14 8C15.5 6.5 17 6 19 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                  <path d="M5 15L8 18M9 10L12 13M14 5L17 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
              {% when 'energy' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M13.5 2L5 13H11L10.5 22L19 11H13L13.5 2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                </svg>
              {% when 'tools' %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M14 6.5C14 4.57 15.57 3 17.5 3C18.07 3 18.61 3.14 19.09 3.39L16.5 5.98L18.02 7.5L20.61 4.91C20.86 5.39 21 5.93 21 6.5C21 8.43 19.43 10 17.5 10C16.99 10 16.5 9.89 16.06 9.69L8.19 17.56C8.39 18 8.5 18.49 8.5 19C8.5 20.66 7.16 22 5.5 22C3.84 22 2.5 20.66 2.5 19C2.5 17.34 3.84 16 5.5 16C6.01 16 6.5 16.11 6.94 16.31L14.81 8.44C14.6 8 14.5 7.01 14.5 6.5H14Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                </svg>
              {% else %}
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.4"/>
                </svg>
            {% endcase %}
          </div>
          {% if block.settings.title != blank %}
            <h3 class="ncco-industrial-benefits__title">
              {{ block.settings.title }}
            </h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <div class="ncco-industrial-benefits__text">
              {{ block.settings.text }}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>
<style>
.ncco-industrial-benefits{
  width:100%;
  background:#fff;
  box-sizing:border-box;
}
.ncco-industrial-benefits__container{
  width:100%;
  max-width:1280px;
  margin:0 auto;
  box-sizing:border-box;
}
.ncco-industrial-benefits__intro{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:70px;
  min-height:235px;
  padding:48px 24px 38px;
  box-sizing:border-box;
}
.ncco-industrial-benefits__intro-left{
  display:flex;
  flex-direction:column;
  align-items:flex-start;
}
.ncco-industrial-benefits__eyebrow{
  display:flex;
  align-items:center;
  gap:0;
  margin-bottom:18px;
  font-family:'Geist',sans-serif;
  font-size:12px;
  line-height:16px;
  font-weight:400;
  color:#8295A8;
  text-transform:uppercase;
}
.ncco-industrial-benefits__eyebrow span{
  width:16px;
  height:1px;
  margin-right:0;
  background:#21B9A8;
}
.ncco-industrial-benefits__heading{
  max-width:430px;
  margin:0;
  font-family:'Geist',sans-serif;
  font-size:44px;
  line-height:52px;
  font-weight:500;
  letter-spacing:-1.3px;
  color:#0D2745;
}
.ncco-industrial-benefits__button{
  display:inline-flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  min-width:138px;
  margin-top:22px;
  padding:5px 5px 5px 14px;
  border-radius:50px;
  background:#21B9A8;
  color:#fff;
  text-decoration:none;
  font-family:'Geist',sans-serif;
  font-size:12px;
  line-height:16px;
  font-weight:500;
  text-transform:uppercase;
  box-sizing:border-box;
  box-shadow:0 7px 15px rgba(33,185,168,.18);
  transition:filter .2s ease,transform .2s ease;
}
.ncco-industrial-benefits__button:hover{
  color:#fff;
  filter:brightness(.96);
  transform:translateY(-1px);
}
.ncco-industrial-benefits__button-icon{
  width:24px;
  height:24px;
  min-width:24px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:50%;
  background:#fff;
  color:#21B9A8;
}
.ncco-industrial-benefits__button-icon svg{
  display:block;
}
.ncco-industrial-benefits__description{
  align-self:center;
  max-width:430px;
  margin-left:auto;
  padding-top:8px;
  font-family:'Geist',sans-serif;
  font-size:16px;
  line-height:24px;
  font-weight:400;
  color:#8295A8;
}
.ncco-industrial-benefits__description p{
  margin:0;
}
.ncco-industrial-benefits__grid{
  width:100%;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  border-top:1px solid #E6EAEC;
  border-left:1px solid #E6EAEC;
  box-sizing:border-box;
}
.ncco-industrial-benefits__card{
  min-height:155px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:28px 25px;
  text-align:center;
  border-right:1px solid #E6EAEC;
  border-bottom:1px solid #E6EAEC;
  box-sizing:border-box;
  background:#fff;
}
.ncco-industrial-benefits__icon{
  width:25px;
  height:25px;
  margin-bottom:13px;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#21B9A8;
}
.ncco-industrial-benefits__icon svg{
  display:block;
}
.ncco-industrial-benefits__title{
  margin:0 0 8px;
  font-family:'Geist',sans-serif;
  font-size:16px;
  line-height:21px;
  font-weight:500;
  color:#172B43;
  text-transform:uppercase;
}
.ncco-industrial-benefits__text{
  max-width:260px;
  font-family:'Geist',sans-serif;
  font-size:14px;
  line-height:21px;
  font-weight:400;
  color:#8295A8;
}
@media(max-width:900px){
  .ncco-industrial-benefits__intro{
    grid-template-columns:1fr;
    gap:20px;
    min-height:auto;
    padding:45px 30px 35px;
  }
  .ncco-industrial-benefits__description{
    margin-left:0;
    padding-top:0;
  }
  .ncco-industrial-benefits__grid{
    grid-template-columns:repeat(2,1fr);
  }
}
@media(max-width:600px){
  .ncco-industrial-benefits__intro{
    padding:40px 20px 32px;
  }
  .ncco-industrial-benefits__eyebrow{
    font-size:11px;
    line-height:15px;
  }
  .ncco-industrial-benefits__heading{
    font-size:34px;
    line-height:41px;
  }
  .ncco-industrial-benefits__description{
    font-size:15px;
    line-height:23px;
  }
  .ncco-industrial-benefits__button{
    font-size:11px;
    line-height:15px;
  }
  .ncco-industrial-benefits__grid{
    grid-template-columns:1fr;
  }
  .ncco-industrial-benefits__card{
    min-height:145px;
    padding:28px 20px;
  }
  .ncco-industrial-benefits__title{
    font-size:15px;
    line-height:20px;
  }
  .ncco-industrial-benefits__text{
    font-size:14px;
    line-height:21px;
  }
}
</style>
{% schema %}
{
  "name":"NCCO Industrial Benefits",
  "tag":"section",
  "settings":[
    {
      "type":"text",
      "id":"eyebrow",
      "label":"Eyebrow",
      "default":"INDUSTRIAL BENEFITS"
    },
    {
      "type":"text",
      "id":"heading",
      "label":"Heading",
      "default":"Engineered for Demanding Spaces"
    },
    {
      "type":"richtext",
      "id":"description",
      "label":"Description",
      "default":"<p>RHT systems are built to deliver powerful, continuous air purification in high-risk, high-traffic environments where performance and reliability are non-negotiable.</p>"
    },
    {
      "type":"text",
      "id":"button_text",
      "label":"Button text",
      "default":"EXPLORE PRODUCT RANGE"
    },
    {
      "type":"url",
      "id":"button_url",
      "label":"Button URL"
    }
  ],
  "blocks":[
    {
      "type":"benefit",
      "name":"Benefit",
      "settings":[
        {
          "type":"select",
          "id":"icon",
          "label":"Icon",
          "options":[
            {
              "value":"layers",
              "label":"Layers"
            },
            {
              "value":"puzzle",
              "label":"Modular"
            },
            {
              "value":"clock",
              "label":"Clock"
            },
            {
              "value":"technology",
              "label":"Technology"
            },
            {
              "value":"energy",
              "label":"Energy"
            },
            {
              "value":"tools",
              "label":"Tools"
            }
          ],
          "default":"layers"
        },
        {
          "type":"text",
          "id":"title",
          "label":"Title",
          "default":"DESIGNED FOR LARGE SPACES"
        },
        {
          "type":"text",
          "id":"text",
          "label":"Description",
          "default":"Purifies high air volumes across hospitals, stations, and factories."
        }
      ]
    }
  ],
  "max_blocks":6,
  "presets":[
    {
      "name":"NCCO Industrial Benefits",
      "blocks":[
        {
          "type":"benefit",
          "settings":{
            "icon":"layers",
            "title":"DESIGNED FOR LARGE SPACES",
            "text":"Purifies high air volumes across hospitals, stations, and factories."
          }
        },
        {
          "type":"benefit",
          "settings":{
            "icon":"puzzle",
            "title":"MODULAR INSTALLATION",
            "text":"Fits diverse infrastructures with scalable setup options."
          }
        },
        {
          "type":"benefit",
          "settings":{
            "icon":"clock",
            "title":"24/7 RELIABLE OPERATION",
            "text":"Non-stop air treatment with minimal downtime or servicing."
          }
        },
        {
          "type":"benefit",
          "settings":{
            "icon":"technology",
            "title":"POWERED BY NCCO TECHNOLOGY",
            "text":"Breaks down pollutants using patented nanotech purification."
          }
        },
        {
          "type":"benefit",
          "settings":{
            "icon":"energy",
            "title":"ENERGY-EFFICIENT DESIGN",
            "text":"Optimized airflow reduces power use without compromising results."
          }
        },
        {
          "type":"benefit",
          "settings":{
            "icon":"tools",
            "title":"LOW MAINTENANCE, LONG LIFE",
            "text":"Durable systems that reduce filter change cycles and cost."
          }
        }
      ]
    }
  ]
}
{% endschema %}