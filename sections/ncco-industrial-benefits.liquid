</section>

<style>
.ncco-industrial-benefits {
  width: 100%;
  background-color: #FFFFFF;
  box-sizing: border-box;
  padding: 84px 0 0 !important;
  margin-bottom: 0 !important;
  overflow-x: clip;
}

div:has(> .ncco-industrial-benefits),
section:has(> .ncco-industrial-benefits) {
  margin-bottom: 0 !important;
  padding-bottom: 0 !important;
}

.ncco-industrial-benefits__container {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 40px;
  box-sizing: border-box;
}

/* INTRO / HEADER */
.ncco-industrial-benefits__intro {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 48px;
  margin-bottom: 56px;
  box-sizing: border-box;
}

.ncco-industrial-benefits__intro-left {
  flex: 1;
  max-width: 580px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.ncco-industrial-benefits__eyebrow-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 16px;
}

.ncco-industrial-benefits__dash {
  display: block;
  width: 28px;
  height: 2.5px;
  background-color: #22B39F;
  border-radius: 2px;
  margin-bottom: 12px;
}

.ncco-industrial-benefits__eyebrow {
  font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 13px;
  line-height: 1.35;
  font-weight: 500;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: #8295A8;
}

.ncco-industrial-benefits__heading {
  margin: 0 0 24px 0;
  font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: clamp(34px, 3.8vw, 44px);
  line-height: 1.24;
  font-weight: 500;
  letter-spacing: -0.6px;
  color: #0A1C2E;
  max-width: 520px;
}

.ncco-industrial-benefits__button {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  background-color: #22B39F;
  color: #FFFFFF;
  text-decoration: none;
  font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 13px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: 0.3px;
  text-transform: uppercase;
  padding: 6px 6px 6px 20px;
  border-radius: 9999px;
  box-sizing: border-box;
  box-shadow: 0 4px 14px rgba(34, 179, 159, 0.22);
  transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  cursor: pointer;
}

.ncco-industrial-benefits__button:hover {
  background-color: #1CA290;
  color: #FFFFFF;
  transform: translateY(-1px);
  box-shadow: 0 6px 18px rgba(34, 179, 159, 0.32);
}

.ncco-industrial-benefits__button-text {
  color: #FFFFFF;
  white-space: nowrap;
}

.ncco-industrial-benefits__button-icon {
  width: 28px;
  height: 28px;
  min-width: 28px;
  border-radius: 50%;
  background-color: #FFFFFF;
  color: #22B39F;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.ncco-industrial-benefits__button:hover .ncco-industrial-benefits__button-icon {
  transform: scale(1.05);
}

.ncco-industrial-benefits__button-icon svg {
  display: block;
}

.ncco-industrial-benefits__description {
  flex: 0 1 440px;
  max-width: 440px;
  margin-top: 48px;
  font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 14px;
  line-height: 1.75;
  font-weight: 400;
  color: #63778B;
  box-sizing: border-box;
}

.ncco-industrial-benefits__description p {
  margin: 0;
}

/* GRID OUTER & CONTAINER (FULL-WIDTH EDGE-TO-EDGE BORDER LINES) */
.ncco-industrial-benefits__grid-outer {
  width: 100%;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.ncco-industrial-benefits__grid-container {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 40px;
  position: relative;
  box-sizing: border-box;
}

.ncco-industrial-benefits__grid {
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-auto-rows: 1fr;
  gap: 0;
  width: 100%;
  box-sizing: border-box;
}

/* HORIZONTAL LINES EXTENDING EDGE-TO-EDGE */
.ncco-industrial-benefits__edge-line {
  position: absolute;
  height: 1px;
  background-color: #E8EEF1;
  pointer-events: none;
  z-index: 0;
}

.ncco-industrial-benefits__edge-line--top-left {
  top: 0;
  right: 100%;
  width: 100vw;
}

.ncco-industrial-benefits__edge-line--top-right {
  top: 0;
  left: 100%;
  width: 100vw;
}

.ncco-industrial-benefits__edge-line--mid-left {
  top: 50%;
  right: 100%;
  width: 100vw;
}

.ncco-industrial-benefits__edge-line--mid-right {
  top: 50%;
  left: 100%;
  width: 100vw;
}

.ncco-industrial-benefits__edge-line--bot-left {
  bottom: 0;
  right: 100%;
  width: 100vw;
}

.ncco-industrial-benefits__edge-line--bot-right {
  bottom: 0;
  left: 100%;
  width: 100vw;
}

/* CELLS WITH CONNECTED BORDERS & CORNER CURVES (CONCAVE DIAMONDS) */
.ncco-industrial-benefits__card {
  position: relative;
  background-color: #FFFFFF;
  border: 1px solid #E8EEF1;
  border-radius: 16px;
  margin-right: -1px;
  margin-bottom: -1px;
  min-height: 250px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 48px 32px 42px;
  text-align: center;
  box-sizing: border-box;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
  z-index: 1;
}

.ncco-industrial-benefits__card:nth-child(3n) {
  margin-right: 0;
}

.ncco-industrial-benefits__card:nth-child(n+4) {
  margin-bottom: 0;
}

.ncco-industrial-benefits__card:hover {
  border-color: #22B39F;
  z-index: 3;
  box-shadow: 0 8px 24px rgba(34, 179, 159, 0.1);
}

.ncco-industrial-benefits__icon {
  width: 38px;
  height: 38px;
  margin-bottom: 22px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #22B39F;
  flex-shrink: 0;
}

.ncco-industrial-benefits__icon svg {
  display: block;
  width: 38px;
  height: 38px;
}

.ncco-industrial-benefits__title {
  margin: 0 0 10px 0;
  font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 15px;
  line-height: 1.35;
  font-weight: 600;
  letter-spacing: 0.5px;
  color: #0A1C2E;
  text-transform: uppercase;
  text-align: center;
}

.ncco-industrial-benefits__text {
  max-width: 320px;
  font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 13.5px;
  line-height: 1.65;
  font-weight: 400;
  color: #63778B;
  text-align: center;
  margin: 0 auto;
}

.ncco-industrial-benefits__text p {
  margin: 0;
}

/* RESPONSIVE */
@media (max-width: 992px) {
  .ncco-industrial-benefits {
    padding: 64px 0 0 !important;
    margin-bottom: 0 !important;
  }

  .ncco-industrial-benefits__container,
  .ncco-industrial-benefits__grid-container {
    padding: 0 32px;
  }

  .ncco-industrial-benefits__intro {
    flex-direction: column;
    gap: 28px;
    margin-bottom: 40px;
  }

  .ncco-industrial-benefits__intro-left {
    max-width: 100%;
  }

  .ncco-industrial-benefits__description {
    max-width: 100%;
    margin-top: 0;
  }

  .ncco-industrial-benefits__grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .ncco-industrial-benefits__card:nth-child(3n) {
    margin-right: -1px;
  }

  .ncco-industrial-benefits__card:nth-child(2n) {
    margin-right: 0;
  }

  .ncco-industrial-benefits__card:nth-child(n+4) {
    margin-bottom: -1px;
  }

  .ncco-industrial-benefits__card:nth-child(n+5) {
    margin-bottom: 0;
  }

  .ncco-industrial-benefits__edge-line--mid-left,
  .ncco-industrial-benefits__edge-line--mid-right {
    display: none;
  }
}

@media (max-width: 640px) {
  .ncco-industrial-benefits {
    padding: 48px 0 0 !important;
    margin-bottom: 0 !important;
  }

  .ncco-industrial-benefits__container,
  .ncco-industrial-benefits__grid-container {
    padding: 0 20px;
  }

  .ncco-industrial-benefits__heading {
    font-size: 28px;
    line-height: 1.25;
    margin-bottom: 20px;
  }

  .ncco-industrial-benefits__grid {
    grid-template-columns: 1fr;
  }

  .ncco-industrial-benefits__card {
    min-height: auto;
    padding: 32px 20px 28px;
    margin-right: 0 !important;
    margin-bottom: -1px !important;
  }

  .ncco-industrial-benefits__card:last-child {
    margin-bottom: 0 !important;
  }

  .ncco-industrial-benefits__edge-line {
    display: none;
  }
}
</style>

