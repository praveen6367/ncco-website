{%- assign fsplit_bg = section.settings.bg_color | default: '' -%}
{%- assign fsplit_accent = section.settings.accent_color | default: '#FECB07' -%}
<section class="ncco-fsplit ncco-section{% if section.settings.dark %} ncco-section--dark{% endif %}{% if section.settings.numbered %} ncco-fsplit--numbered{% endif %}"{% if fsplit_bg != '' %} style="background:{{ fsplit_bg }};--ncco-accent:{{ fsplit_accent }}"{% else %} style="--ncco-accent:{{ fsplit_accent }}"{% endif %}>
  <div class="ncco-fsplit__inner">
    <div class="ncco-fsplit__text ncco-reveal">
      <div class="ncco-fsplit__text-top">
        {% if section.settings.eyebrow != blank %}
          <p class="ncco-eyebrow{% if section.settings.dark %} ncco-eyebrow--on-dark{% endif %}">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="ncco-fsplit__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.body != blank %}
          <div class="ncco-fsplit__body">{{ section.settings.body }}</div>
        {% endif %}
      </div>
      {%- if section.settings.cta_label != blank -%}
        {%- render 'ncco-cta', label: section.settings.cta_label, url: section.settings.cta_url, variant: section.settings.cta_variant, class: 'ncco-fsplit__cta' -%}
      {%- endif -%}
    </div>
    <div class="ncco-fsplit__grid">
      {% for block in section.blocks %}
        <div class="ncco-fsplit__card ncco-reveal ncco-reveal--d{{ forloop.index }}" {{ block.shopify_attributes }}>
          {% if section.settings.numbered %}
            <span class="ncco-fsplit__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
          {% elsif block.settings.icon_asset != blank %}
            <img class="ncco-fsplit__icon" src="{{ block.settings.icon_asset | asset_url }}"
                 alt="{{ block.settings.title }}" width="40" height="40" loading="lazy">
          {% endif %}
          {% if block.settings.title != blank %}
            <h3 class="ncco-fsplit__card-title{% if section.settings.numbered %} ncco-fsplit__card-title--upper{% endif %}">{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.body != blank %}
            <p class="ncco-fsplit__card-body">{{ block.settings.body }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.ncco-fsplit { padding: 100px 240px; }
.ncco-fsplit__inner {
  display: grid;
  grid-template-columns: 2fr 3fr;
  gap: 80px;
  align-items: stretch;
}
.ncco-fsplit__text {
  min-width: 0;
  display: flex; flex-direction: column; justify-content: space-between; gap: 40px;
}
.ncco-fsplit__text-top { display: flex; flex-direction: column; gap: 0; }
.ncco-fsplit__heading {
  font-family: 'Geist', sans-serif;
  font-size: 58px; font-weight: 500; line-height: 68px; letter-spacing: -2.32px;
  color: #081D3A; margin: 0 0 24px;
}
.ncco-section--dark .ncco-fsplit__heading { color: #fff; }
.ncco-fsplit__body {
  font-family: 'Geist', sans-serif;
  font-size: 18px; font-weight: 400; line-height: 28px; letter-spacing: -0.36px;
  color: #647082;
}
.ncco-section--dark .ncco-fsplit__body { color: #97A0AC; }
.ncco-fsplit__body p { margin: 0 0 16px; }
.ncco-fsplit__body p:last-child { margin-bottom: 0; }
.ncco-fsplit .ncco-eyebrow { margin-bottom: 40px; }

.ncco-fsplit__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
  min-width: 0;
  align-content: start;
}
/* Numbered mode: column-first flow so 01,02 fill left col, 03,04 fill right col */
.ncco-fsplit--numbered .ncco-fsplit__grid {
  grid-auto-flow: column;
  grid-template-rows: repeat(2, auto);
  align-items: start;
}
.ncco-fsplit__card {
  padding: 32px;
  border-radius: 24px;
  background: #fff;
  border: 1px solid rgba(100,112,130,0.12);
  box-shadow: 0 8px 16px rgba(8,29,58,0.04);
  display: flex; flex-direction: column; gap: 12px;
}

.ncco-section--dark .ncco-fsplit__card {
  background: rgba(255,255,255,0.08);
  border-color: rgba(255,255,255,0.08);
  box-shadow: none;
}
.ncco-fsplit__icon { width: 40px; height: 40px; object-fit: contain; }
.ncco-fsplit__num {
  font-family: 'Geist', sans-serif;
  font-size: 13px; font-weight: 400; color: rgba(8,29,58,0.25);
  letter-spacing: -0.26px; display: block;
}
.ncco-fsplit__card-title {
  font-family: 'Geist', sans-serif;
  font-size: 16px; font-weight: 500; line-height: 1.3; letter-spacing: -0.32px;
  color: #081D3A; margin: 0;
}
.ncco-fsplit__card-title--upper { text-transform: uppercase; font-weight: 600; letter-spacing: 0.2px; }
.ncco-section--dark .ncco-fsplit__card-title { color: #fff; }
.ncco-fsplit__card-body {
  font-family: 'Geist', sans-serif;
  font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: -0.28px;
  color: #647082; margin: 0;
}
.ncco-section--dark .ncco-fsplit__card-body { color: #97A0AC; }

/* CTA at bottom of left column — must not stretch to full column width */
.ncco-fsplit__cta { display: inline-flex; align-self: flex-start; }

/* Eyebrow bar inherits section accent color */
.ncco-fsplit .ncco-eyebrow::before { background: var(--ncco-accent, var(--ncco-yellow)); }

@media (max-width: 1600px) { .ncco-fsplit { padding: 80px 80px; } .ncco-fsplit__inner { gap: 60px; } }
@media (max-width: 1280px) {
  .ncco-fsplit__inner { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 1024px) {
  .ncco-fsplit { padding: 60px 40px; }
  .ncco-fsplit__inner { grid-template-columns: 1fr; gap: 48px; align-items: start; }
  .ncco-fsplit__text { justify-content: flex-start; }
  .ncco-fsplit__heading { font-size: 40px; line-height: 48px; letter-spacing: -1.5px; }
}
@media (max-width: 989px) {
  .ncco-fsplit { padding: 48px 24px; }
  .ncco-fsplit__heading { font-size: 34px; line-height: 42px; letter-spacing: -1.2px; }
}
@media (max-width: 600px) {
  .ncco-fsplit { padding: 40px 16px; }

  /* Center text block */
  .ncco-fsplit__text { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .ncco-fsplit .ncco-eyebrow { align-items: center; text-align: center; margin-bottom: 24px; }
  .ncco-fsplit__heading { font-size: 28px; line-height: 36px; letter-spacing: -0.8px; text-align: center; }
  .ncco-fsplit__body { text-align: center; font-size: 15px; }

  /* 1-col cards — restore grid flow */
  .ncco-fsplit__grid { grid-template-columns: 1fr; grid-template-rows: none; grid-auto-flow: row; gap: 12px; }
  .ncco-fsplit__card { padding: 20px; border-radius: 16px; }

  /* Full-width CTA */
  .ncco-fsplit__cta { width: 100% !important; margin-top: 24px; }
  .ncco-fsplit .ncco-cta { width: 100%; justify-content: space-between; }
}
</style>

{% schema %}
{
  "name": "NCCO Feature Split",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "richtext", "id": "body", "label": "Body text"},
    {"type": "checkbox", "id": "dark", "label": "Dark background", "default": false},
    {"type": "checkbox", "id": "numbered", "label": "Numbered cards (auto 01, 02…)", "default": false},
    {"type": "text", "id": "bg_color", "label": "Background color (hex, leave blank for white)"},
    {"type": "text", "id": "accent_color", "label": "Accent color (hex, default #FECB07 yellow)"},
    {"type": "text", "id": "cta_label", "label": "CTA button text"},
    {"type": "url", "id": "cta_url", "label": "CTA URL"},
    {"type": "select", "id": "cta_variant", "label": "CTA style", "options": [{"value": "yellow", "label": "Yellow"}, {"value": "blue", "label": "Blue"}, {"value": "teal", "label": "Teal"}], "default": "yellow"}
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {"type": "text", "id": "icon_asset", "label": "Icon asset filename"},
        {"type": "text", "id": "title", "label": "Title"},
        {"type": "text", "id": "body", "label": "Description"}
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{"name": "NCCO Feature Split"}]
}
{% endschema %}
