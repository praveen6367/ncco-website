{%- assign fsplit_bg = section.settings.bg_color | default: '' -%}
{%- assign fsplit_accent = section.settings.accent_color | default: '#FECB07' -%}
<section class="ncco-fsplit-wrap"{% if fsplit_bg != '' %} style="--fsplit-bg:{{ fsplit_bg }};"{% endif %}>
  <div class="ncco-fsplit">
    <div class="ncco-fsplit__inner">
      <div class="ncco-fsplit__text">
        <div class="ncco-eyebrow-dash"></div>
        {% if section.settings.eyebrow != blank %}
          <p class="ncco-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="ncco-fsplit__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.body != blank %}
          <div class="ncco-fsplit__body">{{ section.settings.body }}</div>
        {% endif %}
      </div>
      <div class="ncco-fsplit__grid">
        {% for block in section.blocks %}
          <div class="ncco-fsplit__card" {{ block.shopify_attributes }}>
            {% if block.settings.icon_asset != blank %}
              <img class="ncco-fsplit__icon" src="{{ block.settings.icon_asset | asset_url }}"
                   alt="{{ block.settings.title }}" loading="lazy">
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="ncco-fsplit__card-title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.body != blank %}
              <p class="ncco-fsplit__card-body">{{ block.settings.body }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
.ncco-fsplit-wrap {
  width: 100%;
  max-width: 1360px;
  margin: 36px auto;
  padding: 0 16px;
  box-sizing: border-box;
}

.ncco-fsplit {
  background: var(--fsplit-bg, #6470820A);
  border-radius: 28px;
  padding: 64px 60px;
  box-sizing: border-box;
}

.ncco-fsplit__inner {
  display: grid;
  grid-template-columns: 1fr 1.08fr;
  gap: 60px;
  align-items: center;
}

.ncco-fsplit__text {
  align-self: center;
}

.ncco-eyebrow-dash {
  width: 32px;
  height: 3px;
  background: #FECB07;
  border-radius: 2px;
  margin-bottom: 12px;
}

.ncco-fsplit__text .ncco-eyebrow {
  font-family: 'Geist', sans-serif;
  font-size: 13px;
  font-weight: 600;
  color: #647082;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin: 0 0 12px;
}

.ncco-fsplit__heading {
  font-family: 'Geist', sans-serif;
  font-size: 42px;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -1.2px;
  color: #081D3A;
  margin: 0 0 16px;
}

.ncco-fsplit__body {
  font-family: 'Geist', sans-serif;
  font-size: 14.5px;
  font-weight: 400;
  line-height: 1.7;
  color: #647082;
}

.ncco-fsplit__body p:first-child {
  font-size: 15px;
  color: #647082;
  margin-bottom: 24px;
  line-height: 1.5;
}

.ncco-fsplit__body p {
  margin: 0 0 18px;
  line-height: 1.7;
}

.ncco-fsplit__body p:last-child {
  margin-bottom: 0;
}

.ncco-fsplit__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  align-items: start;
  padding-bottom: 44px;
}

/* Zig-zag: First column (cards 1 & 3) shifted down, second column (cards 2 & 4) higher up */
.ncco-fsplit__card:nth-child(odd) {
  transform: translateY(44px);
}

/* Exact requested card CSS */
.ncco-fsplit__card {
  padding: 32px 28px;
  border-radius: 20px;
  background: #FFFFFF;
  border: 1px solid #6470821F;
  box-shadow: 0px 16px 48px 0px #081D3A0A;
  display: flex;
  flex-direction: column;
  gap: 12px;
  box-sizing: border-box;
  transition: box-shadow 0.2s ease;
}

.ncco-fsplit__card:hover {
  box-shadow: 0px 20px 52px 0px rgba(8, 29, 58, 0.08);
}

.ncco-fsplit__icon {
  height: 52px;
  width: auto;
  max-width: 60px;
  object-fit: contain;
  display: block;
  margin-bottom: 4px;
}

.ncco-fsplit__card-title {
  font-family: 'Geist', sans-serif;
  font-size: 15px;
  font-weight: 700;
  color: #081D3A;
  text-transform: uppercase;
  letter-spacing: 0.3px;
  margin: 0;
  line-height: 1.25;
}

.ncco-fsplit__card-body {
  font-family: 'Geist', sans-serif;
  font-size: 13px;
  font-weight: 400;
  color: #647082;
  line-height: 1.55;
  margin: 0;
}

@media (max-width: 1024px) {
  .ncco-fsplit { padding: 48px 36px; }
  .ncco-fsplit__inner { grid-template-columns: 1fr; gap: 40px; }
  .ncco-fsplit__text { align-self: auto; }
  .ncco-fsplit__heading { font-size: 34px; line-height: 42px; }
}

@media (max-width: 768px) {
  .ncco-fsplit-wrap { padding: 0 12px; margin: 24px auto; }
  .ncco-fsplit { padding: 36px 20px; border-radius: 20px; }
  .ncco-fsplit__grid { grid-template-columns: 1fr; gap: 16px; padding-bottom: 0; }
  .ncco-fsplit__card:nth-child(odd) { transform: none; }
  .ncco-fsplit__card { padding: 24px 20px; }
  .ncco-fsplit__heading { font-size: 28px; line-height: 34px; letter-spacing: -0.8px; }
}
</style>

{% schema %}
{
  "name": "NCCO Feature Split",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "richtext", "id": "body", "label": "Body text"},
    {"type": "checkbox", "id": "dark", "label": "Dark background", "default": false},
    {"type": "checkbox", "id": "numbered", "label": "Numbered cards (auto 01, 02…)", "default": false},
    {"type": "text", "id": "bg_color", "label": "Background color (hex, leave blank for white)"},
    {"type": "text", "id": "accent_color", "label": "Accent color (hex, default #FECB07 yellow)"},
    {"type": "text", "id": "cta_label", "label": "CTA button text"},
    {"type": "url", "id": "cta_url", "label": "CTA URL"},
    {"type": "select", "id": "cta_variant", "label": "CTA style", "options": [{"value": "yellow", "label": "Yellow"}, {"value": "blue", "label": "Blue"}, {"value": "teal", "label": "Teal"}], "default": "yellow"}
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {"type": "text", "id": "icon_asset", "label": "Icon asset filename"},
        {"type": "text", "id": "title", "label": "Title"},
        {"type": "text", "id": "body", "label": "Description"}
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{"name": "NCCO Feature Split"}]
}
{% endschema %}
