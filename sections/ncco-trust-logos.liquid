<section class="ncco-trust-logos{% if section.settings.static_grid %} ncco-trust-logos--static{% endif %}">
  <div class="ncco-trust-logos__label-wrap">
    {% if section.settings.heading != blank %}
      <p class="ncco-trust-logos__label">
        {{ section.settings.heading }}
        {%- if section.settings.heading_highlight != blank -%}
          <span class="ncco-trust-logos__highlight"> {{ section.settings.heading_highlight }}</span>
        {%- endif -%}
      </p>
    {% endif %}
  </div>
  {%- if section.settings.static_grid -%}
    <div class="ncco-trust-logos__grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.logo != blank or block.settings.asset != blank or block.settings.alt != blank -%}
          <div class="ncco-trust-logos__card" {{ block.shopify_attributes }}>
            {%- if block.settings.logo != blank -%}
              <img src="{{ block.settings.logo | image_url: width: 320 }}" alt="{{ block.settings.alt | default: 'Partner logo' }}" width="180" height="64" loading="lazy">
            {%- elsif block.settings.asset != blank -%}
              <img src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.alt | default: 'Partner logo' }}" width="180" height="64" loading="lazy">
            {%- else -%}
              <span class="ncco-trust-logos__text">{{ block.settings.alt }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="ncco-trust-logos__ticker-wrap">
      {%- comment -%} Desktop single track marquee {%- endcomment -%}
      <div class="ncco-trust-logos__track ncco-trust-logos__track--desktop">
        {%- for n in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.logo != blank or block.settings.asset != blank or block.settings.alt != blank -%}
              <div class="ncco-trust-logos__card" {{ block.shopify_attributes }}>
                {%- if block.settings.logo != blank -%}
                  <img src="{{ block.settings.logo | image_url: width: 320 }}"
                       alt="{{ block.settings.alt | default: 'Partner logo' }}" width="180" height="64" loading="lazy">
                {%- elsif block.settings.asset != blank -%}
                  <img src="{{ block.settings.asset | asset_url }}"
                       alt="{{ block.settings.alt | default: 'Partner logo' }}" width="180" height="64" loading="lazy">
                {%- else -%}
                  <span class="ncco-trust-logos__text">{{ block.settings.alt }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>

      {%- comment -%} Mobile two-row marquee {%- endcomment -%}
      {%- assign half = section.blocks.size | divided_by: 2 | plus: 1 -%}
      <div class="ncco-trust-logos__mobile-rows">
        <div class="ncco-trust-logos__track ncco-trust-logos__track--row1">
          {%- for n in (1..2) -%}
            {%- for block in section.blocks limit: half -%}
              {%- if block.settings.logo != blank or block.settings.asset != blank or block.settings.alt != blank -%}
                <div class="ncco-trust-logos__card" {{ block.shopify_attributes }}>
                  {%- if block.settings.logo != blank -%}
                    <img src="{{ block.settings.logo | image_url: width: 320 }}"
                         alt="{{ block.settings.alt | default: 'Partner logo' }}" width="180" height="64" loading="lazy">
                  {%- elsif block.settings.asset != blank -%}
                    <img src="{{ block.settings.asset | asset_url }}"
                         alt="{{ block.settings.alt | default: 'Partner logo' }}" width="180" height="64" loading="lazy">
                  {%- else -%}
                    <span class="ncco-trust-logos__text">{{ block.settings.alt }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>

        <div class="ncco-trust-logos__track ncco-trust-logos__track--row2">
          {%- for n in (1..2) -%}
            {%- for block in section.blocks offset: half -%}
              {%- if block.settings.logo != blank or block.settings.asset != blank or block.settings.alt != blank -%}
                <div class="ncco-trust-logos__card" {{ block.shopify_attributes }}>
                  {%- if block.settings.logo != blank -%}
                    <img src="{{ block.settings.logo | image_url: width: 320 }}"
                         alt="{{ block.settings.alt | default: 'Partner logo' }}" width="180" height="64" loading="lazy">
                  {%- elsif block.settings.asset != blank -%}
                    <img src="{{ block.settings.asset | asset_url }}"
                         alt="{{ block.settings.alt | default: 'Partner logo' }}" width="180" height="64" loading="lazy">
                  {%- else -%}
                    <span class="ncco-trust-logos__text">{{ block.settings.alt }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

<style>
/* ── Client Trust Logos ── */
.ncco-trust-logos {
  padding: 36px 0 60px;
  background: #fff;
  overflow: hidden;
}

.ncco-trust-logos__label-wrap {
  max-width: 1360px;
  margin: 0 auto 36px;
  padding: 0 24px;
  text-align: center;
  box-sizing: border-box;
}
.ncco-trust-logos__label {
  font-family: 'Geist', sans-serif;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.4;
  color: #081D3A;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin: 0;
}
.ncco-trust-logos__highlight {
  color: #0038FF;
}

.ncco-trust-logos__ticker-wrap {
  overflow: hidden;
  position: relative;
  width: 100%;
}
.ncco-trust-logos__ticker-wrap::before,
.ncco-trust-logos__ticker-wrap::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: 180px;
  z-index: 2;
  pointer-events: none;
}
.ncco-trust-logos__ticker-wrap::before {
  left: 0;
  background: linear-gradient(to right, #fff 25%, transparent 100%);
}
.ncco-trust-logos__ticker-wrap::after {
  right: 0;
  background: linear-gradient(to left, #fff 25%, transparent 100%);
}

.ncco-trust-logos__mobile-rows {
  display: none;
}

.ncco-trust-logos__track {
  display: flex;
  align-items: center;
  gap: 60px;
  width: max-content;
  animation: ncco-marquee 55s linear infinite;
}
.ncco-trust-logos__track:hover {
  animation-play-state: paused;
}
@keyframes ncco-marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.ncco-trust-logos__card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 220px;
  height: 104px;
  background: #fff;
  border: 1px solid rgba(100, 112, 130, 0.14);
  border-radius: 16px;
  box-shadow: 0 4px 16px rgba(8, 29, 58, 0.04);
  padding: 8px 14px;
  box-sizing: border-box;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.ncco-trust-logos__card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(8, 29, 58, 0.08);
}
.ncco-trust-logos__card img {
  max-height: 80px;
  max-width: 90%;
  width: auto;
  height: auto;
  object-fit: contain;
  display: block;
  transform: scale(1.18);
  transform-origin: center center;
}
.ncco-trust-logos__text {
  font-family: 'Geist', sans-serif;
  font-size: 13px;
  font-weight: 500;
  color: #97A0AC;
  text-align: center;
}

/* Static grid mode */
.ncco-trust-logos__grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 40px;
  padding: 0 40px 36px;
  box-sizing: border-box;
}
.ncco-trust-logos--static .ncco-trust-logos__card {
  width: 220px;
  height: 104px;
  border-radius: 16px;
  border: 1px solid rgba(100, 112, 130, 0.14);
  box-shadow: 0 4px 16px rgba(8, 29, 58, 0.04);
  padding: 8px 14px;
  overflow: hidden;
}
.ncco-trust-logos--static .ncco-trust-logos__card img {
  max-height: 80px;
  max-width: 90%;
  width: auto;
  height: auto;
  object-fit: contain;
  transform: scale(1.18);
  transform-origin: center center;
}

@media (max-width: 989px) {
  .ncco-trust-logos { padding: 32px 0 44px; }
  .ncco-trust-logos__label-wrap { margin-bottom: 28px; }
  .ncco-trust-logos__label { font-size: 13px; }
  .ncco-trust-logos__track { gap: 40px; }
  .ncco-trust-logos__card { width: 180px; height: 88px; padding: 6px 10px; border-radius: 14px; }
  .ncco-trust-logos__card img { max-height: 68px; transform: scale(1.18); }
  .ncco-trust-logos__grid { padding: 0 24px 32px; gap: 24px; }
}

@media (max-width: 749px) {
  .ncco-trust-logos { padding: 30px 0 38px; }
  .ncco-trust-logos__label-wrap { padding: 0 20px; margin: 0 auto 24px; max-width: 320px; }
  .ncco-trust-logos__label { font-size: 13px; line-height: 1.4; letter-spacing: 0.03em; }
  .ncco-trust-logos__track--desktop { display: none !important; }
  .ncco-trust-logos__mobile-rows {
    display: flex !important;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    overflow: hidden;
  }
  .ncco-trust-logos__track--row1,
  .ncco-trust-logos__track--row2 {
    display: flex;
    align-items: center;
    gap: 14px;
    width: max-content;
  }
  .ncco-trust-logos__track--row1 {
    animation: ncco-marquee 32s linear infinite;
  }
  .ncco-trust-logos__track--row2 {
    animation: ncco-marquee 36s linear infinite;
  }
  .ncco-trust-logos__card {
    width: 142px;
    height: 72px;
    padding: 6px 10px;
    border-radius: 12px;
  }
  .ncco-trust-logos__card img {
    max-height: 54px;
    transform: scale(1.18);
  }
  .ncco-trust-logos__ticker-wrap::before,
  .ncco-trust-logos__ticker-wrap::after {
    width: 50px;
  }
  .ncco-trust-logos__grid { padding: 0 16px 28px; gap: 14px; }
}
</style>

{% schema %}
{
  "name": "NCCO Trust Logos",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading (first part)", "default": "Trusted by industry leaders for"},
    {"type": "text", "id": "heading_highlight", "label": "Heading highlight (blue)", "default": "Quality and Reliability"},
    {"type": "checkbox", "id": "static_grid", "label": "Static grid (no scrolling)", "default": false}
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {"type": "image_picker", "id": "logo", "label": "Logo image"},
        {"type": "text", "id": "asset", "label": "Asset filename (e.g. tl-MTR.webp)"},
        {"type": "text", "id": "alt", "label": "Brand name / alt text"}
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [{"name": "NCCO Trust Logos"}]
}
{% endschema %}
