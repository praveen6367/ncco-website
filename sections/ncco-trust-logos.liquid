<section class="ncco-trust-logos{% if section.settings.static_grid %} ncco-trust-logos--static{% endif %}">
  <div class="ncco-trust-logos__label-wrap">
    {% if section.settings.heading != blank %}
      <p class="ncco-trust-logos__label">
        {{ section.settings.heading }}
        {%- if section.settings.heading_highlight != blank -%}
          <span class="ncco-trust-logos__highlight"> {{ section.settings.heading_highlight }}</span>
        {%- endif -%}
      </p>
    {% endif %}
  </div>
  {%- if section.settings.static_grid -%}
    <div class="ncco-trust-logos__grid">
      {%- for block in section.blocks -%}
        <div class="ncco-trust-logos__card" {{ block.shopify_attributes }}>
          {%- if block.settings.logo != blank -%}
            <img src="{{ block.settings.logo | image_url: width: 320 }}" alt="{{ block.settings.alt | default: 'Partner logo' }}" loading="lazy">
          {%- elsif block.settings.asset != blank -%}
            <img src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.alt | default: 'Partner logo' }}" loading="lazy">
          {%- else -%}
            <span class="ncco-trust-logos__text">{{ block.settings.alt }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="ncco-trust-logos__ticker-wrap">
      <div class="ncco-trust-logos__track">
        {%- comment -%} Duplicate blocks twice for seamless infinite loop {%- endcomment -%}
        {%- for n in (1..2) -%}
          {%- for block in section.blocks -%}
            <div class="ncco-trust-logos__card" {{ block.shopify_attributes }}>
              {%- if block.settings.logo != blank -%}
                <img src="{{ block.settings.logo | image_url: width: 320 }}"
                     alt="{{ block.settings.alt | default: 'Partner logo' }}" loading="lazy">
              {%- elsif block.settings.asset != blank -%}
                <img src="{{ block.settings.asset | asset_url }}"
                     alt="{{ block.settings.alt | default: 'Partner logo' }}" loading="lazy">
              {%- else -%}
                <span class="ncco-trust-logos__text">{{ block.settings.alt }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

<style>
/* ── Figma Trust Logos (node 1423:25063) ── */
.ncco-trust-logos { padding: 120px 0 80px; background: #fff; overflow: hidden; }

.ncco-trust-logos__label-wrap {
  max-width: 1920px; margin: 0 auto 38px; padding: 0 240px;
  text-align: center; box-sizing: border-box;
}
.ncco-trust-logos__label {
  font-family: 'Geist', sans-serif;
  font-size: 18px; font-weight: 500; line-height: 1.4;
  color: #081D3A; text-transform: uppercase; letter-spacing: -0.02em; margin: 0;
}
.ncco-trust-logos__highlight { color: #003DA5; }

.ncco-trust-logos__ticker-wrap { overflow: hidden; position: relative; }
.ncco-trust-logos__ticker-wrap::before,
.ncco-trust-logos__ticker-wrap::after {
  content: ''; position: absolute; top: 0; bottom: 0; width: 253px; z-index: 2; pointer-events: none;
}
.ncco-trust-logos__ticker-wrap::before { left: 0;  background: linear-gradient(to right, #fff 35%, transparent 100%); }
.ncco-trust-logos__ticker-wrap::after  { right: 0; background: linear-gradient(to left,  #fff 35%, transparent 100%); }

.ncco-trust-logos__track {
  display: flex; align-items: center; gap: 48px; width: max-content;
  animation: ncco-marquee 65s linear infinite;
}
.ncco-trust-logos__track:hover { animation-play-state: paused; }
@keyframes ncco-marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

.ncco-trust-logos__card {
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  width: 200px; height: 100px;
  background: #fff; border: 1px solid rgba(100,112,130,0.12);
  border-radius: 10px; box-shadow: 0 16px 48px rgba(8,29,58,0.04);
  padding: 20px; box-sizing: border-box;
}
.ncco-trust-logos__card img {
  max-height: 60px; max-width: 100%; width: auto; object-fit: contain;
}
.ncco-trust-logos__text {
  font-family: 'Geist', sans-serif; font-size: 13px; font-weight: 500; color: #97A0AC;
}

/* Static grid mode */
.ncco-trust-logos__grid {
  display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
  gap: 24px; padding: 0 120px 60px; box-sizing: border-box;
}
.ncco-trust-logos--static .ncco-trust-logos__card {
  width: 280px; height: 120px; border-radius: 16px;
  border: 1px solid rgba(100,112,130,0.15);
  box-shadow: 0 4px 24px rgba(8,29,58,0.06);
  padding: 24px 32px;
}
.ncco-trust-logos--static .ncco-trust-logos__card img { max-height: 72px; max-width: 100%; width: auto; object-fit: contain; }

@media (max-width: 1440px) { .ncco-trust-logos__label-wrap { padding: 0 80px; } .ncco-trust-logos__grid { padding: 0 80px 60px; } }
@media (max-width: 989px) {
  .ncco-trust-logos { padding: 60px 0 48px; }
  .ncco-trust-logos__label-wrap { padding: 0 24px; margin-bottom: 28px; }
  .ncco-trust-logos__label { font-size: 15px; }
  .ncco-trust-logos__grid { padding: 0 40px 48px; }
}
@media (max-width: 600px) {
  .ncco-trust-logos { padding: 48px 0 40px; }
  .ncco-trust-logos__label-wrap { padding: 0 16px; margin-bottom: 20px; }
  .ncco-trust-logos__label { font-size: 13px; }
  /* Figma mobile: ticker becomes a static 4-per-row wrap grid */
  .ncco-trust-logos__ticker-wrap { overflow: hidden; }
  .ncco-trust-logos__ticker-wrap::before,
  .ncco-trust-logos__ticker-wrap::after { display: none; }
  .ncco-trust-logos__track {
    animation: none;
    transform: none !important;
    width: auto;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    padding: 0 16px;
    /* 2 rows × 56px + 1 gap × 12px = 124px — hides duplicated ticker items */
    max-height: 124px;
    overflow: hidden;
    align-content: flex-start;
  }
  .ncco-trust-logos__card { width: calc(25% - 9px); min-width: 60px; height: 56px; padding: 10px 8px; flex-shrink: 0; }
  .ncco-trust-logos__card img { max-height: 32px; }
  /* Static grid mobile */
  .ncco-trust-logos__grid { padding: 0 16px 40px; gap: 12px; }
  .ncco-trust-logos--static .ncco-trust-logos__card { width: calc(25% - 9px); min-width: 60px; height: 56px; }
}
</style>

{% schema %}
{
  "name": "NCCO Trust Logos",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading (first part)", "default": "Trusted by industry leaders for"},
    {"type": "text", "id": "heading_highlight", "label": "Heading highlight (blue)", "default": "Quality and Reliability"},
    {"type": "checkbox", "id": "static_grid", "label": "Static grid (no scrolling)", "default": false}
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {"type": "image_picker", "id": "logo", "label": "Logo image"},
        {"type": "text", "id": "asset", "label": "Asset filename (e.g. tl-MTR.webp)"},
        {"type": "text", "id": "alt", "label": "Brand name / alt text"}
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [{"name": "NCCO Trust Logos"}]
}
{% endschema %}
