{%- assign ig_bg_asset = section.settings.bg_asset -%}
{%- assign ig_accent = section.settings.accent_color | default: '#FECB07' -%}
<section class="ncco-icon-grid-wrap{% unless section.settings.dark %} ncco-icon-grid-wrap--light{% endunless %}{% if section.settings.flat %} ncco-icon-grid-wrap--flat{% endif %}{% if section.settings.hero_card %} ncco-icon-grid-wrap--hero{% endif %}{% if section.settings.dark and section.settings.table_grid %} ncco-icon-grid-wrap--card{% endif %}" style="--ncco-accent:{{ ig_accent }}">
  <div class="ncco-icon-grid ncco-section{% if section.settings.dark %} ncco-section--dark{% endif %}{% if section.settings.align == 'left' %} ncco-icon-grid--left{% endif %}{% if section.settings.numbered %} ncco-icon-grid--numbered{% endif %}{% if section.settings.table_grid %} ncco-icon-grid--table{% endif %}"{% if ig_bg_asset != blank %} style="background-image:url('{{ ig_bg_asset | asset_url }}');background-size:cover;background-position:center;"{% endif %}>
  <div class="ncco-container">
    {% if section.settings.split_header %}
      <div class="ncco-icon-grid__header-split ncco-reveal">
        <div class="ncco-icon-grid__hs-left">
          {% if section.settings.eyebrow != blank %}
            <div class="ncco-icon-grid__eyebrow-wrap">
              <p class="ncco-icon-grid__eyebrow-text">{{ section.settings.eyebrow }}</p>
            </div>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="ncco-icon-grid__heading">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.cta_label != blank %}
            {%- render 'ncco-cta', label: section.settings.cta_label, url: section.settings.cta_url, variant: section.settings.cta_variant -%}
          {% endif %}
        </div>
        <div class="ncco-icon-grid__hs-right">
          {% if section.settings.subtext != blank %}
            <p class="ncco-icon-grid__sub">{{ section.settings.subtext }}</p>
          {% endif %}
        </div>
      </div>
    {% else %}
      {% if section.settings.eyebrow != blank %}
        <div class="ncco-icon-grid__eyebrow-wrap ncco-reveal">
          <p class="ncco-icon-grid__eyebrow-text">{{ section.settings.eyebrow }}</p>
        </div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="ncco-icon-grid__heading ncco-reveal">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subtext != blank %}
        <p class="ncco-icon-grid__sub ncco-reveal">{{ section.settings.subtext }}</p>
      {% endif %}
    {% endif %}
    <div class="ncco-icon-grid__grid ncco-icon-grid__grid--{{ section.settings.columns }}">
      {% for block in section.blocks %}
        <div class="ncco-icon-grid__card{% if block.settings.featured %} ncco-icon-grid__card--featured{% endif %} ncco-reveal ncco-reveal--d{{ forloop.index }}" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank or block.settings.icon_emoji != blank or block.settings.icon_asset != blank %}
            <div class="ncco-icon-grid__icon-wrap">
              {% if block.settings.icon_asset != blank %}
                <img src="{{ block.settings.icon_asset | asset_url }}"
                     alt="{{ block.settings.title }}" width="58" height="58" loading="lazy">
              {% elsif block.settings.icon != blank %}
                <img src="{{ block.settings.icon | image_url: width: 80 }}"
                     alt="{{ block.settings.title }}" width="48" height="48" loading="lazy">
              {% else %}
                <span class="ncco-icon-grid__icon-emoji">{{ block.settings.icon_emoji }}</span>
              {% endif %}
            </div>
          {% endif %}
          {% if block.settings.eyebrow != blank or block.settings.title != blank or block.settings.body != blank %}
            <div class="ncco-icon-grid__card-inner-text">
              {% if block.settings.eyebrow != blank %}
                <p class="ncco-icon-grid__card-eyebrow">{{ block.settings.eyebrow }}</p>
              {% endif %}
              {% if block.settings.title != blank %}
                <h3 class="ncco-icon-grid__card-title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.body != blank %}
                <div class="ncco-icon-grid__card-body">{{ block.settings.body }}</div>
              {% endif %}
            </div>
          {% endif %}
          {% if block.settings.link_label != blank %}
            <a href="{{ block.settings.link_url | default: '#' }}" class="ncco-icon-grid__card-link">
              {{ block.settings.link_label }}
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 13L13 3M13 3H6M13 3V10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    {% unless section.settings.split_header %}
      {% if section.settings.cta_label != blank %}
        <div class="ncco-icon-grid__cta-wrap">
          {%- render 'ncco-cta', label: section.settings.cta_label, url: section.settings.cta_url, variant: section.settings.cta_variant -%}
        </div>
      {% endif %}
    {% endunless %}
  </div>
  </div>
</section>

<style>
/* ── Figma Why Choose NCCO (1423:25141, 1920×1134) ── */
.ncco-icon-grid-wrap { padding: 0 16px; background: #fff; }

/* Hero card variant — rounded card, 16px side gutter (mirrors ncco-hero) */
.ncco-icon-grid-wrap--hero { padding: 0 16px; background: transparent; }
.ncco-icon-grid-wrap--hero .ncco-icon-grid {
  border-radius: 32px; overflow: hidden;
  max-width: 100%; margin: 0;
  position: relative;
}
.ncco-icon-grid-wrap--hero .ncco-icon-grid::before {
  content: '';
  position: absolute; inset: 0; z-index: 0;
  background: linear-gradient(180deg, rgba(4,14,30,0.72) 0%, rgba(4,14,30,0.82) 100%);
  pointer-events: none;
}
.ncco-icon-grid-wrap--hero .ncco-container { position: relative; z-index: 1; }
.ncco-icon-grid {
  border-radius: 32px;
  padding: 120px 224px;
  max-width: 1888px; margin: 0 auto;
  box-sizing: border-box;
}
.ncco-icon-grid-wrap--light .ncco-icon-grid { border-radius: 32px; padding: 120px 224px; }

/* Flat variant — no gutter, no rounded card, light gray bg */
.ncco-icon-grid-wrap--flat { padding: 0; background: #F4F6FA; }
.ncco-icon-grid-wrap--flat .ncco-icon-grid { border-radius: 0; padding: 100px 240px; max-width: 100%; }

/* ncco-container inside icon-grid already gets section padding — zero out its own */
.ncco-icon-grid .ncco-container { max-width: 100%; padding: 0; }

.ncco-icon-grid__eyebrow-wrap {
  display: flex; flex-direction: column; align-items: center; gap: 8px; margin-bottom: 40px;
}
.ncco-icon-grid__eyebrow-wrap::before {
  content: ''; width: 28px; height: 2px; background: var(--ncco-accent, #FECB07);
}
.ncco-icon-grid__eyebrow-text {
  font-family: 'Geist', sans-serif;
  font-size: 16px; font-weight: 500; letter-spacing: -0.32px;
  color: #647082; text-transform: uppercase; margin: 0;
}
.ncco-section--dark .ncco-icon-grid__eyebrow-text { color: #fff; }

/* Left-align variant */
.ncco-icon-grid--left .ncco-icon-grid__eyebrow-wrap { align-items: flex-start; }
.ncco-icon-grid--left .ncco-icon-grid__heading { text-align: left; }
.ncco-icon-grid--left .ncco-icon-grid__sub { text-align: left; margin-left: 0; margin-right: 0; max-width: 900px; }

.ncco-icon-grid__heading {
  text-align: center;
  font-family: 'Geist', sans-serif;
  font-size: 58px; font-weight: 500; line-height: 68px; letter-spacing: -2.32px;
  color: #081D3A; margin: 0 0 35px;
}
.ncco-section--dark .ncco-icon-grid__heading { color: #fff; }
.ncco-icon-grid__sub {
  text-align: center; max-width: 700px; margin: 0 auto 70px;
  font-family: 'Geist', sans-serif;
  font-size: 18px; font-weight: 400; line-height: 24px; letter-spacing: -0.36px;
  color: #647082;
}
.ncco-section--dark .ncco-icon-grid__sub { color: #97A0AC; }

/* Numbered cards */
.ncco-icon-grid--numbered .ncco-icon-grid__grid { counter-reset: card-num; }
.ncco-icon-grid--numbered .ncco-icon-grid__card { position: relative; counter-increment: card-num; }
.ncco-icon-grid--numbered .ncco-icon-grid__card::after {
  content: counter(card-num, decimal-leading-zero);
  position: absolute; top: 28px; right: 28px;
  font-family: 'Geist', sans-serif; font-size: 32px; font-weight: 500;
  color: rgba(8,29,58,0.08); line-height: 1; pointer-events: none;
}

.ncco-icon-grid__grid {
  display: grid; gap: 30px;
  grid-template-columns: repeat(3, 1fr);
}
.ncco-icon-grid__grid--2 { grid-template-columns: repeat(2, 1fr); }
.ncco-icon-grid__grid--4 { grid-template-columns: repeat(4, 1fr); }

/* Base card = variant A (dark translucent on dark bg) */
.ncco-icon-grid__card {
  padding: 38px;
  border-radius: 28px;
  display: flex; flex-direction: column; gap: 26px;
  background: #fff;
  border: 1px solid rgba(100,112,130,0.12);
  box-shadow: 0 16px 24px rgba(8,29,58,0.04);
  transition: transform .28s ease, box-shadow .28s ease;
}
.ncco-icon-grid__card:hover { transform: translateY(-4px); box-shadow: 0 16px 32px rgba(8,29,58,0.08); }

/* On dark section: base = translucent white, featured = solid white */
.ncco-section--dark .ncco-icon-grid__card {
  background: rgba(255,255,255,0.12);
  border-color: rgba(255,255,255,0.08);
  box-shadow: none;
}
.ncco-section--dark .ncco-icon-grid__card--featured {
  background: #fff;
  border-color: rgba(100,112,130,0.12);
}

.ncco-icon-grid__icon-wrap {
  width: 58px; height: 58px;
  display: flex; align-items: center; justify-content: center;
}
.ncco-icon-grid__icon-wrap img { width: 58px; height: 58px; object-fit: contain; }
.ncco-icon-grid__icon-emoji { font-size: 32px; line-height: 1; }

.ncco-icon-grid__card-inner-text {
  display: flex; flex-direction: column; gap: 16px;
}
.ncco-icon-grid__card-eyebrow {
  font-family: 'Geist', sans-serif;
  font-size: 12px; font-weight: 500; letter-spacing: 0.6px;
  color: var(--ncco-accent, #FECB07); text-transform: uppercase; margin: 0;
}

.ncco-icon-grid__card-title {
  font-family: 'Geist', sans-serif;
  font-size: 20px; font-weight: 500; line-height: 1.2; letter-spacing: -0.4px;
  color: #081D3A; text-transform: uppercase; margin: 0;
}
.ncco-section--dark .ncco-icon-grid__card-title { color: #fff; }
.ncco-section--dark .ncco-icon-grid__card--featured .ncco-icon-grid__card-title { color: #081D3A; }

.ncco-icon-grid__card-body {
  font-family: 'Geist', sans-serif;
  font-size: 16px; font-weight: 400; line-height: 24px; letter-spacing: -0.32px;
  color: #647082;
}
.ncco-icon-grid__card-body p { margin: 0; }
.ncco-section--dark .ncco-icon-grid__card-body { color: #97A0AC; }
.ncco-section--dark .ncco-icon-grid__card--featured .ncco-icon-grid__card-body { color: #647082; }

.ncco-icon-grid__cta-wrap { display: flex; justify-content: center; margin-top: 48px; }

/* Per-card link */
.ncco-icon-grid__card-link {
  display: inline-flex; align-items: center; gap: 6px; margin-top: auto; padding-top: 16px;
  font-family: 'Geist', sans-serif; font-size: 14px; font-weight: 500; letter-spacing: -0.28px;
  color: #22B39F; text-decoration: none;
}
.ncco-icon-grid__card-link:hover { text-decoration: underline; }
.ncco-icon-grid__card { display: flex; flex-direction: column; }

/* Table grid variant — no rounded cards, 1px dividers via grid gap trick */
.ncco-icon-grid--table .ncco-icon-grid__grid {
  gap: 1px;
  background: rgba(100,112,130,0.15);
  border: none;
  border-radius: 0;
  overflow: visible;
}
.ncco-icon-grid--table .ncco-icon-grid__card {
  border: none;
  border-radius: 0;
  box-shadow: none;
  background: #fff;
  align-items: center;
  text-align: center;
  padding: 48px 32px;
}
.ncco-icon-grid--table .ncco-icon-grid__card:hover { transform: none; box-shadow: none; }
.ncco-icon-grid--table .ncco-icon-grid__card-inner-text { align-items: center; }
.ncco-icon-grid--table .ncco-icon-grid__icon-wrap img { filter: invert(56%) sepia(68%) saturate(397%) hue-rotate(128deg) brightness(88%) contrast(85%); }
.ncco-icon-grid--table .ncco-icon-grid__icon-emoji { color: #22B39F; }

/* Dark table grid — Figma spec (1475:12220)
   Cards: 360×324, bg #0D3B59, 2px #164868 divider borders,
   38px teal accent bar centered on left+right edges of each card,
   64×64 icon-wrap with teal glow */

/* Wrap variant: rounded card layout with white side gutters */
.ncco-icon-grid-wrap--card {
  padding: 16px !important;
  background: #fff !important;
}
.ncco-icon-grid-wrap--card .ncco-icon-grid {
  border-radius: 32px !important;
  overflow: hidden;
  max-width: 100%;
  margin: 0 auto;
}
.ncco-section--dark.ncco-icon-grid--table {
  background: #0D3B59;
  padding-bottom: 0;
}
/* Constrain header content so heading wraps to 2 lines like Figma */
.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__heading {
  max-width: 720px;
  margin: 0 auto 35px;
  font-weight: 500;
  line-height: 68px;
}
.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__sub {
  max-width: 839px;
  color: #899CA8;
  margin-bottom: 70px;
}

/* Grid: no gaps, 2px #164868 borders shared between cards */
.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__grid {
  gap: 0;
  background: transparent;
  border-top: 2px solid #164868;
  border-left: 2px solid #164868;
  border-right: 2px solid #164868;
  position: relative;
}
/* Gradient fade at top of grid (from Figma) */
.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__grid::before {
  content: '';
  position: absolute;
  left: -224px; right: -224px; top: 0;
  height: 63px;
  background: linear-gradient(180deg, #0D3B59 0%, rgba(13,59,89,0.58) 50%, rgba(13,59,89,0) 100%);
  pointer-events: none;
  z-index: 5;
}

.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__card {
  background: #0D3B59;
  text-align: left;
  align-items: flex-start;
  border: none;
  border-right: 2px solid #164868;
  border-bottom: 2px solid #164868;
  border-radius: 0;
  padding: 63px 48px 40px 48px;
  gap: 38px;
  position: relative;
  min-height: 324px;
  box-sizing: border-box;
}
/* Remove double right border on last card in row */
.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__card:nth-child(4n) {
  border-right: none;
}
.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__card:hover { transform: none; box-shadow: none; }

/* Teal accent bars: 2px × 38px centered on left AND right edges */
.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__card::before,
.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__card::after {
  content: '';
  position: absolute;
  top: calc(50% - 19px);
  width: 2px;
  height: 38px;
  background: var(--ncco-accent, #53BDD8);
  z-index: 2;
}
.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__card::before { left: -2px; }
.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__card::after { right: -2px; }

.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__card-inner-text { align-items: flex-start; gap: 20px; }
.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__card-title {
  color: #fff; text-transform: uppercase;
  font-size: 20px; font-weight: 500; letter-spacing: -0.4px; margin: 0;
}
.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__card-body {
  color: rgba(255,255,255,0.58);
  font-size: 16px; font-weight: 400; line-height: 24px;
}
.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__card-body p { margin: 0; }

/* Icon-wrap: 64×64 with teal border + glow (Figma exact) */
.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__icon-wrap {
  width: 64px; height: 64px;
  background: rgba(83,189,216,0.04);
  border-radius: 16px;
  box-shadow:
    0 6px 16px -6px rgba(83,189,216,0.48),
    inset 0 0 12px rgba(83,189,216,0.12),
    inset 0 0 3px rgba(83,189,216,0.24),
    inset 0 0 0 1px #53BDD8;
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__icon-wrap img {
  width: 28px; height: 28px; object-fit: contain;
  filter: drop-shadow(0 0 6px rgba(83,189,216,0.5));
}
.ncco-section--dark.ncco-icon-grid--table .ncco-icon-grid__icon-emoji { font-size: 24px; }

/* Split header: heading+CTA left / subtext right */
.ncco-icon-grid__header-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
  margin-bottom: 60px;
}
.ncco-icon-grid__hs-left {
  display: flex; flex-direction: column; align-items: flex-start; gap: 32px;
}
.ncco-icon-grid__hs-left .ncco-icon-grid__eyebrow-wrap { align-items: flex-start; margin-bottom: 0; }
.ncco-icon-grid__hs-left .ncco-icon-grid__heading { text-align: left; margin: 0; }
.ncco-icon-grid__hs-right .ncco-icon-grid__sub { text-align: left; margin: 0; max-width: none; }

@media (max-width: 1600px) {
  .ncco-icon-grid { padding: 100px 80px; }
  .ncco-icon-grid-wrap--flat .ncco-icon-grid { padding: 100px 120px; }
  .ncco-icon-grid__header-split { gap: 48px; }
}
@media (max-width: 1400px) {
  /* 4-col cards get too narrow for uppercase titles — drop to 2-col */
  .ncco-icon-grid__grid--4 { grid-template-columns: repeat(2, 1fr); }
  .ncco-icon-grid-wrap--flat .ncco-icon-grid { padding: 100px 80px; }
}
@media (max-width: 1200px) {
  .ncco-icon-grid { padding: 80px 40px; }
  .ncco-icon-grid-wrap--flat .ncco-icon-grid { padding: 80px 40px; }
  .ncco-icon-grid__grid { grid-template-columns: repeat(2, 1fr); }
  .ncco-icon-grid__grid--4 { grid-template-columns: repeat(2, 1fr); }
  .ncco-icon-grid__heading { font-size: 44px; line-height: 52px; letter-spacing: -1.5px; }
}
@media (max-width: 1024px) {
  .ncco-icon-grid__header-split { grid-template-columns: 1fr; gap: 24px; }
  .ncco-icon-grid__hs-right .ncco-icon-grid__sub { margin-bottom: 0; }
}
@media (max-width: 989px) {
  .ncco-icon-grid { padding: 60px 24px; border-radius: 24px; }
  .ncco-icon-grid__heading { font-size: 36px; line-height: 44px; letter-spacing: -1.2px; }
  .ncco-icon-grid__sub { font-size: 16px; margin-bottom: 48px; }
}
@media (max-width: 600px) {
  .ncco-icon-grid { padding: 40px 16px; border-radius: 20px; }
  .ncco-icon-grid__grid { grid-template-columns: 1fr; }
  .ncco-icon-grid__grid--2 { grid-template-columns: 1fr; }
  .ncco-icon-grid__grid--4 { grid-template-columns: 1fr; }
  .ncco-icon-grid__heading { font-size: 28px; line-height: 36px; letter-spacing: -0.8px; }
  .ncco-icon-grid__sub { font-size: 15px; margin-bottom: 32px; }
  .ncco-icon-grid__card { padding: 24px; }
  .ncco-icon-grid-wrap--light .ncco-icon-grid { padding: 40px 16px; border-radius: 20px; }
}
</style>

{% schema %}
{
  "name": "NCCO Icon Grid",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "textarea", "id": "subtext", "label": "Subtext"},
    {"type": "select", "id": "columns", "label": "Columns", "options": [{"value": "2", "label": "2"}, {"value": "3", "label": "3"}, {"value": "4", "label": "4"}], "default": "3"},
    {"type": "select", "id": "align", "label": "Header alignment", "options": [{"value": "center", "label": "Center"}, {"value": "left", "label": "Left"}], "default": "center"},
    {"type": "checkbox", "id": "numbered", "label": "Show card numbers (01, 02…)", "default": false},
    {"type": "checkbox", "id": "flat", "label": "Flat layout (no rounded card, gray bg)", "default": false},
    {"type": "text", "id": "cta_label", "label": "CTA label"},
    {"type": "url", "id": "cta_url", "label": "CTA URL"},
    {"type": "checkbox", "id": "dark", "label": "Dark background", "default": false},
    {"type": "checkbox", "id": "split_header", "label": "Split header (heading+CTA left, subtext right)", "default": false},
    {"type": "checkbox", "id": "table_grid", "label": "Table grid (flat cells with divider lines, centered content)", "default": false},
    {"type": "checkbox", "id": "hero_card", "label": "Hero card (rounded card with 16px gutter, for bg-image sections)", "default": false},
    {"type": "text", "id": "bg_asset", "label": "Background image asset filename (for dark sections)"},
    {"type": "text", "id": "accent_color", "label": "Accent color (hex, default #FECB07 yellow)"},
    {"type": "select", "id": "cta_variant", "label": "CTA style", "options": [{"value": "yellow", "label": "Yellow"}, {"value": "blue", "label": "Blue"}, {"value": "teal", "label": "Teal"}], "default": "yellow"}
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {"type": "image_picker", "id": "icon", "label": "Icon image (optional)"},
        {"type": "text", "id": "icon_emoji", "label": "Icon emoji (e.g. 🍃)"},
        {"type": "text", "id": "icon_asset", "label": "Icon asset filename (e.g. benefit-icon-wind.svg)"},
        {"type": "text", "id": "eyebrow", "label": "Eyebrow (optional, e.g. Vision)"},
        {"type": "text", "id": "title", "label": "Title"},
        {"type": "richtext", "id": "body", "label": "Body text"},
        {"type": "checkbox", "id": "featured", "label": "Featured card (yellow border)", "default": false},
        {"type": "text", "id": "link_label", "label": "Link text (e.g. Learn More)"},
        {"type": "url", "id": "link_url", "label": "Link URL"}
      ]
