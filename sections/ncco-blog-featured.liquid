{%- assign featured_blog = blogs[section.settings.blog] -%}
<section class="ncco-blog-featured ncco-section">
  <div class="ncco-bfeat__inner">
    <div class="ncco-bfeat__header">
      <div class="ncco-bfeat__header-left">
        {% if section.settings.eyebrow != blank %}
          <p class="ncco-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="ncco-bfeat__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
      {% if section.settings.subtext != blank %}
        <p class="ncco-bfeat__subtext">{{ section.settings.subtext }}</p>
      {% endif %}
    </div>

    <div class="ncco-bfeat__grid">
      {%- assign articles = featured_blog.articles | slice: 0, 5 -%}
      {% if articles[0] %}
        <div class="ncco-bfeat__main">
          {% if articles[0].image %}
            <a href="{{ articles[0].url }}" class="ncco-bfeat__main-img-wrap">
              <img src="{{ articles[0].image | image_url: width: 900 }}"
                   alt="{{ articles[0].title }}" loading="lazy">
              {% if articles[0].tags != blank %}
                <span class="ncco-bfeat__tag">{{ articles[0].tags | first }}</span>
              {% endif %}
            </a>
          {% endif %}
          <p class="ncco-bfeat__meta">{{ articles[0].published_at | date: '%b %d, %Y' }}</p>
          <h3 class="ncco-bfeat__main-title"><a href="{{ articles[0].url }}">{{ articles[0].title }}</a></h3>
          <p class="ncco-bfeat__excerpt">{{ articles[0].excerpt_or_content | strip_html | truncate: 140 }}</p>
          <a href="{{ articles[0].url }}" class="ncco-bfeat__read-more">Read More →</a>
        </div>

        <div class="ncco-bfeat__list">
          {% for article in articles offset: 1 %}
            <a href="{{ article.url }}" class="ncco-bfeat__list-item">
              {% if article.image %}
                <div class="ncco-bfeat__list-thumb">
                  <img src="{{ article.image | image_url: width: 160 }}" alt="{{ article.title }}" loading="lazy">
                </div>
              {% endif %}
              <div class="ncco-bfeat__list-body">
                {% if article.tags != blank %}
                  <span class="ncco-bfeat__tag ncco-bfeat__tag--inline">{{ article.tags | first }}</span>
                {% endif %}
                <p class="ncco-bfeat__meta">{{ article.published_at | date: '%b %d, %Y' }}</p>
                <h4 class="ncco-bfeat__list-title">{{ article.title }}</h4>
              </div>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
.ncco-blog-featured { padding: 80px 240px; background: #fff; }
.ncco-bfeat__inner { max-width: 100%; }
.ncco-bfeat__header {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 40px; margin-bottom: 48px;
}
.ncco-bfeat__header-left .ncco-eyebrow { margin-bottom: 8px; }
.ncco-bfeat__heading {
  font-family: 'Geist', sans-serif;
  font-size: 42px; font-weight: 600; letter-spacing: -1.5px; line-height: 1.15;
  color: #081D3A; margin: 0;
}
.ncco-bfeat__subtext {
  font-family: 'Geist', sans-serif;
  font-size: 16px; color: #647082; line-height: 1.6;
  max-width: 380px; margin: 0; text-align: right;
}
.ncco-bfeat__grid { display: grid; grid-template-columns: 3fr 2fr; gap: 48px; }
.ncco-bfeat__main-img-wrap { display: block; position: relative; margin-bottom: 20px; border-radius: 12px; overflow: hidden; }
.ncco-bfeat__main-img-wrap img { width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block; }
.ncco-bfeat__tag {
  position: absolute; top: 12px; left: 12px;
  background: #FECB07; color: #081D3A;
  font-family: 'Geist', sans-serif;
  font-size: 11px; font-weight: 600; letter-spacing: 0.5px;
  text-transform: uppercase; padding: 4px 10px; border-radius: 20px;
}
.ncco-bfeat__tag--inline {
  position: static; display: inline-block; margin-bottom: 6px;
}
.ncco-bfeat__meta { font-family: 'Geist', sans-serif; font-size: 13px; color: #97A0AC; margin: 0 0 8px; }
.ncco-bfeat__main-title { font-family: 'Geist', sans-serif; font-size: 24px; font-weight: 600; line-height: 1.3; letter-spacing: -0.5px; color: #081D3A; margin: 0 0 12px; }
.ncco-bfeat__main-title a { color: inherit; text-decoration: none; }
.ncco-bfeat__main-title a:hover { color: #003da5; }
.ncco-bfeat__excerpt { font-family: 'Geist', sans-serif; font-size: 15px; color: #647082; line-height: 1.6; margin: 0 0 16px; }
.ncco-bfeat__read-more { font-family: 'Geist', sans-serif; font-size: 14px; font-weight: 600; color: #003da5; text-decoration: none; }
.ncco-bfeat__list { display: flex; flex-direction: column; gap: 0; border-left: 1px solid rgba(8,29,58,0.08); padding-left: 40px; }
.ncco-bfeat__list-item { display: flex; gap: 16px; padding: 20px 0; border-bottom: 1px solid rgba(8,29,58,0.08); text-decoration: none; }
.ncco-bfeat__list-item:first-child { padding-top: 0; }
.ncco-bfeat__list-item:last-child { border-bottom: none; }
.ncco-bfeat__list-thumb { flex-shrink: 0; width: 80px; height: 68px; border-radius: 8px; overflow: hidden; }
.ncco-bfeat__list-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.ncco-bfeat__list-body { flex: 1; min-width: 0; }
.ncco-bfeat__list-title { font-family: 'Geist', sans-serif; font-size: 15px; font-weight: 600; color: #081D3A; line-height: 1.4; margin: 0; letter-spacing: -0.2px; }

@media (max-width: 1600px) { .ncco-blog-featured { padding: 60px 80px; } }
@media (max-width: 1024px) {
  .ncco-blog-featured { padding: 48px 40px; }
  .ncco-bfeat__grid { grid-template-columns: 1fr; }
  .ncco-bfeat__list { border-left: none; padding-left: 0; border-top: 1px solid rgba(8,29,58,0.08); padding-top: 24px; }
  .ncco-bfeat__heading { font-size: 32px; }
}
@media (max-width: 989px) {
  .ncco-blog-featured { padding: 48px 24px; }
  .ncco-bfeat__header { flex-direction: column; align-items: flex-start; gap: 16px; }
  .ncco-bfeat__subtext { text-align: left; max-width: 100%; }
  .ncco-bfeat__heading { font-size: 28px; }
  .ncco-bfeat__main-title { font-size: 20px; }
}
@media (max-width: 600px) {
  .ncco-blog-featured { padding: 40px 16px; }
  .ncco-bfeat__heading { font-size: 22px; }
  .ncco-bfeat__main-title { font-size: 18px; }
  .ncco-bfeat__excerpt { font-size: 14px; }
  .ncco-bfeat__list-thumb { width: 64px; height: 54px; }
  .ncco-bfeat__list-title { font-size: 14px; }
}
</style>

{% schema %}
{
  "name": "NCCO Blog Featured",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Popular Articles"},
    {"type": "textarea", "id": "subtext", "label": "Description (right side)"},
    {"type": "blog", "id": "blog", "label": "Blog"}
  ],
  "presets": [{"name": "NCCO Blog Featured"}]
}
{% endschema %}
