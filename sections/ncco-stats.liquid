<section class="ncco-stats ncco-section">
  <div class="ncco-container">
    {% if section.settings.heading != blank %}
      <h2 class="ncco-stats__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="ncco-stats__grid">
      {% for block in section.blocks %}
        <div class="ncco-stats__item ncco-reveal ncco-reveal--d{{ forloop.index }}" {{ block.shopify_attributes }}>
          <span class="ncco-stats__number">{{ block.settings.number }}</span>
          <span class="ncco-stats__label">{{ block.settings.label }}</span>
          {% if block.settings.sublabel != blank %}
            <span class="ncco-stats__sub">{{ block.settings.sublabel }}</span>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
/* Figma-match: bumped to match About Us stats row */
.ncco-stats { padding: 48px 240px; background: #f9f9fa; }
.ncco-stats .ncco-container { max-width: 100%; padding: 0; }
.ncco-stats__heading {
  text-align: center; margin: 0 0 48px;
  font-family: 'Geist', sans-serif;
  font-size: 58px; font-weight: 500; line-height: 68px; letter-spacing: -2.32px;
  color: #081D3A;
}
.ncco-stats__grid {
  display: grid; grid-template-columns: repeat(4, 1fr); text-align: left;
}
.ncco-stats__item {
  padding: 0 40px;
}
.ncco-stats__item:first-child { padding-left: 0; }
.ncco-stats__item:last-child { padding-right: 0; }
.ncco-stats__item + .ncco-stats__item {
  border-left: 1px solid rgba(8,29,58,0.15);
}
.ncco-stats__number {
  display: block;
  font-family: 'Geist', sans-serif;
  font-size: 64px; font-weight: 700; letter-spacing: -2.56px; line-height: 1;
  color: #081D3A; margin-bottom: 12px;
}
.ncco-stats__label {
  display: block;
  font-family: 'Geist', sans-serif;
  font-size: 16px; font-weight: 400; line-height: 22px; letter-spacing: -0.32px;
  color: #647082;
}
.ncco-stats__sub { display: block; font-size: 13px; color: #97A0AC; margin-top: 6px; }

@media (max-width: 1600px) { .ncco-stats { padding: 48px 80px; } }
@media (max-width: 1024px) { .ncco-stats { padding: 60px 40px; } .ncco-stats__number { font-size: 48px; letter-spacing: -1.5px; } .ncco-stats__heading { font-size: 40px; line-height: 48px; } }
@media (max-width: 989px) {
  .ncco-stats { padding: 48px 24px; }
  .ncco-stats__grid { grid-template-columns: repeat(2, 1fr); gap: 0; }
  .ncco-stats__item { padding: 24px 16px; }
  .ncco-stats__item:first-child { padding-left: 16px; }
  .ncco-stats__item:last-child { padding-right: 16px; }
  .ncco-stats__item + .ncco-stats__item { border-left: none; border-top: 1px solid rgba(8,29,58,0.15); }
  .ncco-stats__item:nth-child(even) { border-left: 1px solid rgba(8,29,58,0.15); border-top: none; }
  .ncco-stats__item:nth-child(n+3) { border-top: 1px solid rgba(8,29,58,0.15); }
  .ncco-stats__item:nth-child(3) { border-left: none; }
  .ncco-stats__number { font-size: 40px; }
  .ncco-stats__heading { font-size: 30px; line-height: 38px; margin-bottom: 32px; }
}
@media (max-width: 600px) {
  .ncco-stats { padding: 40px 16px; }
  .ncco-stats__item { padding: 20px 12px; }
  .ncco-stats__item:first-child { padding-left: 12px; }
  .ncco-stats__item:last-child { padding-right: 12px; }
  .ncco-stats__number { font-size: 40px; letter-spacing: -1.2px; }
  .ncco-stats__heading { font-size: 26px; line-height: 34px; }
}
</style>

{% schema %}
{
  "name": "NCCO Stats Row",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "heading", "label": "Section heading"}
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {"type": "text", "id": "number", "label": "Number / value", "default": "99%"},
        {"type": "text", "id": "label", "label": "Label"},
        {"type": "text", "id": "sublabel", "label": "Sub-label (optional)"}
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{"name": "NCCO Stats Row", "blocks": [{"type": "stat"}, {"type": "stat"}, {"type": "stat"}, {"type": "stat"}]}]
}
{% endschema %}
