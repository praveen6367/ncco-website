{%- assign bg = section.settings.background_image -%}
{%- assign bg_url = '' -%}
{%- if bg %}{% assign bg_url = bg | image_url: width: 2400 %}{% endif -%}
{%- if section.settings.background_asset != blank -%}
  {%- assign bg_url = section.settings.background_asset | asset_url -%}
{%- endif -%}

{%- assign accent = section.settings.accent_color | default: '#FECB07' -%}
{%- if accent == blank -%}{%- assign accent = '#FECB07' -%}{%- endif -%}
{%- assign height = section.settings.height | default: 440 -%}

<section class="ncco-pbanner-wrap" style="--ncco-accent:{{ accent }}">
  <div class="ncco-pbanner__bg" style="background-image: url('{{ bg_url }}'); height: {{ height }}px;">
    <div class="ncco-pbanner__overlay"></div>
    <div class="ncco-pbanner__inner">
      <div class="ncco-pbanner__stack">
        <div class="ncco-pbanner__top">
          {%- if section.settings.eyebrow != blank -%}
            <p class="ncco-pbanner__eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h1 class="ncco-pbanner__title">{{ section.settings.headline | remove: '<p>' | remove: '</p>' }}</h1>
        </div>
        {%- if section.settings.subtext != blank -%}
          <p class="ncco-pbanner__sub">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
.ncco-pbanner-wrap {
  width: 100%;
  max-width: 100%;
  margin: 10px 0 36px;
  padding: 0 16px;
  box-sizing: border-box;
  background: #fff;
}

.ncco-pbanner__bg {
  position: relative;
  width: 100%;
  border-radius: 28px;
  background-size: cover;
  background-position: center right;
  background-repeat: no-repeat;
  overflow: hidden;
}

.ncco-pbanner__overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(
    90deg,
    rgba(2, 8, 17, 0.9) 0%,
    rgba(3, 19, 44, 0.9) 37.15%,
    rgba(4, 30, 70, 0.072) 100%
  );
}

.ncco-pbanner__inner {
  position: relative;
  z-index: 1;
  height: 100%;
  max-width: 1360px;
  margin: 0 auto;
  display: flex;
  align-items: stretch;
  padding: 48px 36px;
  box-sizing: border-box;
}

.ncco-pbanner__stack {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 100%;
  max-width: 620px;
}

.ncco-pbanner__top {
  display: flex;
  flex-direction: column;
}

.ncco-pbanner__eyebrow {
  font-family: 'Geist', sans-serif;
  font-size: 15px;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
  margin: 0 0 16px;
  letter-spacing: -0.2px;
}

.ncco-pbanner__title {
  font-family: 'Geist', sans-serif;
  font-weight: 700;
  font-size: clamp(38px, 4.2vw, 56px);
  line-height: 1.15;
  letter-spacing: -1.2px;
  color: #FFFFFF;
  margin: 0;
}

.ncco-pbanner__title em,
.ncco-pbanner__title .highlight {
  font-style: normal;
  background: linear-gradient(90deg, #FECB07 0%, rgba(254, 203, 7, 0) 54.5%),
              linear-gradient(0deg, #FFFFFF, #FFFFFF);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  display: inline-block;
  padding-right: 0.1em;
  -webkit-box-decoration-break: clone;
  box-decoration-break: clone;
}

.ncco-pbanner__sub {
  font-family: 'Geist', sans-serif;
  font-weight: 400;
  font-size: 16px;
  line-height: 1.55;
  letter-spacing: -0.2px;
  color: rgba(255, 255, 255, 0.88);
  margin: 0;
  max-width: 580px;
}

@media (max-width: 1024px) {
  .ncco-pbanner__inner { padding: 40px 40px; }
  .ncco-pbanner__title { font-size: 40px; }
}
@media (max-width: 768px) {
  .ncco-pbanner-wrap { padding: 0 12px; margin: 8px auto 24px; }
  .ncco-pbanner__bg { height: auto !important; min-height: 440px; border-radius: 28px; }
  .ncco-pbanner__inner { padding: 36px 20px; }
  .ncco-pbanner__stack { gap: 36px; }
  .ncco-pbanner__title { font-size: 30px; letter-spacing: -0.8px; }
  .ncco-pbanner__sub { font-size: 14px; }
}
</style>

{% schema %}
{
  "name": "NCCO Page Banner",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow subtitle"},
    {"type": "richtext", "id": "headline", "label": "Headline (wrap accent line in <em>)"},
    {"type": "textarea", "id": "subtext", "label": "Subtext"},
    {"type": "text", "id": "accent_color", "label": "Accent color (hex, default #FECB07)"},
    {"type": "number", "id": "height", "label": "Banner height (px, default 440)"},
    {"type": "header", "content": "Background"},
    {"type": "image_picker", "id": "background_image", "label": "Background image"},
    {"type": "text", "id": "background_asset", "label": "Background asset filename (overrides image picker)"}
  ],
  "presets": [{"name": "NCCO Page Banner"}]
}
{% endschema %}
