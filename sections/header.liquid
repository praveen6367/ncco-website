      {%- elsif link.links.size > 0 -%}
        <details class="ncco-mob-nav__group">
          <summary class="ncco-mob-nav__group-btn">
            {{ link.title }}
            <svg class="ncco-mob-nav__chev" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div class="ncco-mob-nav__group-body">
            {%- for child in link.links -%}
              <a href="{{ child.url }}" class="ncco-mob-nav__child">{{ child.title }}</a>
            {%- endfor -%}
          </div>
        </details>

      {%- else -%}
        <a href="{{ link.url }}" class="ncco-mob-nav__link">{{ link.title }}</a>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="ncco-mob-nav__foot">
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_url | default: '/pages/contact-us' }}" class="ncco-mob-nav__cta">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</div>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: 'dropdown' -%}
{%- endif -%}

<style>
/* ── NCCO Custom Navbar ── */
.shopify-section-group-header-group,
.section-header {
  position: relative !important;
  top: auto !important;
}
.ncco-hdr {
  position: relative; z-index: 200;
  background: #fff;
  border-bottom: 1px solid rgba(8,29,58,0.06);
}

.ncco-hdr__inner {
  display: flex; align-items: center; justify-content: space-between;
  gap: 32px; padding: 0 240px; height: 80px;
  max-width: 1920px; margin: 0 auto; box-sizing: border-box;
}

/* Logo */
.ncco-hdr__logo { display: flex; align-items: center; flex-shrink: 0; }
.ncco-hdr__logo-img { height: 44px; width: auto; display: block; object-fit: contain; }

/* Desktop nav */
.ncco-hdr__nav { display: flex; align-items: center; gap: 8px; }
.ncco-hdr__item { position: relative; }
.ncco-hdr__link {
  display: flex; align-items: center; gap: 6px;
  font-family: 'Geist', sans-serif; font-size: 14px; font-weight: 500;
  color: #081D3A; text-decoration: none; text-transform: uppercase; letter-spacing: 0.5px;
  padding: 8px 16px; border-radius: 8px;
  white-space: nowrap; transition: color 0.15s, background 0.15s;
  background: none; border: none; cursor: pointer;
}
.ncco-hdr__link:hover, .ncco-hdr__link[aria-current="page"] { color: #003DA5; background: rgba(0,61,165,0.05); }
.ncco-hdr__chev { transition: transform 0.2s; flex-shrink: 0; }
.ncco-hdr__item--drop:hover .ncco-hdr__chev,
.ncco-hdr__item--drop .ncco-hdr__link--btn[aria-expanded="true"] .ncco-hdr__chev { transform: rotate(180deg); }

/* Base dropdown */
.ncco-hdr__dropdown {
  display: none; position: absolute; top: calc(100% + 8px); left: 50%;
  transform: translateX(-50%);
  background: #fff; border: 1px solid rgba(8,29,58,0.08);
  border-radius: 14px; box-shadow: 0 16px 48px rgba(8,29,58,0.12);
  padding: 8px; min-width: 200px; z-index: 300;
}
/* Invisible bridge fills 8px gap so hover stays active when cursor moves toward dropdown */
.ncco-hdr__item--drop::after {
  content: ''; position: absolute; top: 100%; left: 0; width: 100%; height: 8px;
}
.ncco-hdr__item--drop:hover .ncco-hdr__dropdown,
.ncco-hdr__item--drop .ncco-hdr__dropdown.is-open { display: block; }
.ncco-hdr__dropdown-item {
  display: block; padding: 10px 16px; border-radius: 8px;
  font-family: 'Geist', sans-serif; font-size: 14px; color: #647082;
  text-decoration: none; white-space: nowrap;
  transition: background 0.15s, color 0.15s;
}
.ncco-hdr__dropdown-item:hover { background: #f9f9fa; color: #003DA5; }

/* ── Our Brands mega dropdown ── */
.ncco-drop--brands { width: 600px; padding: 0; overflow: hidden; }
.ncco-drop-brands__hero {
  display: flex; align-items: center; gap: 16px;
  padding: 16px 20px;
  border-bottom: 1px solid rgba(8,29,58,0.08);
  text-decoration: none; transition: background 0.15s;
}
.ncco-drop-brands__hero:hover { background: #F4F6FA; }
.ncco-drop-brands__hero-logo {
  width: 72px; height: 44px;
  object-fit: contain; object-position: left center;
  flex-shrink: 0; display: block;
}
.ncco-drop-brands__hero-text { flex: 1; min-width: 0; }
.ncco-drop-brands__hero-name {
  font-family: 'Geist', sans-serif; font-size: 15px; font-weight: 600;
  color: #081D3A; margin: 0 0 3px;
}
.ncco-drop-brands__hero-desc {
  font-family: 'Geist', sans-serif; font-size: 13px; color: #647082; margin: 0;
}
.ncco-drop-brands__hero-arr { display: none; }
