}
.ncco-hdr__hamburger span { display: block; width: 18px; height: 2px; background: #fff; border-radius: 2px; transition: transform 0.25s, opacity 0.25s; }
.ncco-hdr__hamburger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.ncco-hdr__hamburger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
.ncco-hdr__hamburger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* ── Mobile Nav Overlay ── */
.ncco-mob-nav {
  position: fixed; inset: 0; z-index: 400;
