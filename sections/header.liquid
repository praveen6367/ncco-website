}
.ncco-mob-brand:last-child { border-bottom: none; }
.ncco-mob-brand:hover { background: #F4F6FA; }
.ncco-mob-brand__logo { width: 44px; height: 44px; object-fit: contain; flex-shrink: 0; }
.ncco-mob-brand__name { font-family: 'Geist', sans-serif; font-size: 14px; font-weight: 600; color: #081D3A; margin: 0 0 2px; }
.ncco-mob-brand__desc { font-family: 'Geist', sans-serif; font-size: 12px; color: #647082; margin: 0; }

/* Mobile impact items */
.ncco-mob-impact {
  display: flex; align-items: center; gap: 14px;
  padding: 12px 24px; text-decoration: none;
  border-bottom: 1px solid rgba(8,29,58,0.04);
  transition: background 0.15s;
}
.ncco-mob-impact:last-child { border-bottom: none; }
.ncco-mob-impact:hover { background: #F4F6FA; }
.ncco-mob-impact__icon {
  width: 44px; height: 44px; flex-shrink: 0;
  background: #FFFBE6; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
}
.ncco-mob-impact__name { font-family: 'Geist', sans-serif; font-size: 14px; font-weight: 600; color: #081D3A; margin: 0 0 2px; }
.ncco-mob-impact__desc { font-family: 'Geist', sans-serif; font-size: 12px; color: #647082; margin: 0; }

.ncco-mob-nav__foot {
  padding: 16px 24px; border-top: 1px solid rgba(8,29,58,0.06); flex-shrink: 0;
}
.ncco-mob-nav__cta {
  display: block; width: 100%; padding: 16px 24px;
  background: #003DA5; color: #fff; text-align: center;
  font-family: 'Geist', sans-serif; font-size: 15px; font-weight: 500;
  text-transform: uppercase; text-decoration: none; border-radius: 40px;
  box-sizing: border-box;
}

/* Responsive */
@media (max-width: 1600px) { .ncco-hdr__inner { padding: 0 80px; } }
@media (max-width: 1200px) { .ncco-hdr__inner { padding: 0 40px; } .ncco-hdr__link { padding: 8px 10px; } }
@media (max-width: 989px) {
  .ncco-hdr__nav, .ncco-hdr__cta { display: none !important; }
  .ncco-hdr__hamburger { display: flex !important; }
  .ncco-hdr__inner { padding: 0 24px; height: 64px; gap: 12px; }
}
</style>

<script>
(function() {
  var toggle = document.getElementById('ncco-hdr-toggle');
  var closeBtn = document.getElementById('ncco-mob-close');
  var mobileNav = document.getElementById('ncco-mobile-nav');

  function openNav() {
    mobileNav.classList.add('is-open');
    mobileNav.setAttribute('aria-hidden', 'false');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeNav() {
    mobileNav.classList.remove('is-open');
    mobileNav.setAttribute('aria-hidden', 'true');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  if (toggle && mobileNav) toggle.addEventListener('click', function() {
    mobileNav.classList.contains('is-open') ? closeNav() : openNav();
  });
  if (closeBtn) closeBtn.addEventListener('click', closeNav);

  // Language switcher
  var langBtn = document.getElementById('lang-btn-desktop');
  if (langBtn) {
    var langWrap = langBtn.closest('.ncco-hdr__lang-wrap');
    var langDrop = langWrap.querySelector('.ncco-hdr__lang-drop');
    var langInput = langWrap.querySelector('input[name="locale_code"]');
    var langForm = langInput && langInput.closest('form');

    langBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      var opening = langDrop.hasAttribute('hidden');
      if (opening) { langDrop.removeAttribute('hidden'); } else { langDrop.setAttribute('hidden', ''); }
      langBtn.setAttribute('aria-expanded', String(opening));
    });

    langDrop.addEventListener('click', function(e) {
      var opt = e.target.closest('[data-locale]');
      if (!opt || !langInput || !langForm) return;
      e.stopPropagation();
      langInput.value = opt.dataset.locale;
      langForm.submit();
    });

    document.addEventListener('click', function(e) {
      if (!langWrap.contains(e.target)) {
        langDrop.setAttribute('hidden', '');
        langBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Desktop dropdown click toggle
  document.querySelectorAll('.ncco-hdr__link--btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var drop = btn.nextElementSibling;
      var isOpen = drop.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', isOpen);
    });
  });

  // Close dropdowns on outside click
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.ncco-hdr__item--drop')) {
      document.querySelectorAll('.ncco-hdr__dropdown.is-open').forEach(function(d) {
        d.classList.remove('is-open');
        d.previousElementSibling.setAttribute('aria-expanded', 'false');
      });
    }
  });
})();
</script>

<script type="application/ld+json">
{
  "@context": "http://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  {% if settings.logo %}"logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},{% endif %}
