<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- assign nav_menu = linklists[section.settings.menu] -%}

<header class="ncco-hdr" id="ncco-hdr">
  <div class="ncco-hdr__inner">

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="ncco-hdr__logo" aria-label="{{ shop.name }}">
      {%- if settings.logo != blank -%}
        {{- settings.logo | image_url: width: 280 | image_tag: class: 'ncco-hdr__logo-img', loading: 'eager', width: settings.logo_width, height: settings.logo_width | divided_by: settings.logo.aspect_ratio -}}
      {%- else -%}
        <img src="{{ 'brand-ncco-logo.png' | asset_url }}" alt="{{ shop.name }}" class="ncco-hdr__logo-img" width="120" height="44" loading="eager">
      {%- endif -%}
    </a>

    <!-- Desktop nav -->
    <nav class="ncco-hdr__nav" aria-label="Main navigation">
      {%- for link in nav_menu.links -%}
        {%- if link.links.size > 0 -%}
          <div class="ncco-hdr__item ncco-hdr__item--drop">
            {%- if link.title contains 'Brand' -%}
              <a href="/pages/our-brands" class="ncco-hdr__link" aria-haspopup="true">
                {{- link.title -}}
                <svg class="ncco-hdr__chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- else -%}
              <button class="ncco-hdr__link ncco-hdr__link--btn" aria-expanded="false" aria-haspopup="true">
                {{- link.title -}}
                <svg class="ncco-hdr__chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            {%- endif -%}

            {%- if link.title contains 'Brand' -%}
            <!-- Mega: Our Brands -->
            <div class="ncco-hdr__dropdown ncco-drop--brands" role="menu">
              <a href="/pages/ncco-technology" class="ncco-drop-brands__hero">
                <img src="{{ 'brand-ncco-sm-logo.png' | asset_url }}" alt="NCCO" class="ncco-drop-brands__hero-logo" loading="lazy">
                <div class="ncco-drop-brands__hero-text">
                  <p class="ncco-drop-brands__hero-name">NCCO</p>
                  <p class="ncco-drop-brands__hero-desc">Core technology powering all air purification.</p>
                </div>
                <svg class="ncco-drop-brands__hero-arr" width="18" height="18" viewBox="0 0 18 18" fill="none">
                  <path d="M4 14L14 4M14 4H7.5M14 4V10.5" stroke="#003DA5" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <div class="ncco-drop-brands__grid">
                <a href="/pages/rht" class="ncco-drop-brands__card">
                  <img src="{{ 'brand-rht-logo.png' | asset_url }}" alt="RHT" class="ncco-drop-brands__card-logo" loading="lazy">
                  <div class="ncco-drop-brands__card-text">
                    <p class="ncco-drop-brands__card-name">RHT</p>
                    <p class="ncco-drop-brands__card-desc">Industrial air solutions for large facilities.</p>
                  </div>
                </a>
                <a href="/pages/b-mola" class="ncco-drop-brands__card">
                  <img src="{{ 'brand-bmola-logo.png' | asset_url }}" alt="b-MoLa" class="ncco-drop-brands__card-logo" loading="lazy">
                  <div class="ncco-drop-brands__card-text">
                    <p class="ncco-drop-brands__card-name">b-MoLa</p>
                    <p class="ncco-drop-brands__card-desc">Smart purifiers for home and personal use.</p>
                  </div>
                </a>
                <a href="/pages/ncco-ig" class="ncco-drop-brands__card">
                  <img src="{{ 'brand-nccoig-logo.png' | asset_url }}" alt="NCCO-IG" class="ncco-drop-brands__card-logo" loading="lazy">
                  <div class="ncco-drop-brands__card-text">
                    <p class="ncco-drop-brands__card-name">NCCO-IG</p>
                    <p class="ncco-drop-brands__card-desc">Sterilization systems for clinical environments.</p>
                  </div>
                </a>
                <a href="/pages/05" class="ncco-drop-brands__card">
                  <img src="{{ 'brand-05plus-logo.png' | asset_url }}" alt="05+" class="ncco-drop-brands__card-logo" loading="lazy">
                  <div class="ncco-drop-brands__card-text">
                    <p class="ncco-drop-brands__card-name">05+</p>
                    <p class="ncco-drop-brands__card-desc">Lifestyle purifiers with elegant design.</p>
                  </div>
                </a>
              </div>
            </div>

            {%- elsif link.title contains 'Impact' -%}
            <!-- Mega: Our Impact -->
            <div class="ncco-hdr__dropdown ncco-drop--impact" role="menu">
              <div class="ncco-drop-impact__grid">
                <a href="/pages/residential" class="ncco-drop-impact__card">
                  <img src="{{ 'ncco-img-residential-room.png' | asset_url }}" alt="Residential Use" class="ncco-drop-impact__img" loading="lazy">
                  <div class="ncco-drop-impact__text">
                    <p class="ncco-drop-impact__name">Residential Use</p>
                    <p class="ncco-drop-impact__desc">Best seller in Hong Kong.</p>
                  </div>
                </a>
                <a href="/pages/medical" class="ncco-drop-impact__card">
                  <img src="{{ 'ncco-img-section-01.png' | asset_url }}" alt="Medical Use" class="ncco-drop-impact__img" loading="lazy">
                  <div class="ncco-drop-impact__text">
                    <p class="ncco-drop-impact__name">Medical Use</p>
                    <p class="ncco-drop-impact__desc">Provide air purification systems to 300 hospitals.</p>
                  </div>
                </a>
                <a href="/pages/industrial" class="ncco-drop-impact__card">
                  <img src="{{ 'ncco-img-industrial-plant.png' | asset_url }}" alt="Industrial Use" class="ncco-drop-impact__img" loading="lazy">
                  <div class="ncco-drop-impact__text">
                    <p class="ncco-drop-impact__name">Industrial Use</p>
                    <p class="ncco-drop-impact__desc">Deodorize waste stations, filter exhaust gases for factories.</p>
                  </div>
                </a>
                <a href="/pages/commercial" class="ncco-drop-impact__card">
                  <img src="{{ 'ncco-img-commercial-office.png' | asset_url }}" alt="Commercial Use" class="ncco-drop-impact__img" loading="lazy">
                  <div class="ncco-drop-impact__text">
                    <p class="ncco-drop-impact__name">Commercial Use</p>
                    <p class="ncco-drop-impact__desc">Provide air purification systems for commercial buildings.</p>
                  </div>
                </a>
              </div>
            </div>

            {%- else -%}
            <!-- Generic dropdown -->
            <div class="ncco-hdr__dropdown" role="menu">
              {%- for child in link.links -%}
                <a href="{{ child.url }}" class="ncco-hdr__dropdown-item" role="menuitem"
                  {% if child.active %}aria-current="page"{% endif %}>
                  {{- child.title -}}
                </a>
              {%- endfor -%}
            </div>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="ncco-hdr__item">
            <a href="{{ link.url }}" class="ncco-hdr__link"
              {% if link.active %}aria-current="page"{% endif %}>
              {{- link.title -}}
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <!-- Right: lang + CTA + hamburger -->
    <div class="ncco-hdr__right">
      <div class="ncco-hdr__lang-wrap">
        {%- form 'localization', id: 'lang-form-desktop' -%}
          <button type="button" class="ncco-hdr__lang" aria-haspopup="listbox" aria-expanded="false" id="lang-btn-desktop">
            <svg class="ncco-hdr__flag" viewBox="0 0 38 38" xmlns="http://www.w3.org/2000/svg">
              <g clip-path="url(#hdr-flag-clip)">
                <rect width="38" height="38" rx="19" fill="white"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M0 0H22.8V17.7333H0V0Z" fill="#1A47B8"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M22.8 0V2.53333H53.2V0H22.8ZM22.8 5.06667V7.6H53.2V5.06667H22.8ZM22.8 10.1333V12.6667H53.2V10.1333H22.8ZM22.8 15.2V17.7333H53.2V15.2H22.8ZM0 20.2667V22.8H53.2V20.2667H0ZM0 25.3333V27.8667H53.2V25.3333H0ZM0 30.4V32.9333H53.2V30.4H0ZM0 35.4667V38H53.2V35.4667H0Z" fill="#F93939"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M2.53333 2.53333V5.06667H5.06667V2.53333H2.53333ZM7.6 2.53333V5.06667H10.1333V2.53333H7.6ZM12.6667 2.53333V5.06667H15.2V2.53333H12.6667ZM17.7333 2.53333V5.06667H20.2667V2.53333H17.7333ZM15.2 5.06667V7.6H17.7333V5.06667H15.2ZM10.1333 5.06667V7.6H12.6667V5.06667H10.1333ZM5.06667 5.06667V7.6H7.6V5.06667H5.06667ZM2.53333 7.6V10.1333H5.06667V7.6H2.53333ZM7.6 7.6V10.1333H10.1333V7.6H7.6ZM12.6667 7.6V10.1333H15.2V7.6H12.6667ZM17.7333 7.6V10.1333H20.2667V7.6H17.7333ZM2.53333 12.6667V15.2H5.06667V12.6667H2.53333ZM7.6 12.6667V15.2H10.1333V12.6667H7.6ZM12.6667 12.6667V15.2H15.2V12.6667H12.6667ZM17.7333 12.6667V15.2H20.2667V12.6667H17.7333ZM15.2 10.1333V12.6667H17.7333V10.1333H15.2ZM10.1333 10.1333V12.6667H12.6667V10.1333H10.1333ZM5.06667 10.1333V12.6667H7.6V10.1333H5.06667Z" fill="white"/>
              </g>
              <defs><clipPath id="hdr-flag-clip"><rect width="38" height="38" rx="19" fill="white"/></clipPath></defs>
            </svg>
            <span class="ncco-hdr__lang-label">{{ localization.language.iso_code | upcase }}</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 4L6 8L10 4" stroke="#081D3A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <input type="hidden" name="locale_code" id="lang-locale-input" value="{{ localization.language.iso_code }}">
          <div class="ncco-hdr__lang-drop" role="listbox" hidden>
            {%- for lang in localization.available_languages -%}
              <button type="button" role="option" data-locale="{{ lang.iso_code }}"
                class="ncco-hdr__lang-opt{% if lang.iso_code == localization.language.iso_code %} is-active{% endif %}">
                {{ lang.endonym_name }}
              </button>
            {%- endfor -%}
          </div>
        {%- endform -%}
      </div>

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: '/pages/contact-us' }}" class="ncco-hdr__cta">
          <span>{{ section.settings.cta_label }}</span>
          <span class="ncco-hdr__cta-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 13L13 3M13 3H6M13 3V10" stroke="#081D3A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      {%- endif -%}

      <button class="ncco-hdr__hamburger" id="ncco-hdr-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="ncco-mobile-nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Full-screen mobile nav overlay -->
<div class="ncco-mob-nav" id="ncco-mobile-nav" aria-hidden="true">
  <div class="ncco-mob-nav__head">
    <a href="{{ routes.root_url }}">
      <img src="{{ 'brand-ncco-logo.png' | asset_url }}" alt="{{ shop.name }}" class="ncco-mob-nav__logo" width="100" height="36">
    </a>
    <button class="ncco-mob-nav__close" id="ncco-mob-close" aria-label="Close menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M6 18L18 6M6 6l12 12" stroke="#081D3A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="ncco-mob-nav__body">
    {%- for link in nav_menu.links -%}
      {%- if link.title contains 'Brand' -%}
        <details class="ncco-mob-nav__group">
          <summary class="ncco-mob-nav__group-btn">
            {{ link.title }}
            <svg class="ncco-mob-nav__chev" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div class="ncco-mob-nav__group-body">
            <a href="/pages/our-brands" class="ncco-mob-brand">
              <img src="{{ 'brand-ncco-sm-logo.png' | asset_url }}" alt="NCCO" class="ncco-mob-brand__logo" loading="lazy">
              <div><p class="ncco-mob-brand__name">NCCO</p><p class="ncco-mob-brand__desc">Core air purification technology</p></div>
            </a>
            <a href="/pages/rht" class="ncco-mob-brand">
              <img src="{{ 'brand-rht-logo.png' | asset_url }}" alt="RHT" class="ncco-mob-brand__logo" loading="lazy">
              <div><p class="ncco-mob-brand__name">RHT</p><p class="ncco-mob-brand__desc">Industrial air solutions for large facilities</p></div>
            </a>
            <a href="/pages/b-mola" class="ncco-mob-brand">
              <img src="{{ 'brand-bmola-logo.png' | asset_url }}" alt="b-MoLa" class="ncco-mob-brand__logo" loading="lazy">
              <div><p class="ncco-mob-brand__name">b-MoLa</p><p class="ncco-mob-brand__desc">Smart purifiers for home and personal use</p></div>
            </a>
            <a href="/pages/ncco-ig" class="ncco-mob-brand">
              <img src="{{ 'brand-nccoig-logo.png' | asset_url }}" alt="NCCO-IG" class="ncco-mob-brand__logo" loading="lazy">
              <div><p class="ncco-mob-brand__name">NCCO-IG</p><p class="ncco-mob-brand__desc">Sterilization systems for clinical environments</p></div>
            </a>
            <a href="/pages/05" class="ncco-mob-brand">
              <img src="{{ 'brand-05plus-logo.png' | asset_url }}" alt="05+" class="ncco-mob-brand__logo" loading="lazy">
              <div><p class="ncco-mob-brand__name">05+</p><p class="ncco-mob-brand__desc">Lifestyle purifiers with elegant design</p></div>
            </a>
          </div>
        </details>

      {%- elsif link.title contains 'Impact' -%}
        <details class="ncco-mob-nav__group">
          <summary class="ncco-mob-nav__group-btn">
            {{ link.title }}
            <svg class="ncco-mob-nav__chev" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div class="ncco-mob-nav__group-body">
            <a href="/pages/residential" class="ncco-mob-impact">
              <div class="ncco-mob-impact__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3 9.5L12 3L21 9.5V20a1 1 0 01-1 1H4a1 1 0 01-1-1V9.5z" stroke="#081D3A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 21V12h6v9" stroke="#081D3A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
              <div><p class="ncco-mob-impact__name">Residential Use</p><p class="ncco-mob-impact__desc">Best seller in Hong Kong</p></div>
            </a>
            <a href="/pages/medical" class="ncco-mob-impact">
              <div class="ncco-mob-impact__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="#081D3A" stroke-width="1.8"/><path d="M12 8v8M8 12h8" stroke="#081D3A" stroke-width="1.8" stroke-linecap="round"/></svg>
              </div>
              <div><p class="ncco-mob-impact__name">Medical Use</p><p class="ncco-mob-impact__desc">Partnered with 300+ hospitals</p></div>
            </a>
            <a href="/pages/industrial" class="ncco-mob-impact">
              <div class="ncco-mob-impact__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="2" y="13" width="5" height="8" rx="1" stroke="#081D3A" stroke-width="1.8"/><rect x="9" y="9" width="5" height="12" rx="1" stroke="#081D3A" stroke-width="1.8"/><rect x="16" y="5" width="5" height="16" rx="1" stroke="#081D3A" stroke-width="1.8"/><path d="M2 21h20" stroke="#081D3A" stroke-width="1.8" stroke-linecap="round"/></svg>
              </div>
              <div><p class="ncco-mob-impact__name">Industrial Use</p><p class="ncco-mob-impact__desc">Heavy-duty purification at scale</p></div>
            </a>
            <a href="/pages/commercial" class="ncco-mob-impact">
              <div class="ncco-mob-impact__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><rect x="3" y="7" width="18" height="14" rx="1" stroke="#081D3A" stroke-width="1.8"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2" stroke="#081D3A" stroke-width="1.8"/><path d="M12 12v3M8 12h8" stroke="#081D3A" stroke-width="1.8" stroke-linecap="round"/></svg>
              </div>
              <div><p class="ncco-mob-impact__name">Commercial Use</p><p class="ncco-mob-impact__desc">Smart air quality for offices &amp; retail</p></div>
