<script>
(function() {
  var toggle = document.getElementById('ncco-hdr-toggle');
  var closeBtn = document.getElementById('ncco-mob-close');
  var mobileNav = document.getElementById('ncco-mobile-nav');

  function openNav() {
    mobileNav.classList.add('is-open');
    mobileNav.setAttribute('aria-hidden', 'false');
    toggle.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }
  function closeNav() {
    mobileNav.classList.remove('is-open');
    mobileNav.setAttribute('aria-hidden', 'true');
    toggle.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  if (toggle && mobileNav) toggle.addEventListener('click', function() {
    mobileNav.classList.contains('is-open') ? closeNav() : openNav();
  });
  if (closeBtn) closeBtn.addEventListener('click', closeNav);

  // Language switcher
  var langBtn = document.getElementById('lang-btn-desktop');
  if (langBtn) {
    var langWrap = langBtn.closest('.ncco-hdr__lang-wrap');
    var langDrop = langWrap.querySelector('.ncco-hdr__lang-drop');
    var langInput = langWrap.querySelector('input[name="language_code"]');
    var langForm = langInput && langInput.closest('form');

    langBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      var opening = langDrop.hasAttribute('hidden');
      if (opening) { langDrop.removeAttribute('hidden'); } else { langDrop.setAttribute('hidden', ''); }
      langBtn.setAttribute('aria-expanded', String(opening));
    });

    langDrop.addEventListener('click', function(e) {
      var opt = e.target.closest('[data-locale]');
      if (!opt || !langInput || !langForm) return;
      e.stopPropagation();
      langInput.value = opt.dataset.locale;
      langForm.submit();
    });

    document.addEventListener('click', function(e) {
      if (!langWrap.contains(e.target)) {
        langDrop.setAttribute('hidden', '');
        langBtn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Desktop dropdown click toggle
  document.querySelectorAll('.ncco-hdr__link--btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var drop = btn.nextElementSibling;
      var isOpen = drop.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', isOpen);
    });
  });

  // Close dropdowns on outside click
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.ncco-hdr__item--drop')) {
      document.querySelectorAll('.ncco-hdr__dropdown.is-open').forEach(function(d) {
        d.classList.remove('is-open');
        d.previousElementSibling.setAttribute('aria-expanded', 'false');
      });
    }
  });
})();
</script>

