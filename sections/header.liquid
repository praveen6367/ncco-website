}
.ncco-mob-nav__group-btn::-webkit-details-marker { display: none; }
.ncco-mob-nav__chev { flex-shrink: 0; transition: transform 0.2s; }
.ncco-mob-nav__group[open] .ncco-mob-nav__chev { transform: rotate(180deg); }
.ncco-mob-nav__group-body { padding: 4px 0 16px; }
.ncco-mob-nav__child {
  display: block; padding: 10px 24px;
  font-family: 'Geist', sans-serif; font-size: 14px; color: #647082; text-decoration: none;
}
.ncco-mob-nav__child:hover { color: #003DA5; }

/* Mobile brand items */
.ncco-mob-brand {
  display: flex; align-items: center; gap: 14px;
