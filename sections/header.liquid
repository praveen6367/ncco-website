<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- assign nav_menu = linklists[section.settings.menu] -%}
{%- assign root_path = routes.root_url -%}
{%- if root_path == '/' -%}
  {%- assign root_path = '' -%}
{%- endif -%}

<header class="ncco-hdr" id="ncco-hdr">
  <div class="ncco-hdr__inner">

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="ncco-hdr__logo" aria-label="{{ shop.name }}">
      <img src="{{ 'newlogo.png' | asset_url }}" alt="{{ shop.name }}" class="ncco-hdr__logo-img" width="102" height="56" loading="eager">
    </a>

    <!-- Desktop nav -->
    <nav class="ncco-hdr__nav" aria-label="{{ 'ncco.header.main_navigation' | t }}">
      {%- for link in nav_menu.links -%}
        {%- assign title_down = link.title | downcase -%}
        {%- assign url_down = link.url | downcase -%}
        {%- assign handle_down = link.handle | downcase -%}
        {%- assign is_brand_menu = false -%}
        {%- if title_down contains 'brand' or title_down contains '品牌' or url_down contains 'brand' or handle_down contains 'brand' or forloop.index == 1 -%}
          {%- assign is_brand_menu = true -%}
        {%- endif -%}
        {%- assign is_impact_menu = false -%}
        {%- if title_down contains 'impact' or title_down contains '影響' or title_down contains '影响' or url_down contains 'impact' or handle_down contains 'impact' or forloop.index == 2 -%}
          {%- assign is_impact_menu = true -%}
        {%- endif -%}

        {%- if link.links.size > 0 or is_brand_menu or is_impact_menu -%}
          <div class="ncco-hdr__item ncco-hdr__item--drop">
            {%- if is_brand_menu -%}
              <a href="{%- if link.url != blank and link.url != '#' -%}{{ link.url }}{%- else -%}{{ root_path }}/pages/our-brands{%- endif -%}" class="ncco-hdr__link" aria-haspopup="true">
                {{- link.title -}}
                <svg class="ncco-hdr__chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            {%- else -%}
              <button class="ncco-hdr__link ncco-hdr__link--btn" aria-expanded="false" aria-haspopup="true">
                {{- link.title -}}
                <svg class="ncco-hdr__chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            {%- endif -%}

            {%- if is_brand_menu -%}
            <!-- Mega: Our Brands -->
            <div class="ncco-hdr__dropdown ncco-drop--brands" role="menu">
              <a href="{{ root_path }}/pages/our-brands" class="ncco-drop-brands__hero">
                <div class="ncco-drop-brands__logo-wrap">
                  <img src="{{ 'nccomenu.png' | asset_url }}" alt="NCCO" class="ncco-drop-brands__logo" loading="lazy">
                </div>
                <div class="ncco-drop-brands__text">
                  <p class="ncco-drop-brands__name">NCCO</p>
                  <p class="ncco-drop-brands__desc">{{ 'ncco.header.brands.ncco_desc' | t }}</p>
                </div>
              </a>
              <div class="ncco-drop-brands__grid">
                <a href="{{ root_path }}/pages/rht" class="ncco-drop-brands__card ncco-drop-brands__card--rht">
                  <div class="ncco-drop-brands__logo-wrap">
                    <img src="{{ 'rhtmenu.png' | asset_url }}" alt="RHT" class="ncco-drop-brands__logo" loading="lazy">
                  </div>
                  <div class="ncco-drop-brands__text">
                    <p class="ncco-drop-brands__name">RHT</p>
                    <p class="ncco-drop-brands__desc">{{ 'ncco.header.brands.rht_desc' | t }}</p>
                  </div>
                </a>
                <a href="{{ root_path }}/pages/b-mola" class="ncco-drop-brands__card ncco-drop-brands__card--bmola">
                  <div class="ncco-drop-brands__logo-wrap">
                    <img src="{{ 'b-mollamenu.png' | asset_url }}" alt="b-MOLA" class="ncco-drop-brands__logo" loading="lazy">
                  </div>
                  <div class="ncco-drop-brands__text">
                    <p class="ncco-drop-brands__name">b-MOLA</p>
                    <p class="ncco-drop-brands__desc">{{ 'ncco.header.brands.bmola_desc' | t }}</p>
                  </div>
                </a>
                <a href="{{ root_path }}/pages/ncco-ig" class="ncco-drop-brands__card ncco-drop-brands__card--nccoig">
                  <div class="ncco-drop-brands__logo-wrap">
                    <img src="{{ 'nccoigmenu.png' | asset_url }}" alt="NCCO-IG" class="ncco-drop-brands__logo" loading="lazy">
                  </div>
                  <div class="ncco-drop-brands__text">
                    <p class="ncco-drop-brands__name">NCCO-IG</p>
                    <p class="ncco-drop-brands__desc">{{ 'ncco.header.brands.nccoig_desc' | t }}</p>
                  </div>
                </a>
                <a href="{{ root_path }}/pages/05" class="ncco-drop-brands__card ncco-drop-brands__card--05">
                  <div class="ncco-drop-brands__logo-wrap">
                    <img src="{{ 'o5menu.png' | asset_url }}" alt="05+" class="ncco-drop-brands__logo" loading="lazy">
                  </div>
                  <div class="ncco-drop-brands__text">
                    <p class="ncco-drop-brands__name">05+</p>
                    <p class="ncco-drop-brands__desc">{{ 'ncco.header.brands.o5_desc' | t }}</p>
                  </div>
                </a>
              </div>
            </div>

            {%- elsif is_impact_menu -%}
            <!-- Mega: Our Impact -->
            <div class="ncco-hdr__dropdown ncco-drop--impact" role="menu">
              <div class="ncco-drop-impact__grid">
                <a href="{{ root_path }}/pages/residential" class="ncco-drop-impact__card ncco-drop-impact__card--res">
                  <img src="{{ 'residentialmenu.png' | asset_url }}" alt="Residential Use" class="ncco-drop-impact__img" loading="lazy">
                  <div class="ncco-drop-impact__text">
                    <p class="ncco-drop-impact__name">{{ 'ncco.header.impact.residential_title' | t }}</p>
                    <p class="ncco-drop-impact__desc">{{ 'ncco.header.impact.residential_desc' | t }}</p>
                  </div>
                </a>
                <a href="{{ root_path }}/pages/medical" class="ncco-drop-impact__card ncco-drop-impact__card--med">
                  <img src="{{ 'medicalmenu.png' | asset_url }}" alt="Medical Use" class="ncco-drop-impact__img" loading="lazy">
                  <div class="ncco-drop-impact__text">
                    <p class="ncco-drop-impact__name">{{ 'ncco.header.impact.medical_title' | t }}</p>
                    <p class="ncco-drop-impact__desc">{{ 'ncco.header.impact.medical_desc' | t }}</p>
                  </div>
                </a>
                <a href="{{ root_path }}/pages/industrial" class="ncco-drop-impact__card ncco-drop-impact__card--ind">
                  <img src="{{ 'industrialmenu.png' | asset_url }}" alt="Industrial Use" class="ncco-drop-impact__img" loading="lazy">
                  <div class="ncco-drop-impact__text">
                    <p class="ncco-drop-impact__name">{{ 'ncco.header.impact.industrial_title' | t }}</p>
                    <p class="ncco-drop-impact__desc">{{ 'ncco.header.impact.industrial_desc' | t }}</p>
                  </div>
                </a>
                <a href="{{ root_path }}/pages/commercial" class="ncco-drop-impact__card ncco-drop-impact__card--com">
                  <img src="{{ 'commercialmenu.png' | asset_url }}" alt="Commercial Use" class="ncco-drop-impact__img" loading="lazy">
                  <div class="ncco-drop-impact__text">
                    <p class="ncco-drop-impact__name">{{ 'ncco.header.impact.commercial_title' | t }}</p>
                    <p class="ncco-drop-impact__desc">{{ 'ncco.header.impact.commercial_desc' | t }}</p>
                  </div>
                </a>
              </div>
            </div>

            {%- else -%}
            <!-- Generic dropdown -->
            <div class="ncco-hdr__dropdown" role="menu">
              {%- for child in link.links -%}
                <a href="{{ child.url }}" class="ncco-hdr__dropdown-item" role="menuitem"
                  {% if child.active %}aria-current="page"{% endif %}>
                  {{- child.title -}}
                </a>
              {%- endfor -%}
            </div>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="ncco-hdr__item">
            <a href="{{ link.url }}" class="ncco-hdr__link"
              {% if link.active %}aria-current="page"{% endif %}>
              {{- link.title -}}
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <!-- Right: lang + CTA + hamburger -->
    <div class="ncco-hdr__right">
      <div class="ncco-hdr__lang-wrap">
        {%- form 'localization', id: 'lang-form-desktop' -%}
          <button type="button" class="ncco-hdr__lang" aria-haspopup="listbox" aria-expanded="false" id="lang-btn-desktop">
            <svg class="ncco-hdr__flag" viewBox="0 0 38 38" xmlns="http://www.w3.org/2000/svg">
              <g clip-path="url(#hdr-flag-clip)">
                <rect width="38" height="38" rx="19" fill="white"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M0 0H22.8V17.7333H0V0Z" fill="#1A47B8"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M22.8 0V2.53333H53.2V0H22.8ZM22.8 5.06667V7.6H53.2V5.06667H22.8ZM22.8 10.1333V12.6667H53.2V10.1333H22.8ZM22.8 15.2V17.7333H53.2V15.2H22.8ZM0 20.2667V22.8H53.2V20.2667H0ZM0 25.3333V27.8667H53.2V25.3333H0ZM0 30.4V32.9333H53.2V30.4H0ZM0 35.4667V38H53.2V35.4667H0Z" fill="#F93939"/>
                <path fill-rule="evenodd" clip-rule="evenodd" d="M2.53333 2.53333V5.06667H5.06667V2.53333H2.53333ZM7.6 2.53333V5.06667H10.1333V2.53333H7.6ZM12.6667 2.53333V5.06667H15.2V2.53333H12.6667ZM17.7333 2.53333V5.06667H20.2667V2.53333H17.7333ZM15.2 5.06667V7.6H17.7333V5.06667H15.2ZM10.1333 5.06667V7.6H12.6667V5.06667H10.1333ZM5.06667 5.06667V7.6H7.6V5.06667H5.06667ZM2.53333 7.6V10.1333H5.06667V7.6H2.53333ZM7.6 7.6V10.1333H10.1333V7.6H7.6ZM12.6667 7.6V10.1333H15.2V7.6H12.6667ZM17.7333 7.6V10.1333H20.2667V7.6H17.7333ZM2.53333 12.6667V15.2H5.06667V12.6667H2.53333ZM7.6 12.6667V15.2H10.1333V12.6667H7.6ZM12.6667 12.6667V15.2H15.2V12.6667H12.6667ZM17.7333 12.6667V15.2H20.2667V12.6667H17.7333ZM15.2 10.1333V12.6667H17.7333V10.1333H15.2ZM10.1333 10.1333V12.6667H12.6667V10.1333H10.1333ZM5.06667 10.1333V12.6667H7.6V10.1333H5.06667Z" fill="white"/>
              </g>
              <defs><clipPath id="hdr-flag-clip"><rect width="38" height="38" rx="19" fill="white"/></clipPath></defs>
            </svg>
            <span class="ncco-hdr__lang-label">{{ localization.language.iso_code | upcase }}</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="M2 4L6 8L10 4" stroke="#081D3A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <input type="hidden" name="language_code" id="lang-locale-input" value="{{ localization.language.iso_code }}">
          <div class="ncco-hdr__lang-drop" role="listbox" hidden>
            {%- for lang in localization.available_languages -%}
              <button type="button" role="option" data-locale="{{ lang.iso_code }}"
                class="ncco-hdr__lang-opt{% if lang.iso_code == localization.language.iso_code %} is-active{% endif %}">
                {{ lang.endonym_name }}
              </button>
            {%- endfor -%}
          </div>
        {%- endform -%}
      </div>

      {%- if section.settings.cta_label != blank or true -%}
        {%- assign default_cta = 'ncco.header.contact_us' | t -%}
        <a href="{% if section.settings.cta_url != blank %}{{ section.settings.cta_url }}{% else %}{{ root_path }}/pages/contact{% endif %}" class="ncco-hdr__cta">
          <span>{% if section.settings.cta_label != blank and section.settings.cta_label != 'Contact Us' and section.settings.cta_label != '聯絡我們' %}{{ section.settings.cta_label }}{% else %}{{ default_cta }}{% endif %}</span>
          <span class="ncco-hdr__cta-icon" aria-hidden="true">
            <svg width="38" height="38" viewBox="0 0 38 38" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="19" cy="19" r="19" fill="#FECB07"/>
              <path d="M14 24L24 14M24 14H17M24 14V21" stroke="#081D3A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      {%- endif -%}

      <button class="ncco-hdr__hamburger" id="ncco-hdr-toggle" aria-label="{{ 'ncco.header.open_menu' | t }}" aria-expanded="false" aria-controls="ncco-mobile-nav">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="40" height="40" rx="20" fill="#003DA5"/>
          <path d="M12.5 20H27.5M12.5 15H27.5M17.5 25H27.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Full-screen mobile nav overlay -->
<div class="ncco-mob-nav" id="ncco-mobile-nav" aria-hidden="true">
  <div class="ncco-mob-nav__head">
    <a href="{{ routes.root_url }}">
      <img src="{{ 'newlogo.png' | asset_url }}" alt="{{ shop.name }}" class="ncco-mob-nav__logo" width="99" height="54">
    </a>
    <button class="ncco-mob-nav__close" id="ncco-mob-close" aria-label="{{ 'ncco.header.close_menu' | t }}">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M15 5L5 15M5 5L15 15" stroke="#647082" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="ncco-mob-nav__body">
    {%- for link in nav_menu.links -%}
      {%- assign title_down = link.title | downcase -%}
      {%- assign url_down = link.url | downcase -%}
      {%- assign handle_down = link.handle | downcase -%}
      {%- assign is_brand_menu = false -%}
      {%- if title_down contains 'brand' or title_down contains '品牌' or url_down contains 'brand' or handle_down contains 'brand' or forloop.index == 1 -%}
        {%- assign is_brand_menu = true -%}
      {%- endif -%}
      {%- assign is_impact_menu = false -%}
      {%- if title_down contains 'impact' or title_down contains '影響' or title_down contains '影响' or url_down contains 'impact' or handle_down contains 'impact' or forloop.index == 2 -%}
        {%- assign is_impact_menu = true -%}
      {%- endif -%}

      {%- if is_brand_menu -%}
        <details class="ncco-mob-nav__group">
          <summary class="ncco-mob-nav__group-btn">
            {{ link.title }}
            <svg class="ncco-mob-nav__chev" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div class="ncco-mob-nav__group-body">
            <div class="ncco-mob-card">
              <a href="{{ root_path }}/pages/our-brands" class="ncco-mob-brand">
                <div class="ncco-mob-brand__logo-wrap">
                  <img src="{{ 'nccomenu.png' | asset_url }}" alt="NCCO" class="ncco-mob-brand__logo" loading="lazy">
                </div>
                <div class="ncco-mob-brand__text">
                  <p class="ncco-mob-brand__name">NCCO</p>
                  <p class="ncco-mob-brand__desc">{{ 'ncco.header.brands.ncco_desc' | t }}</p>
                </div>
              </a>
              <a href="{{ root_path }}/pages/rht" class="ncco-mob-brand">
                <div class="ncco-mob-brand__logo-wrap">
                  <img src="{{ 'rhtmenu.png' | asset_url }}" alt="RHT" class="ncco-mob-brand__logo" loading="lazy">
                </div>
                <div class="ncco-mob-brand__text">
                  <p class="ncco-mob-brand__name">RHT</p>
                  <p class="ncco-mob-brand__desc">{{ 'ncco.header.brands.rht_desc' | t }}</p>
                </div>
              </a>
              <a href="{{ root_path }}/pages/b-mola" class="ncco-mob-brand">
                <div class="ncco-mob-brand__logo-wrap">
                  <img src="{{ 'b-mollamenu.png' | asset_url }}" alt="b-MOLA" class="ncco-mob-brand__logo" loading="lazy">
                </div>
                <div class="ncco-mob-brand__text">
                  <p class="ncco-mob-brand__name">b-MOLA</p>
                  <p class="ncco-mob-brand__desc">{{ 'ncco.header.brands.bmola_desc' | t }}</p>
                </div>
              </a>
              <a href="{{ root_path }}/pages/ncco-ig" class="ncco-mob-brand">
                <div class="ncco-mob-brand__logo-wrap">
                  <img src="{{ 'nccoigmenu.png' | asset_url }}" alt="NCCO-IG" class="ncco-mob-brand__logo" loading="lazy">
                </div>
                <div class="ncco-mob-brand__text">
                  <p class="ncco-mob-brand__name">NCCO-IG</p>
                  <p class="ncco-mob-brand__desc">{{ 'ncco.header.brands.nccoig_desc' | t }}</p>
                </div>
              </a>
              <a href="{{ root_path }}/pages/05" class="ncco-mob-brand">
                <div class="ncco-mob-brand__logo-wrap">
                  <img src="{{ 'o5menu.png' | asset_url }}" alt="05+" class="ncco-mob-brand__logo" loading="lazy">
                </div>
                <div class="ncco-mob-brand__text">
                  <p class="ncco-mob-brand__name">05+</p>
                  <p class="ncco-mob-brand__desc">{{ 'ncco.header.brands.o5_desc' | t }}</p>
                </div>
              </a>
            </div>
          </div>
        </details>

      {%- elsif is_impact_menu -%}
        <details class="ncco-mob-nav__group">
          <summary class="ncco-mob-nav__group-btn">
            {{ link.title }}
            <svg class="ncco-mob-nav__chev" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div class="ncco-mob-nav__group-body">
            <div class="ncco-mob-card">
              <a href="{{ root_path }}/pages/residential" class="ncco-mob-impact">
                <img src="{{ 'residentialmenu.png' | asset_url }}" alt="Residential Use" class="ncco-mob-impact__img" loading="lazy">
                <div class="ncco-mob-impact__text">
                  <p class="ncco-mob-impact__name">{{ 'ncco.header.impact.residential_title' | t }}</p>
                  <p class="ncco-mob-impact__desc">{{ 'ncco.header.impact.residential_desc' | t }}</p>
                </div>
              </a>
              <a href="{{ root_path }}/pages/medical" class="ncco-mob-impact">
                <img src="{{ 'medicalmenu.png' | asset_url }}" alt="Medical Use" class="ncco-mob-impact__img" loading="lazy">
                <div class="ncco-mob-impact__text">
                  <p class="ncco-mob-impact__name">{{ 'ncco.header.impact.medical_title' | t }}</p>
                  <p class="ncco-mob-impact__desc">{{ 'ncco.header.impact.medical_desc' | t }}</p>
                </div>
              </a>
              <a href="{{ root_path }}/pages/industrial" class="ncco-mob-impact">
                <img src="{{ 'industrialmenu.png' | asset_url }}" alt="Industrial Use" class="ncco-mob-impact__img" loading="lazy">
                <div class="ncco-mob-impact__text">
                  <p class="ncco-mob-impact__name">{{ 'ncco.header.impact.industrial_title' | t }}</p>
                  <p class="ncco-mob-impact__desc">{{ 'ncco.header.impact.industrial_desc' | t }}</p>
                </div>
              </a>
              <a href="{{ root_path }}/pages/commercial" class="ncco-mob-impact">
                <img src="{{ 'commercialmenu.png' | asset_url }}" alt="Commercial Use" class="ncco-mob-impact__img" loading="lazy">
                <div class="ncco-mob-impact__text">
                  <p class="ncco-mob-impact__name">{{ 'ncco.header.impact.commercial_title' | t }}</p>
                  <p class="ncco-mob-impact__desc">{{ 'ncco.header.impact.commercial_desc' | t }}</p>
                </div>
              </a>
            </div>
          </div>
        </details>

      {%- elsif link.links.size > 0 -%}
        <details class="ncco-mob-nav__group">
          <summary class="ncco-mob-nav__group-btn">
            {{ link.title }}
            <svg class="ncco-mob-nav__chev" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </summary>
          <div class="ncco-mob-nav__group-body">
            {%- for child in link.links -%}
              <a href="{{ child.url }}" class="ncco-mob-nav__child">{{ child.title }}</a>
            {%- endfor -%}
          </div>
        </details>

      {%- else -%}
        <a href="{{ link.url }}" class="ncco-mob-nav__link">{{ link.title }}</a>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="ncco-mob-nav__foot">
    <a href="{% if section.settings.cta_url != blank %}{{ section.settings.cta_url }}{% else %}{{ root_path }}/pages/contact{% endif %}" class="ncco-mob-nav__cta">
      {%- assign default_cta = 'ncco.header.contact_us' | t -%}
      <span>{{ section.settings.cta_label | default: default_cta }}</span>
      <span class="ncco-mob-nav__cta-icon" aria-hidden="true">
        <svg width="38" height="38" viewBox="0 0 38 38" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="19" cy="19" r="19" fill="#FECB07"/>
          <path d="M14 24L24 14M24 14H17M24 14V21" stroke="#081D3A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </a>
  </div>
</div>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: 'dropdown' -%}
{%- endif -%}

<style>
/* ── NCCO Custom Navbar ── */
.shopify-section-group-header-group,
.section-header {
  position: relative !important;
  top: auto !important;
}
.ncco-hdr {
  position: relative; z-index: 200;
  background: #fff;
  border-bottom: 1px solid rgba(8,29,58,0.06);
}

.ncco-hdr__inner {
  display: flex; align-items: center; justify-content: space-between;
  gap: 24px; padding: 0 36px; height: 76px;
  max-width: 1360px; margin: 0 auto; box-sizing: border-box;
}

/* Logo */
.ncco-hdr__logo { display: flex; align-items: center; flex-shrink: 0; }
.ncco-hdr__logo-img { height: 56px; width: auto; display: block; object-fit: contain; }

/* Desktop nav */
.ncco-hdr__nav { display: flex; align-items: center; gap: 4px; }
.ncco-hdr__item { position: relative; }
.ncco-hdr__link {
  display: flex; align-items: center; gap: 6px;
  font-family: 'Geist', sans-serif; font-size: 15px; font-weight: 500;
  color: #081D3A; text-decoration: none; text-transform: none; letter-spacing: -0.1px;
  padding: 8px 14px; border-radius: 8px;
  white-space: nowrap; transition: color 0.15s, background 0.15s;
  background: none; border: none; cursor: pointer;
}
.ncco-hdr__link:hover, .ncco-hdr__link[aria-current="page"] { color: #003DA5; background: rgba(0,61,165,0.05); }
.ncco-hdr__chev { transition: transform 0.2s; flex-shrink: 0; }
.ncco-hdr__item--drop:hover .ncco-hdr__chev,
.ncco-hdr__item--drop .ncco-hdr__link--btn[aria-expanded="true"] .ncco-hdr__chev { transform: rotate(180deg); }

/* Base dropdown */
.ncco-hdr__dropdown {
  display: none; position: absolute; top: calc(100% + 8px); left: 50%;
  transform: translateX(-50%);
  background: #fff; border: 1px solid rgba(8,29,58,0.08);
  border-radius: 14px; box-shadow: 0 16px 48px rgba(8,29,58,0.12);
  padding: 8px; min-width: 200px; z-index: 300;
}
/* Invisible bridge fills gap so hover stays active when cursor moves toward dropdown */
.ncco-hdr__item--drop::after {
  content: ''; position: absolute; top: 100%; left: 0; width: 100%; height: 14px;
}
.ncco-hdr__item--drop:hover > .ncco-hdr__link {
  color: #003DA5;
}
.ncco-hdr__item--drop:hover > .ncco-hdr__link::after {
  content: '';
  position: absolute;
  bottom: 0px;
  left: 14px;
  width: 28px;
  height: 2px;
  background: #003DA5;
  border-radius: 2px;
}
.ncco-hdr__item--drop:hover .ncco-hdr__dropdown,
.ncco-hdr__item--drop .ncco-hdr__dropdown.is-open { display: block; }
.ncco-hdr__dropdown-item {
  display: block; padding: 10px 16px; border-radius: 8px;
