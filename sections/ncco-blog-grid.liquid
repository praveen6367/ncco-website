{%- assign grid_blog = blogs[section.settings.blog] -%}
<section class="ncco-blog-grid ncco-section ncco-section--grey">
  <div class="ncco-bgrid__inner">
    <div class="ncco-bgrid__header">
      <div class="ncco-bgrid__header-left">
        {% if section.settings.eyebrow != blank %}
          <p class="ncco-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="ncco-bgrid__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
      {% if section.settings.subtext != blank %}
        <p class="ncco-bgrid__subtext">{{ section.settings.subtext }}</p>
      {% endif %}
    </div>

    <div class="ncco-bgrid__grid">
      {%- assign count = section.settings.count | default: 3 -%}
      {% for article in grid_blog.articles limit: count %}
        <a href="{{ article.url }}" class="ncco-bgrid__card">
          {% if article.image %}
            <div class="ncco-bgrid__img-wrap">
              <img src="{{ article.image | image_url: width: 600 }}"
                   alt="{{ article.title }}" loading="lazy">
              {% if article.tags != blank %}
                <span class="ncco-bgrid__tag">{{ article.tags | first }}</span>
              {% endif %}
            </div>
          {% endif %}
          <div class="ncco-bgrid__card-body">
            <p class="ncco-bgrid__meta">{{ article.published_at | date: '%b %d, %Y' }}</p>
            <h3 class="ncco-bgrid__title">{{ article.title }}</h3>
            <p class="ncco-bgrid__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 100 }}</p>
            <span class="ncco-bgrid__read-more">Read More →</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.ncco-blog-grid { padding: 80px 240px; background: #f9f9fa; }
.ncco-bgrid__inner { max-width: 100%; }
.ncco-bgrid__header {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 40px; margin-bottom: 48px;
}
.ncco-bgrid__header-left .ncco-eyebrow { margin-bottom: 8px; }
.ncco-bgrid__heading {
  font-family: 'Geist', sans-serif;
  font-size: 42px; font-weight: 600; letter-spacing: -1.5px; line-height: 1.15;
  color: #081D3A; margin: 0;
}
.ncco-bgrid__subtext {
  font-family: 'Geist', sans-serif;
  font-size: 16px; color: #647082; line-height: 1.6;
  max-width: 380px; margin: 0; text-align: right;
}
.ncco-bgrid__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.ncco-bgrid__card {
  background: #fff; border-radius: 20px; overflow: hidden;
  box-shadow: 0 8px 32px rgba(8,29,58,0.04);
  border: 1px solid rgba(8,29,58,0.08);
  text-decoration: none;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  display: flex; flex-direction: column;
}
.ncco-bgrid__card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(8,29,58,0.1); }
.ncco-bgrid__img-wrap { position: relative; overflow: hidden; }
.ncco-bgrid__img-wrap img { width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block; }
.ncco-bgrid__tag {
  position: absolute; top: 12px; left: 12px;
  background: #FECB07; color: #081D3A;
  font-family: 'Geist', sans-serif;
  font-size: 11px; font-weight: 600; letter-spacing: 0.5px;
  text-transform: uppercase; padding: 4px 10px; border-radius: 20px;
}
.ncco-bgrid__card-body { padding: 24px; flex: 1; display: flex; flex-direction: column; }
.ncco-bgrid__meta { font-family: 'Geist', sans-serif; font-size: 13px; color: #97A0AC; margin: 0 0 8px; }
.ncco-bgrid__title {
  font-family: 'Geist', sans-serif;
  font-size: 18px; font-weight: 600;
  color: #081D3A; line-height: 1.4; letter-spacing: -0.3px;
  margin: 0 0 10px;
}
.ncco-bgrid__excerpt { font-family: 'Geist', sans-serif; font-size: 14px; color: #647082; line-height: 1.6; margin: 0 0 16px; flex: 1; }
.ncco-bgrid__read-more { font-family: 'Geist', sans-serif; font-size: 14px; font-weight: 600; color: #003da5; }

@media (max-width: 1600px) { .ncco-blog-grid { padding: 60px 80px; } }
@media (max-width: 1024px) {
  .ncco-blog-grid { padding: 48px 40px; }
  .ncco-bgrid__grid { grid-template-columns: repeat(2, 1fr); }
  .ncco-bgrid__heading { font-size: 32px; }
}
@media (max-width: 989px) {
  .ncco-blog-grid { padding: 48px 24px; }
  .ncco-bgrid__header { flex-direction: column; align-items: flex-start; gap: 16px; }
  .ncco-bgrid__subtext { text-align: left; max-width: 100%; }
  .ncco-bgrid__heading { font-size: 28px; }
}
@media (max-width: 600px) {
  .ncco-blog-grid { padding: 40px 16px; }
  .ncco-bgrid__grid { grid-template-columns: 1fr; }
  .ncco-bgrid__heading { font-size: 24px; }
  .ncco-bgrid__subtext { font-size: 14px; }
}
</style>

{% schema %}
{
  "name": "NCCO Blog Grid",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Latest Articles"},
    {"type": "textarea", "id": "subtext", "label": "Description (right side)"},
    {"type": "blog", "id": "blog", "label": "Blog"},
    {"type": "number", "id": "count", "label": "Number of articles", "default": 3}
  ],
  "presets": [{"name": "NCCO Blog Grid"}]
}
{% endschema %}
