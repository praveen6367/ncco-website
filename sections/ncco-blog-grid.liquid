{%- assign grid_blog = blogs[section.settings.blog] -%}
{%- if grid_blog == blank or grid_blog.articles.size == 0 -%}
  {%- assign grid_blog = blog -%}
{%- endif -%}

{%- assign count = section.settings.count | default: 12 -%}

<section class="ncco-bgrid-wrap">
  <div class="ncco-bgrid-container">
    <div class="ncco-bgrid-header">
      <div class="ncco-bgrid-header__left">
        {% if section.settings.eyebrow != blank %}
          <p class="ncco-bgrid-eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="ncco-bgrid-heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
      {% if section.settings.subtext != blank %}
        <p class="ncco-bgrid-subtext">{{ section.settings.subtext }}</p>
      {% endif %}
    </div>

    <div class="ncco-bgrid-cards">
      {%- assign fallback_imgs = 'case-hk-alliance-academy.png,case-grand-marais.png,case-hkjc-shatin.png,case-hkia.png,case-hsbc-datacenter.png,ncco-img-residential-room.png' | split: ',' -%}
      {% for article in grid_blog.articles limit: count %}
        {%- assign fallback_index = forloop.index0 | modulo: fallback_imgs.size -%}
        {%- assign fallback_asset = fallback_imgs[fallback_index] -%}
        <a href="{{ article.url }}" class="ncco-bcard" aria-label="{{ article.title }}">
          <div class="ncco-bcard__img-wrap">
            {% if article.image %}
              <img src="{{ article.image | image_url: width: 800 }}"
                   alt="{{ article.image.alt | default: article.title }}"
                   loading="lazy"
                   width="800"
                   height="500">
            {% else %}
              <img src="{{ fallback_asset | asset_url }}"
                   alt="{{ article.title }}"
                   loading="lazy"
                   width="800"
                   height="500">
            {% endif %}
          </div>

          <div class="ncco-bcard__badge-row">
            <span class="ncco-bcard__badge">{{ article.tags.first | default: '真實案例' }}</span>
            <span class="ncco-bcard__arrow" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                <path d="M3 11L11 3M11 3H5M11 3V9" stroke="#9CA3AF" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </div>

          <h3 class="ncco-bcard__title">{{ article.title }}</h3>

          <p class="ncco-bcard__excerpt">
            {{ article.excerpt_or_content | strip_html | truncate: 85 }}
          </p>

          <div class="ncco-bcard__footer">
            <span class="ncco-bcard__author">{{ article.author | default: 'NCCO' }}</span>
            <span class="ncco-bcard__dot">·</span>
            <span class="ncco-bcard__date">{{ article.published_at | date: '%B %d, %Y' }}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.ncco-bgrid-wrap {
  width: 100%;
  max-width: 100%;
  padding: 30px 16px 80px;
  background: #FFFFFF;
  box-sizing: border-box;
}

.ncco-bgrid-container {
  max-width: 1360px;
  margin: 0 auto;
  box-sizing: border-box;
}

.ncco-bgrid-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 32px;
  margin-bottom: 40px;
}

.ncco-bgrid-header__left {
  display: flex;
  flex-direction: column;
}

.ncco-bgrid-eyebrow {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  font-family: 'Geist', sans-serif;
  font-size: 14px;
  font-weight: 500;
  color: #647082;
  margin: 0 0 12px;
  letter-spacing: -0.2px;
}

.ncco-bgrid-eyebrow::before {
  content: '';
  display: block;
  width: 28px;
  height: 2px;
  background: #FECB07;
}

.ncco-bgrid-heading {
  font-family: 'Geist', sans-serif;
  font-size: clamp(32px, 3.2vw, 44px);
  font-weight: 700;
  letter-spacing: -1.2px;
  line-height: 1.15;
  color: #081D3A;
  margin: 0;
}

.ncco-bgrid-subtext {
  font-family: 'Geist', sans-serif;
  font-size: 15px;
  color: #081D3A;
  line-height: 1.5;
  margin: 0;
  max-width: 460px;
  text-align: right;
  align-self: flex-end;
}

/* Card Grid */
.ncco-bgrid-cards {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.ncco-bcard {
  background: #FFFFFF;
  border: 1px solid #E5E7EB;
  border-radius: 20px;
  padding: 16px;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
}

.ncco-bcard:hover {
  transform: translateY(-4px);
  border-color: #D1D5DB;
  box-shadow: 0 12px 32px rgba(8, 29, 58, 0.07);
}

.ncco-bcard__img-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 10;
  border-radius: 12px;
  overflow: hidden;
  background: #F3F4F6;
  margin-bottom: 16px;
}

.ncco-bcard__img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease;
}

.ncco-bcard:hover .ncco-bcard__img-wrap img {
  transform: scale(1.03);
}

.ncco-bcard__badge-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.ncco-bcard__badge {
  display: inline-block;
  border: 1px solid #E5E7EB;
  border-radius: 20px;
  padding: 3px 12px;
  font-family: 'Geist', sans-serif;
  font-size: 12px;
  font-weight: 400;
  color: #647082;
  background: #FFFFFF;
  letter-spacing: -0.1px;
}

.ncco-bcard__arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #9CA3AF;
  transition: transform 0.2s ease, color 0.2s ease;
}

.ncco-bcard:hover .ncco-bcard__arrow {
  color: #081D3A;
  transform: translate(2px, -2px);
}

.ncco-bcard__title {
  font-family: 'Geist', sans-serif;
  font-size: 18px;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: -0.3px;
  color: #081D3A;
  margin: 0 0 10px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 2.8em;
}

.ncco-bcard__excerpt {
  font-family: 'Geist', sans-serif;
  font-size: 13px;
  font-weight: 400;
  line-height: 1.55;
  color: #647082;
  margin: 0 0 16px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  flex: 1;
}

.ncco-bcard__footer {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: 'Geist', sans-serif;
  font-size: 12px;
  color: #97A0AC;
  margin-top: auto;
  padding-top: 4px;
}

.ncco-bcard__dot {
  color: #97A0AC;
}

@media (max-width: 1024px) {
  .ncco-bgrid-cards {
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
}

@media (max-width: 768px) {
  .ncco-bgrid-wrap {
    padding: 24px 12px 60px;
  }
  .ncco-bgrid-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 28px;
  }
  .ncco-bgrid-subtext {
    text-align: left;
    max-width: 100%;
    align-self: flex-start;
  }
  .ncco-bgrid-cards {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .ncco-bcard {
    padding: 14px;
  }
  .ncco-bcard__title {
    font-size: 17px;
    min-height: auto;
  }
}
</style>

{% schema %}
{
  "name": "NCCO Blog Grid",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "最新發布"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "最新文章"},
    {"type": "textarea", "id": "subtext", "label": "Description (right side)", "default": "讓你隨時掌握「點樣令空氣更安全、更安心」的第一手資訊。"},
    {"type": "blog", "id": "blog", "label": "Blog"},
    {"type": "number", "id": "count", "label": "Number of articles", "default": 12}
  ],
  "presets": [{"name": "NCCO Blog Grid"}]
}
{% endschema %}
