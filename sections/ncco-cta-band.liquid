<section class="ncco-cta-band" style="background:{{ section.settings.bg_color | default: 'var(--ncco-navy)' }}">
  <div class="ncco-container ncco-cta-band__inner ncco-reveal">
    {% if section.settings.eyebrow != blank %}
      <p class="ncco-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="ncco-cta-band__title">{{ section.settings.heading }}</h2>
    {% if section.settings.subtext != blank %}
      <p class="ncco-cta-band__sub">{{ section.settings.subtext }}</p>
    {% endif %}
    {% if section.settings.cta_label != blank %}
      <a href="{{ section.settings.cta_url }}" class="ncco-btn-yellow">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>
</section>

<style>
.ncco-cta-band { padding: 80px 0; color: #fff; }
.ncco-cta-band__inner { text-align: center; padding: 0 24px; }
.ncco-cta-band__title { font-size: 36px; font-weight: 600; letter-spacing: -1px; color: var(--ncco-yellow); margin-bottom: 16px; }
.ncco-cta-band__sub { font-size: 16px; line-height: 1.65; opacity: 0.8; max-width: 560px; margin: 0 auto 32px; }
@media (max-width: 989px) {
  .ncco-cta-band { padding: 64px 0; }
  .ncco-cta-band__title { font-size: 32px; letter-spacing: -0.8px; }
  .ncco-cta-band__sub { font-size: 15px; }
}
@media (max-width: 600px) {
  .ncco-cta-band { padding: 48px 0; }
  .ncco-cta-band__inner { padding: 0 16px; }
  .ncco-cta-band__title { font-size: 24px; letter-spacing: -0.5px; }
  .ncco-cta-band__sub { font-size: 14px; max-width: 100%; }
}
</style>

{% schema %}
{
  "name": "NCCO CTA Band",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "textarea", "id": "subtext", "label": "Subtext"},
    {"type": "text", "id": "cta_label", "label": "Button text"},
    {"type": "url", "id": "cta_url", "label": "Button URL"},
    {"type": "color", "id": "bg_color", "label": "Background colour", "default": "#081d3a"}
  ],
  "presets": [{"name": "NCCO CTA Band"}]
}
{% endschema %}
