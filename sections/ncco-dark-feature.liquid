{%- assign accent = section.settings.accent_color | default: '#FECB07' -%}
{%- assign cta_variant = section.settings.cta_variant | default: 'yellow' -%}
{%- assign bullet_blocks = section.blocks | where: 'type', 'bullet' -%}
{%- assign image_blocks = section.blocks | where: 'type', 'image' -%}
<section class="ncco-dfeat" style="--brand-accent:{{ accent }}">
  <div class="ncco-dfeat__inner">
    <div class="ncco-dfeat__head ncco-reveal">
      {% if section.settings.eyebrow != blank %}
        <div class="ncco-dfeat__eyebrow-wrap">
          <span class="ncco-dfeat__eyebrow-bar"></span>
          <p class="ncco-dfeat__eyebrow">{{ section.settings.eyebrow }}</p>
        </div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="ncco-dfeat__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.body != blank %}
        <p class="ncco-dfeat__body">{{ section.settings.body }}</p>
      {% endif %}
    </div>

    {% if bullet_blocks.size > 0 %}
      <ul class="ncco-dfeat__bullets ncco-reveal ncco-reveal--d1">
        {% for block in bullet_blocks %}
          <li class="ncco-dfeat__bullet" {{ block.shopify_attributes }}>
            <span class="ncco-dfeat__bullet-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M8 1L9.8 6.2L15 6.2L10.8 9.4L12.4 14.6L8 11.4L3.6 14.6L5.2 9.4L1 6.2L6.2 6.2L8 1Z" fill="currentColor"/>
              </svg>
            </span>
            <span class="ncco-dfeat__bullet-text">{{ block.settings.text }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if image_blocks.size > 0 %}
      <div class="ncco-dfeat__images">
        {% for block in image_blocks %}
          <div class="ncco-dfeat__img-wrap ncco-reveal ncco-reveal--d{{ forloop.index | plus: 1 }}" {{ block.shopify_attributes }}>
            {% if block.settings.asset != blank %}
              <img src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.alt }}" loading="lazy">
            {% elsif block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.alt }}" loading="lazy">
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.cta_label != blank %}
      <div class="ncco-dfeat__cta ncco-reveal ncco-reveal--d4">
        {%- render 'ncco-cta', label: section.settings.cta_label, url: section.settings.cta_url, variant: cta_variant -%}
      </div>
    {% endif %}
  </div>
</section>

<style>
.ncco-dfeat {
  padding: 100px 40px;
  background: #0D2544;
  color: #fff;
}
.ncco-dfeat__inner {
  max-width: 1440px; margin: 0 auto;
  display: flex; flex-direction: column; align-items: center; gap: 50px;
}
.ncco-dfeat__head {
  display: flex; flex-direction: column; align-items: center; gap: 20px;
  text-align: center; max-width: 900px;
}
.ncco-dfeat__eyebrow-wrap {
  display: flex; flex-direction: column; align-items: center; gap: 8px;
}
.ncco-dfeat__eyebrow-bar {
  display: block; width: 28px; height: 2px; background: var(--brand-accent, #FECB07);
}
.ncco-dfeat__eyebrow {
  font-family: 'Geist', sans-serif;
  font-size: 14px; font-weight: 500; letter-spacing: 0.4px;
  color: #fff; text-transform: uppercase; margin: 0;
}
.ncco-dfeat__heading {
  font-family: 'Geist', sans-serif;
  font-size: 50px; font-weight: 500; line-height: 60px;
  color: #fff; margin: 0;
  letter-spacing: -1.4px;
}
.ncco-dfeat__body {
  font-family: 'Geist', sans-serif;
  font-size: 16px; font-weight: 400; line-height: 24px;
  color: #97A0AC; margin: 0;
  max-width: 640px;
}

/* Bullets row */
.ncco-dfeat__bullets {
  list-style: none; padding: 0; margin: 0;
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px;
  width: 100%;
}
.ncco-dfeat__bullet {
  display: flex; align-items: flex-start; gap: 12px;
}
.ncco-dfeat__bullet-icon {
  width: 32px; height: 32px; flex-shrink: 0;
  border-radius: 9999px;
  background: rgba(254, 203, 7, 0.15);
  display: inline-flex; align-items: center; justify-content: center;
  color: var(--brand-accent, #FECB07);
}
.ncco-dfeat__bullet-icon svg { width: 14px; height: 14px; }
.ncco-dfeat__bullet-text {
  font-family: 'Geist', sans-serif;
  font-size: 15px; font-weight: 500; line-height: 22px;
  color: #fff;
}

/* Images row: 3 col grid, center wide */
.ncco-dfeat__images {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 2fr 1fr;
  gap: 16px;
}
.ncco-dfeat__img-wrap {
  border-radius: 20px;
  overflow: hidden;
  background: rgba(255,255,255,0.03);
}
.ncco-dfeat__images > .ncco-dfeat__img-wrap:nth-child(1),
.ncco-dfeat__images > .ncco-dfeat__img-wrap:nth-child(3) { aspect-ratio: 300 / 340; }
.ncco-dfeat__images > .ncco-dfeat__img-wrap:nth-child(2) { aspect-ratio: 600 / 340; }
.ncco-dfeat__img-wrap img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: transform 0.5s ease;
}
.ncco-dfeat__img-wrap:hover img { transform: scale(1.04); }

.ncco-dfeat__cta { display: flex; justify-content: center; }

@media (max-width: 1024px) {
  .ncco-dfeat { padding: 80px 24px; }
  .ncco-dfeat__heading { font-size: 40px; line-height: 50px; }
  .ncco-dfeat__bullets { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 600px) {
  .ncco-dfeat { padding: 60px 16px; }
  .ncco-dfeat__heading { font-size: 30px; line-height: 40px; }
  .ncco-dfeat__bullets { grid-template-columns: 1fr; }
  .ncco-dfeat__images { grid-template-columns: 1fr; }
  .ncco-dfeat__images > .ncco-dfeat__img-wrap:nth-child(1),
  .ncco-dfeat__images > .ncco-dfeat__img-wrap:nth-child(2),
  .ncco-dfeat__images > .ncco-dfeat__img-wrap:nth-child(3) { aspect-ratio: 16 / 10; }
}
</style>

{% schema %}
{
  "name": "NCCO Dark Feature",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "textarea", "id": "body", "label": "Body text"},
    {"type": "text", "id": "cta_label", "label": "CTA button text"},
    {"type": "url", "id": "cta_url", "label": "CTA URL"},
    {"type": "select", "id": "cta_variant", "label": "CTA style", "options": [
      {"value": "yellow", "label": "Yellow"},
      {"value": "blue", "label": "Blue"},
      {"value": "teal", "label": "Teal"}
    ], "default": "yellow"},
    {"type": "text", "id": "accent_color", "label": "Accent color (hex)", "default": "#FECB07"}
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Bullet item",
      "settings": [
        {"type": "text", "id": "text", "label": "Bullet text"}
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {"type": "image_picker", "id": "image", "label": "Image"},
        {"type": "text", "id": "asset", "label": "Or asset filename"},
        {"type": "text", "id": "alt", "label": "Alt text"}
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{"name": "NCCO Dark Feature"}]
}
{% endschema %}
