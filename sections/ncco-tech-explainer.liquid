<section class="ncco-tech">
  <div class="ncco-container">
    <div class="ncco-tech__wrap">

      <div class="ncco-tech__header">
        {% if section.settings.eyebrow != blank %}
          <p class="ncco-tech__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="ncco-tech__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subtext != blank %}
          <p class="ncco-tech__sub">{{ section.settings.subtext }}</p>
        {% endif %}
      </div>

      <!-- 3-column staggered steps -->
      {% assign step_assets = 'tech-step-1.png,tech-step-2.png,tech-step-3.png' | split: ',' %}
      <div class="ncco-tech__steps">
        {% for block in section.blocks %}
          <div class="ncco-tech__step{% if forloop.index == 2 %} ncco-tech__step--low{% endif %}" {{ block.shopify_attributes }}>
            <div class="ncco-tech__img-wrap">
              {% if block.settings.image != blank %}
                <img src="{{ block.settings.image | image_url: width: 700 }}"
                     alt="{{ block.settings.caption }}" loading="lazy">
              {% elsif step_assets[forloop.index0] != blank %}
                <img src="{{ step_assets[forloop.index0] | asset_url }}"
                     alt="{{ block.settings.caption }}" loading="lazy">
              {% else %}
                <div class="ncco-tech__img-placeholder"></div>
              {% endif %}
            </div>
            <div class="ncco-tech__caption">
              <span class="ncco-tech__num">0{{ forloop.index }}</span>
              <span class="ncco-tech__cap-text">{{ block.settings.caption }}</span>
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Simplified explanation box -->
      {% if section.settings.explain_1 != blank or section.settings.explain_2 != blank %}
        <div class="ncco-tech__explainer">
          <p class="ncco-tech__explainer-label">SIMPLIFIED EXPLANATION:</p>
          <div class="ncco-tech__explainer-grid">
            {% if section.settings.explain_1 != blank %}
              <div class="ncco-tech__explainer-item">
                <span class="ncco-tech__star-wrap" aria-hidden="true">
                  <span class="ncco-tech__star">✦</span>
                </span>
                <p>{{ section.settings.explain_1 }}</p>
              </div>
            {% endif %}
            {% if section.settings.explain_2 != blank %}
              <div class="ncco-tech__explainer-item">
                <span class="ncco-tech__star-wrap" aria-hidden="true">
                  <span class="ncco-tech__star">✦</span>
                </span>
                <p>{{ section.settings.explain_2 }}</p>
              </div>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        {%- render 'ncco-cta', label: section.settings.cta_label, url: section.settings.cta_url, variant: 'blue', class: 'ncco-tech__cta' -%}
      {% endif %}

    </div>
  </div>
</section>

<style>
/* ── Figma Capture + Breakdown (1423:25548, 1920×1154) ── */
.ncco-tech { padding: 120px 240px; background: #fff; }
.ncco-tech .ncco-container { max-width: 100%; padding: 0; }

/* Desktop: header left, CTA right, steps + explainer full-width below */
.ncco-tech__wrap {
  display: grid;
  grid-template-columns: 1fr auto;
  grid-template-rows: auto auto auto;
  grid-template-areas: "header cta" "steps steps" "explainer explainer";
  column-gap: 48px;
  row-gap: 70px;
  align-items: start;
}
.ncco-tech__header   { grid-area: header; max-width: 900px; }
.ncco-tech__cta      { grid-area: cta; align-self: center; }
.ncco-tech__steps    { grid-area: steps; }
.ncco-tech__explainer { grid-area: explainer; }

.ncco-tech__eyebrow {
  font-family: 'Geist', sans-serif;
  font-size: 16px; font-weight: 500; letter-spacing: -0.32px;
  color: #647082; text-transform: uppercase; margin: 0 0 40px;
}
.ncco-tech__eyebrow::before {
  content: ''; display: block; width: 28px; height: 2px; background: #FECB07; margin-bottom: 8px;
}
.ncco-tech__heading {
  font-family: 'Geist', sans-serif;
  font-size: 58px; font-weight: 500; line-height: 68px; letter-spacing: -2.32px;
  color: #081D3A; margin: 0 0 20px;
}
.ncco-tech__sub {
  font-family: 'Geist', sans-serif;
  font-size: 18px; font-weight: 400; line-height: 24px; letter-spacing: -0.36px;
  color: #647082; margin: 0;
}

/* Steps grid — 3 columns, middle taller (staggered visually via aspect ratio) */
.ncco-tech__steps {
  display: grid;
  grid-template-columns: 1.15fr 0.95fr 1.15fr;
  gap: 40px; align-items: start;
}
.ncco-tech__step { display: flex; flex-direction: column; }
.ncco-tech__img-wrap img,
.ncco-tech__img-placeholder {
  width: 100%; aspect-ratio: 5 / 4; object-fit: cover;
  border-radius: 24px; display: block;
}
/* Middle image is taller (square) */
.ncco-tech__step:nth-child(2) .ncco-tech__img-wrap img,
.ncco-tech__step--low .ncco-tech__img-wrap img,
.ncco-tech__step:nth-child(2) .ncco-tech__img-placeholder,
.ncco-tech__step--low .ncco-tech__img-placeholder { aspect-ratio: 1 / 1; }
.ncco-tech__img-placeholder { background: #dde0e8; }

.ncco-tech__caption {
  display: flex; align-items: baseline; gap: 16px; margin-top: 24px;
}
.ncco-tech__num {
  font-family: 'Geist', sans-serif;
  font-size: 42px; font-weight: 500; letter-spacing: -1.68px; line-height: 1;
  color: #D7D9DC; flex-shrink: 0;
}
.ncco-tech__cap-text {
  font-family: 'Geist', sans-serif;
  font-size: 16px; font-weight: 400; line-height: 24px; letter-spacing: -0.32px;
  color: #647082;
}

/* Simplified explanation white card */
.ncco-tech__explainer {
  background: #fff;
  border-radius: 24px;
  border: 1px solid rgba(100,112,130,0.12);
  box-shadow: 0 16px 24px rgba(8,29,58,0.04);
  padding: 32px 40px;
}
.ncco-tech__explainer-label {
  font-family: 'Geist', sans-serif;
  font-size: 14px; font-weight: 500; letter-spacing: -0.28px;
  color: #081D3A; text-transform: uppercase; margin: 0 0 20px;
}
.ncco-tech__explainer-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 60px; }
.ncco-tech__explainer-item { display: flex; align-items: flex-start; gap: 16px; }
.ncco-tech__star-wrap {
  flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%;
  background: radial-gradient(circle, rgba(254,203,7,0.35) 0%, rgba(254,203,7,0.1) 55%, transparent 100%);
  display: flex; align-items: center; justify-content: center; margin-top: 1px;
}
.ncco-tech__star { color: #FECB07; font-size: 14px; line-height: 1; }
.ncco-tech__explainer-item p {
  font-family: 'Geist', sans-serif;
  font-size: 16px; line-height: 24px; letter-spacing: -0.32px;
  color: #647082; margin: 0;
}

@media (max-width: 1600px) { .ncco-tech { padding: 100px 80px; } }
@media (max-width: 1200px) {
  .ncco-tech { padding: 80px 40px; }
  .ncco-tech__heading { font-size: 44px; line-height: 52px; letter-spacing: -1.5px; }
}
@media (max-width: 989px) {
  .ncco-tech { padding: 60px 24px; }
  .ncco-tech__wrap {
    grid-template-columns: 1fr;
    grid-template-areas: "header" "steps" "explainer" "cta";
    row-gap: 48px;
  }
  .ncco-tech__steps { grid-template-columns: 1fr; gap: 32px; }
  .ncco-tech__step:nth-child(2) .ncco-tech__img-wrap img { aspect-ratio: 5 / 4; }
  .ncco-tech__explainer-grid { grid-template-columns: 1fr; gap: 20px; }
  .ncco-tech__heading { font-size: 36px; line-height: 44px; letter-spacing: -1.2px; }
  .ncco-tech__sub { font-size: 16px; }
}
@media (max-width: 600px) {
  .ncco-tech { padding: 40px 16px; }

  /* Center header */
  .ncco-tech__header { text-align: center; }
  .ncco-tech__eyebrow { display: flex; flex-direction: column; align-items: center; }
  .ncco-tech__eyebrow::before { margin-bottom: 8px; }
  .ncco-tech__heading { font-size: 28px; line-height: 36px; letter-spacing: -0.8px; }
  .ncco-tech__sub { font-size: 15px; }

  /* Horizontal scroll steps */
  .ncco-tech__steps {
    display: flex;
    flex-direction: row;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    gap: 12px;
    padding-bottom: 4px;
    scrollbar-width: none;
    align-items: start;
  }
  .ncco-tech__steps::-webkit-scrollbar { display: none; }
  .ncco-tech__step {
    flex: 0 0 calc(75vw - 28px);
    scroll-snap-align: start;
  }
  .ncco-tech__step--low { padding-top: 0 !important; }
  .ncco-tech__img-wrap img,
  .ncco-tech__img-placeholder { aspect-ratio: 4 / 3 !important; border-radius: 16px; }
  .ncco-tech__num { font-size: 32px; }
  .ncco-tech__caption { margin-top: 16px; gap: 12px; }

  /* Full-width CTA */
  .ncco-tech__cta { width: 100% !important; }
  .ncco-tech .ncco-cta { width: 100%; justify-content: space-between; }
}
</style>

{% schema %}
{
  "name": "NCCO Tech Explainer",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "HOW IT WORK"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Capture + Breakdown"},
    {"type": "textarea", "id": "subtext", "label": "Subtext", "default": "Oxygen Polymerization Decomposition Technology"},
    {"type": "text", "id": "cta_label", "label": "CTA label", "default": "Explore NCCO Technology"},
    {"type": "url", "id": "cta_url", "label": "CTA URL"},
    {"type": "header", "content": "Simplified Explanation"},
    {"type": "textarea", "id": "explain_1", "label": "Point 1", "default": "The NCCO layer reacts with active oxygen to break down harmful pollutants into water and carbon dioxide."},
    {"type": "textarea", "id": "explain_2", "label": "Point 2", "default": "This enables continuous filter regeneration and ensures high-efficiency air purification."}
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {"type": "image_picker", "id": "image", "label": "Photo"},
        {"type": "textarea", "id": "caption", "label": "Caption"}
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{"name": "NCCO Tech Explainer", "blocks": [{"type": "step"}, {"type": "step"}, {"type": "step"}]}]
}
{% endschema %}
