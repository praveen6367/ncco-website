{%- assign _flat = false -%}
{%- if section.settings.bg_image == blank -%}{%- assign _flat = true -%}{%- endif -%}
{%- assign faq_accent = section.settings.accent_color | default: '#FECB07' -%}
<section class="ncco-faq{% if _flat %} ncco-faq--flat{% if section.settings.three_col %} ncco-faq--3col{% endif %}{% endif %}" style="--ncco-accent:{{ faq_accent }}{% if section.settings.bg_image != blank %};background-image:url('{{ section.settings.bg_image | asset_url }}'){% endif %}">

  <div class="ncco-faq__card">
    {% if section.settings.eyebrow != blank %}
      <p class="ncco-faq__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h2 class="ncco-faq__heading">{{ section.settings.heading | default: 'All You Need To Know' }}</h2>

    <div class="ncco-faq__accordion">
      {% for block in section.blocks %}
        <div class="ncco-faq__item{% if forloop.first %} is-open{% endif %}" {{ block.shopify_attributes }}>
          <button class="ncco-faq__trigger" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
            <span class="ncco-faq__question">{{ block.settings.heading }}</span>
            <span class="ncco-faq__icon" aria-hidden="true">+</span>
          </button>
          <div class="ncco-faq__answer">
            <div class="ncco-faq__answer-inner">{{ block.settings.answer }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
/* ── Figma FAQ (1545:13358, 1920×951) — outer 16px gutter + 32px radius ── */
.ncco-faq {
  position: relative;
  min-height: 780px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 80px 60px;
  margin: 0 16px;
  border-radius: 32px;
  box-sizing: border-box;
  background-size: cover;
  background-position: center;
  background-attachment: scroll;
  background-color: #081D3A;
  overflow: hidden;
}

.ncco-faq__card {
  position: relative;
  z-index: 1;
  width: min(880px, 100%);
  background: #081D3A;
  border-radius: 32px;
  padding: 56px;
  box-sizing: border-box;
}

.ncco-faq__heading {
  font-family: 'Geist', sans-serif;
  font-size: 42px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: -0.84px;
  line-height: 1.1;
  color: #ffffff;
  margin: 0 0 40px;
}

.ncco-faq__accordion {
  display: flex;
  flex-direction: column;
}

.ncco-faq__item {
  border-top: 1px solid rgba(255,255,255,0.1);
}
.ncco-faq__item:last-child {
  border-bottom: 1px solid rgba(255,255,255,0.1);
}

.ncco-faq__trigger {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  background: none;
  border: none;
  padding: 22px 0;
  cursor: pointer;
  text-align: left;
}

.ncco-faq__question {
  font-family: 'Geist', sans-serif;
  font-size: 18px;
  font-weight: 500;
  letter-spacing: -0.36px;
  color: #ffffff;
  line-height: 1.4;
  flex: 1;
}

.ncco-faq__icon {
  flex-shrink: 0;
  color: #ffffff;
  font-size: 24px;
  font-weight: 300;
  line-height: 1;
  width: 20px;
  text-align: center;
}

.ncco-faq__answer {
  overflow: hidden;
  max-height: 0;
  transition: max-height 0.35s ease;
}

.ncco-faq__item.is-open .ncco-faq__answer {
  max-height: 400px;
}

.ncco-faq__answer-inner {
  font-family: 'Geist', sans-serif;
  font-size: 16px;
  color: #647082;
  line-height: 1.6;
  padding: 0 0 22px;
}
.ncco-faq__answer-inner p { margin: 0; }

/* ── Flat 2-col variant (About Us "Frequently Asked Questions") ── */
.ncco-faq--flat {
  background: #fff; background-color: #fff;
  margin: 0; border-radius: 0; padding: 100px 240px;
  min-height: 0; display: block; justify-content: initial; align-items: initial;
  background-attachment: initial;
}
.ncco-faq--flat .ncco-faq__card {
  background: transparent; border-radius: 0; padding: 0; width: 100%;
}
.ncco-faq__eyebrow {
  font-family: 'Geist', sans-serif; font-size: 13px; font-weight: 500;
  letter-spacing: 0.5px; text-transform: uppercase; color: var(--ncco-accent, #FECB07);
  margin: 0 0 16px; text-align: center;
}
.ncco-faq--flat .ncco-faq__eyebrow { color: var(--ncco-accent, #FECB07); }
.ncco-faq--flat .ncco-faq__heading {
  color: #081D3A; text-align: center; margin: 0 0 56px;
}
.ncco-faq--flat .ncco-faq__accordion {
  display: grid; grid-template-columns: 1fr 1fr; column-gap: 60px; row-gap: 0;
}
.ncco-faq--flat.ncco-faq--3col .ncco-faq__accordion {
  grid-template-columns: 1fr 1fr 1fr; column-gap: 30px;
}
.ncco-faq--flat .ncco-faq__item { border-top-color: rgba(8,29,58,0.1); }
.ncco-faq--flat .ncco-faq__item:last-child { border-bottom-color: rgba(8,29,58,0.1); }
.ncco-faq--flat .ncco-faq__question { color: #081D3A; }
.ncco-faq--flat .ncco-faq__icon { color: #081D3A; }
.ncco-faq--flat .ncco-faq__answer-inner { color: #647082; }
@media (max-width: 1600px) {
  .ncco-faq--flat { padding: 80px 80px; }
  .ncco-faq--flat.ncco-faq--3col .ncco-faq__accordion { column-gap: 24px; }
}
@media (max-width: 1200px) {
  .ncco-faq--flat.ncco-faq--3col .ncco-faq__accordion { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 989px) {
  .ncco-faq--flat { padding: 60px 24px; }
  .ncco-faq--flat .ncco-faq__accordion { grid-template-columns: 1fr; column-gap: 0; }
  .ncco-faq--flat .ncco-faq__heading { font-size: 34px; letter-spacing: -0.8px; }
  .ncco-faq {
    padding: 48px 24px;
    margin: 0 8px;
    border-radius: 24px;
    min-height: 0;
    justify-content: center;
    align-items: flex-end;
  }
  .ncco-faq__card {
    width: 100%;
    border-radius: 20px;
    padding: 40px 32px;
  }
  .ncco-faq__heading { font-size: 30px; letter-spacing: -0.6px; }
  .ncco-faq__question { font-size: 16px; }
  .ncco-faq__answer-inner { font-size: 14px; }
}
@media (max-width: 600px) {
  .ncco-faq--flat { padding: 40px 16px; }
  .ncco-faq--flat .ncco-faq__heading { font-size: 26px; }
  .ncco-faq {
    padding: 32px 16px;
    margin: 0 8px;
    border-radius: 20px;
    min-height: 0;
  }
  .ncco-faq__card {
    border-radius: 16px;
    padding: 24px 16px;
  }
  .ncco-faq__heading { font-size: 28px; letter-spacing: -0.6px; }
  .ncco-faq__question { font-size: 15px; }
}
</style>

<script>
(function() {
  function initFaq() {
    var items = document.querySelectorAll('.ncco-faq__item');
    items.forEach(function(item) {
      var btn = item.querySelector('.ncco-faq__trigger');
      var icon = item.querySelector('.ncco-faq__icon');
      if (!btn) return;
      btn.addEventListener('click', function() {
        var isOpen = item.classList.contains('is-open');
        items.forEach(function(i) {
          i.classList.remove('is-open');
          var b = i.querySelector('[aria-expanded]');
          var ic = i.querySelector('.ncco-faq__icon');
          if (b) b.setAttribute('aria-expanded', 'false');
          if (ic) ic.textContent = '+';
        });
        if (!isOpen) {
          item.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          if (icon) icon.textContent = '−';
        }
      });
      if (item.classList.contains('is-open') && icon) icon.textContent = '−';
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaq);
  } else {
    initFaq();
  }
})();
</script>

{% schema %}
{
  "name": "NCCO FAQ",
  "tag": "section",
  "settings": [
    {"type": "text",     "id": "eyebrow",  "label": "Eyebrow"},
    {"type": "text",     "id": "accent_color", "label": "Accent color (hex, default #FECB07 yellow)"},
    {"type": "text",     "id": "heading",  "label": "Heading",           "default": "All You Need To Know"},
    {"type": "text",     "id": "bg_image",   "label": "Background image filename (assets/)"},
    {"type": "checkbox", "id": "three_col", "label": "3-column layout (flat only)", "default": false}
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {"type": "text",     "id": "heading", "label": "Question"},
        {"type": "richtext", "id": "answer",  "label": "Answer"}
      ]
    }
  ],
  "presets": [{"name": "NCCO FAQ"}]
}
{% endschema %}
