{%- assign _has_bg = false -%}
{%- if section.settings.bg_image != blank -%}{%- assign _has_bg = true -%}{%- endif -%}
{%- assign faq_accent = section.settings.accent_color | default: '#FECB07' -%}

<section class="ncco-faq-wrap{% if _has_bg %} ncco-faq-wrap--hero{% endif %}" style="--ncco-accent:{{ faq_accent }}">
  {% if _has_bg %}
    <div class="ncco-faq" style="background-image:url('{{ section.settings.bg_image | asset_url }}');">
      <div class="ncco-faq__card">
        {% if section.settings.eyebrow != blank %}
          <p class="ncco-faq__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 class="ncco-faq__heading">{{ section.settings.heading | default: 'All You Need To Know' }}</h2>

        <div class="ncco-faq__accordion">
          {% for block in section.blocks %}
            <div class="ncco-faq__item{% if forloop.first %} is-open{% endif %}" {{ block.shopify_attributes }}>
              <button type="button" class="ncco-faq__trigger" onclick="window.toggleFaq(this, event)" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
                <span class="ncco-faq__question">{{ block.settings.heading }}</span>
                <span class="ncco-faq__icon" aria-hidden="true">+</span>
              </button>
              <div class="ncco-faq__answer">
                <div class="ncco-faq__answer-inner">{{ block.settings.answer }}</div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  {% else %}
    <div class="ncco-faq-white">
      <div class="ncco-faq__header">
        <span class="ncco-faq__dash" aria-hidden="true" style="display:block;width:38px;height:3px;background:#FECB07;border-radius:2px;margin:0 auto 12px auto;"></span>
        {% if section.settings.eyebrow != blank %}
          <p class="ncco-faq__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        <h2 class="ncco-faq__heading">{{ section.settings.heading | default: 'Frequently Asked Questions' }}</h2>
      </div>
      <div class="ncco-faq__grid">
        {% for block in section.blocks %}
          <div class="ncco-faq__item{% if forloop.first %} is-open{% endif %}" {{ block.shopify_attributes }}>
            <button type="button" class="ncco-faq__trigger" onclick="window.toggleFaq(this, event)" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
              <span class="ncco-faq__question">{{ block.settings.heading }}</span>
              <span class="ncco-faq__icon" aria-hidden="true">{% if forloop.first %}−{% else %}+{% endif %}</span>
            </button>
            <div class="ncco-faq__answer">
              <div class="ncco-faq__answer-inner">{{ block.settings.answer }}</div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>

<style>
.ncco-faq-wrap {
  width: 100%;
  max-width: 1360px;
  margin: 36px auto;
  padding: 0 16px;
  box-sizing: border-box;
}

.ncco-faq-wrap--hero {
  max-width: 100%;
  padding: 0;
  margin: 12px 0 44px;
}

/* ── Hero FAQ variant (homepage with background image) ── */
.ncco-faq {
  position: relative;
  min-height: 780px;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 80px 60px;
  margin: 0 16px;
  border-radius: 32px;
  box-sizing: border-box;
  background-size: cover;
  background-position: center;
  background-attachment: scroll;
  background-color: #081D3A;
  overflow: hidden;
}

.ncco-faq__card {
  position: relative;
  z-index: 1;
  width: min(616px, 100%);
  background: #081D3A;
  border-radius: 32px;
  padding: 48px;
  box-sizing: border-box;
}

/* ── White 3-Column FAQ variant (About Us page matching reference UI) ── */
.ncco-faq-white {
  width: 100%;
  background: #FFFFFF;
}

.ncco-faq__header {
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56px;
}

.ncco-faq__dash {
  width: 32px;
  height: 3px;
  background: #FECB07;
  border-radius: 2px;
  margin: 0 auto 12px auto;
  display: block;
}

.ncco-faq-white .ncco-faq__eyebrow {
  font-family: 'Geist', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: #647082;
  margin: 0 0 14px;
  text-align: center;
}

.ncco-faq-white .ncco-faq__heading {
  font-family: 'Geist', sans-serif;
  font-size: 42px;
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: -1.2px;
  color: #081D3A;
  margin: 0;
  text-align: center;
}

.ncco-faq__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  column-gap: 56px;
  row-gap: 0;
  align-items: start;
}

.ncco-faq-white .ncco-faq__item {
  border-top: 1px solid #ECEEF0;
  border-bottom: 1px solid #ECEEF0;
  padding: 0;
  box-sizing: border-box;
  margin-bottom: -1px;
}

.ncco-faq-white .ncco-faq__trigger {
  width: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  background: none;
  border: none;
  padding: 24px 0 20px;
  cursor: pointer !important;
  text-align: left;
}

.ncco-faq-white .ncco-faq__trigger * {
  pointer-events: none;
}

.ncco-faq-white .ncco-faq__question {
  font-family: 'Geist', sans-serif;
  font-size: 15.5px;
  font-weight: 600;
  color: #081D3A;
  line-height: 1.35;
  letter-spacing: -0.2px;
  flex: 1;
  margin: 0;
}

.ncco-faq-white .ncco-faq__icon {
  width: 28px;
  height: 28px;
  min-width: 28px;
  background: #EEF0F3;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: -2px;
  font-size: 18px;
  font-weight: 400;
  color: #081D3A;
  line-height: 1;
  transition: background 0.2s ease, color 0.2s ease;
}

.ncco-faq-white .ncco-faq__trigger:hover .ncco-faq__icon {
  background: #E2E5EA;
}

.ncco-faq-white .ncco-faq__answer,
.ncco-faq__card .ncco-faq__answer {
  overflow: hidden;
  max-height: 0;
  transition: max-height 0.35s ease, opacity 0.25s ease;
  opacity: 0;
}

.ncco-faq__item.is-open > .ncco-faq__answer {
  max-height: 800px !important;
  opacity: 1 !important;
}

.ncco-faq-white .ncco-faq__answer-inner {
  font-family: 'Geist', sans-serif;
  font-size: 13.5px;
  font-weight: 400;
  color: #647082;
  line-height: 1.6;
  padding: 0 0 24px 0;
}

.ncco-faq-white .ncco-faq__answer-inner p {
  margin: 0 0 10px;
}
.ncco-faq-white .ncco-faq__answer-inner p:last-child {
  margin-bottom: 0;
}

/* ── Hero FAQ variant styles ── */
.ncco-faq .ncco-faq__heading {
  font-family: 'Geist', sans-serif;
  font-size: 42px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: -0.84px;
  line-height: 1.1;
  color: #ffffff;
  margin: 0 0 40px;
}

.ncco-faq .ncco-faq__eyebrow {
  font-family: 'Geist', sans-serif;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: #FECB07;
  margin: 0 0 12px;
}

.ncco-faq__card .ncco-faq__item {
  border-top: 1px solid rgba(255,255,255,0.12);
}
.ncco-faq__card .ncco-faq__item:last-child {
  border-bottom: 1px solid rgba(255,255,255,0.12);
}

.ncco-faq__card .ncco-faq__trigger {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  background: none;
  border: none;
  padding: 22px 0;
  cursor: pointer;
  text-align: left;
}

.ncco-faq__card .ncco-faq__question {
  font-family: 'Geist', sans-serif;
  font-size: 17.5px;
  font-weight: 600;
  letter-spacing: -0.3px;
  color: #ffffff;
  line-height: 1.4;
  flex: 1;
}

.ncco-faq__card .ncco-faq__icon {
  flex-shrink: 0;
  color: #ffffff;
  font-size: 22px;
  font-weight: 300;
  line-height: 1;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.25s ease;
}

.ncco-faq__card .ncco-faq__answer {
  overflow: hidden;
  max-height: 0;
  transition: max-height 0.35s ease;
}

.ncco-faq__card .ncco-faq__item.is-open .ncco-faq__answer {
  max-height: 400px;
}

.ncco-faq__card .ncco-faq__answer-inner {
  font-family: 'Geist', sans-serif;
  font-size: 15px;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.6;
  padding: 0 0 22px;
}
.ncco-faq__card .ncco-faq__answer-inner p { margin: 0; }

@media (max-width: 1024px) {
  .ncco-faq__grid {
    grid-template-columns: repeat(2, 1fr);
    column-gap: 36px;
  }
  .ncco-faq-white .ncco-faq__heading {
    font-size: 36px;
  }
  .ncco-faq {
    padding: 48px 24px;
    margin: 0 8px;
    border-radius: 24px;
    min-height: 0;
    justify-content: center;
    align-items: flex-end;
  }
  .ncco-faq__card {
    width: 100%;
    border-radius: 20px;
    padding: 40px 32px;
  }
}

@media (max-width: 680px) {
  .ncco-faq__grid {
    grid-template-columns: 1fr;
    column-gap: 0;
  }
  .ncco-faq-white .ncco-faq__heading {
    font-size: 28px;
  }
  .ncco-faq-wrap {
    padding: 0 12px;
    margin: 32px auto;
  }
  .ncco-faq {
    padding: 32px 16px;
    margin: 0 8px;
    border-radius: 20px;
    min-height: 0;
  }
  .ncco-faq__card {
    border-radius: 16px;
    padding: 24px 16px;
  }
}
</style>

<script>
window.toggleFaq = function(btn, event) {
  if (event) {
    event.preventDefault();
    event.stopPropagation();
  }
  var now = Date.now();
  if (btn._lastFaqClick && (now - btn._lastFaqClick) < 80) return;
  btn._lastFaqClick = now;

  var item = btn.closest('.ncco-faq__item');
  if (!item) return;
  var isOpen = item.classList.contains('is-open');
  var icon = item.querySelector('.ncco-faq__icon');
  if (isOpen) {
    item.classList.remove('is-open');
    btn.setAttribute('aria-expanded', 'false');
    if (icon) icon.textContent = '+';
  } else {
    item.classList.add('is-open');
    btn.setAttribute('aria-expanded', 'true');
    if (icon) icon.textContent = '−';
  }
};

document.addEventListener('click', function(e) {
  var btn = e.target.closest('.ncco-faq__trigger');
  if (btn && !btn.getAttribute('onclick')) {
    window.toggleFaq(btn, e);
  }
});
</script>

{% schema %}
{
  "name": "NCCO FAQ",
  "tag": "section",
  "settings": [
    {"type": "text",     "id": "eyebrow",  "label": "Eyebrow"},
    {"type": "text",     "id": "accent_color", "label": "Accent color (hex, default #FECB07 yellow)"},
    {"type": "text",     "id": "heading",  "label": "Heading",           "default": "All You Need To Know"},
    {"type": "text",     "id": "bg_image",   "label": "Background image filename (assets/)"},
    {"type": "checkbox", "id": "three_col", "label": "3-column layout (flat only)", "default": false}
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {"type": "text",     "id": "heading", "label": "Question"},
        {"type": "richtext", "id": "answer",  "label": "Answer"}
      ]
    }
  ],
  "presets": [{"name": "NCCO FAQ"}]
}
{% endschema %}
