<section class="ncco-industrial-brand" id="ncco-industrial-brand-{{ section.id }}">
  <div class="ncco-industrial-brand__container">
    
    <!-- LEFT COLUMN: Accent dash and eyebrow -->
    <div class="ncco-industrial-brand__left">
      <div class="ncco-industrial-brand__eyebrow-wrap">
        <span class="ncco-industrial-brand__dash"></span>
        {% if section.settings.eyebrow != blank %}
          <p class="ncco-industrial-brand__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
      </div>
    </div>

    <!-- RIGHT COLUMN: Heading, CTA button, and 2-column feature blocks -->
    <div class="ncco-industrial-brand__right">
      <div class="ncco-industrial-brand__header">
        {% if section.settings.heading != blank %}
          <h2 class="ncco-industrial-brand__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_url | default: '#' }}" class="ncco-industrial-brand__button">
            <span class="ncco-industrial-brand__button-text">{{ section.settings.button_text }}</span>
            <span class="ncco-industrial-brand__button-icon">
              <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                <path d="M2.5 10.5L10.5 2.5M10.5 2.5H4.5M10.5 2.5V8.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        {% endif %}
      </div>

      <div class="ncco-industrial-brand__feature-row">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="ncco-industrial-brand__feature" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <h3 class="ncco-industrial-brand__feature-title">
                  {{ block.settings.title }}
                </h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <div class="ncco-industrial-brand__feature-text">
                  {{ block.settings.text }}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

  </div>

  {% assign has_cases = false %}
  {% for block in section.blocks %}
    {% if block.type == 'case' %}
      {% assign has_cases = true %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if has_cases and section.settings.show_cases != false %}
    <div class="ncco-industrial-brand__carousel-wrap" aria-label="Case Studies Carousel">
      <div class="ncco-industrial-brand__carousel-track">
        {% for group_idx in (1..2) %}
          <div class="ncco-industrial-brand__carousel-group" {% if group_idx > 1 %}aria-hidden="true"{% endif %}>
            {% for rep in (1..2) %}
              {% for block in section.blocks %}
                {% if block.type == 'case' %}
                  <div class="ncco-industrial-brand__card" {{ block.shopify_attributes }}>
                    {% if block.settings.image != blank %}
                      {{
                        block.settings.image
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'lazy',
                          widths: '400, 600, 800, 1000, 1200',
                          sizes: '(max-width: 640px) 300px, (max-width: 992px) 380px, 460px',
                          alt: block.settings.image_alt | default: block.settings.label
                      }}
                    {% else %}
                      <div class="ncco-industrial-brand__placeholder"></div>
                    {% endif %}
                    <div class="ncco-industrial-brand__card-overlay"></div>
                    {% if block.settings.label != blank %}
                      <div class="ncco-industrial-brand__label">
                        <span class="ncco-industrial-brand__label-arrow" aria-hidden="true">
                          <svg width="7" height="9" viewBox="0 0 7 9" fill="currentColor">
                            <path d="M0 0.5L6.5 4.5L0 8.5V0.5Z"/>
                          </svg>
                        </span>
                        <span class="ncco-industrial-brand__label-text">{{ block.settings.label }}</span>
                        <span class="ncco-industrial-brand__label-arrow" aria-hidden="true">
                          <svg width="7" height="9" viewBox="0 0 7 9" fill="currentColor">
                            <path d="M6.5 0.5L0 4.5L6.5 8.5V0.5Z"/>
                          </svg>
                        </span>
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            {% endfor %}
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</section>
<style>
.ncco-industrial-brand {
  width: 100%;
  background-color: #F4FBFC;
  box-sizing: border-box;
  padding: 92px 0 96px;
}

.ncco-industrial-brand__container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 40px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 48px;
  box-sizing: border-box;
}

/* LEFT COLUMN: Eyebrow Paragraph + Dash */
.ncco-industrial-brand__left {
  flex: 0 1 450px;
  max-width: 450px;
  box-sizing: border-box;
  padding-top: 6px;
}

.ncco-industrial-brand__eyebrow-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.ncco-industrial-brand__dash {
  display: block;
  width: 28px;
  height: 2.5px;
  background-color: #22B39F;
  border-radius: 2px;
  margin-bottom: 20px;
}

.ncco-industrial-brand__eyebrow {
  font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 14px;
  line-height: 1.75;
  font-weight: 400;
  color: #52677C;
  letter-spacing: 0.2px;
  margin: 0;
}

/* RIGHT COLUMN: Header + Feature Row */
.ncco-industrial-brand__right {
  flex: 1;
  max-width: 740px;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* HEADER: Heading + CTA Button */
.ncco-industrial-brand__header {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  text-align: right;
  margin-bottom: 44px;
}

.ncco-industrial-brand__heading {
  margin: 0 0 22px 0;
  font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: clamp(34px, 3.6vw, 44px);
  line-height: 1.25;
  font-weight: 500;
  letter-spacing: -0.6px;
  color: #0A1C2E;
  text-align: right;
  max-width: 680px;
}

.ncco-industrial-brand__button {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  background-color: #22B39F;
  color: #FFFFFF;
  text-decoration: none;
  font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 13px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: 0.3px;
  text-transform: uppercase;
  padding: 6px 6px 6px 20px;
  border-radius: 9999px;
  box-sizing: border-box;
  box-shadow: 0 4px 14px rgba(34, 179, 159, 0.22);
  transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  cursor: pointer;
}

.ncco-industrial-brand__button:hover {
  background-color: #1CA290;
  color: #FFFFFF;
  transform: translateY(-1px);
  box-shadow: 0 6px 18px rgba(34, 179, 159, 0.32);
}

.ncco-industrial-brand__button-text {
  color: #FFFFFF;
  white-space: nowrap;
}

.ncco-industrial-brand__button-icon {
  width: 28px;
  height: 28px;
  min-width: 28px;
  border-radius: 50%;
  background-color: #FFFFFF;
  color: #22B39F;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.ncco-industrial-brand__button:hover .ncco-industrial-brand__button-icon {
  transform: scale(1.05);
}

.ncco-industrial-brand__button-icon svg {
  display: block;
}

/* FEATURE ROW */
.ncco-industrial-brand__feature-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 44px;
  width: 100%;
  box-sizing: border-box;
}

.ncco-industrial-brand__feature {
  min-width: 0;
  border-top: 1px solid #D6E4E7;
  padding-top: 24px;
}

.ncco-industrial-brand__feature-title {
  margin: 0 0 10px 0;
  font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 14px;
  line-height: 1.35;
  font-weight: 600;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  color: #0A1C2E;
}

.ncco-industrial-brand__feature-text {
  font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 13px;
  line-height: 1.65;
  font-weight: 400;
  color: #63778B;
  margin: 0;
}

/* CASE STUDIES CONTINUOUS CAROUSEL (EDGE-TO-EDGE) */
.ncco-industrial-brand__carousel-wrap {
  width: 100%;
  overflow: hidden;
  margin-top: 56px;
  padding: 8px 0;
  position: relative;
  box-sizing: border-box;
}

.ncco-industrial-brand__carousel-track {
  display: flex;
  width: max-content;
  will-change: transform;
  animation: ncco-brand-scroll 45s linear infinite;
}

.ncco-industrial-brand__carousel-wrap:hover .ncco-industrial-brand__carousel-track {
  animation-play-state: paused;
}

.ncco-industrial-brand__carousel-group {
  display: flex;
  align-items: center;
  gap: 20px;
  padding-right: 20px; /* matches gap for seamless repeating loop */
  flex-shrink: 0;
}

.ncco-industrial-brand__card {
  position: relative;
  width: 440px;
  height: 310px;
  flex: 0 0 440px;
  border-radius: 20px;
  overflow: hidden;
  background-color: #E7EFF0;
  box-sizing: border-box;
  box-shadow: 0 8px 24px rgba(10, 28, 46, 0.08);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.ncco-industrial-brand__card:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 32px rgba(10, 28, 46, 0.16);
}

.ncco-industrial-brand__card img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 0.4s ease;
}

.ncco-industrial-brand__card:hover img {
  transform: scale(1.03);
}

.ncco-industrial-brand__placeholder {
  width: 100%;
  height: 100%;
  background: #DDE8EA;
}

.ncco-industrial-brand__card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(10, 28, 46, 0.88) 0%,
    rgba(10, 28, 46, 0.48) 32%,
    rgba(10, 28, 46, 0.08) 55%,
    transparent 70%
  );
  pointer-events: none;
}

.ncco-industrial-brand__label {
  position: absolute;
  bottom: 22px;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0 16px;
  box-sizing: border-box;
  pointer-events: none;
  z-index: 2;
}

.ncco-industrial-brand__label-arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #22B39F;
  font-size: 9px;
  line-height: 1;
  flex-shrink: 0;
}

.ncco-industrial-brand__label-arrow svg {
  display: block;
  width: 7px;
  height: 9px;
  fill: currentColor;
}

.ncco-industrial-brand__label-text {
  font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 13px;
  line-height: 1.2;
  font-weight: 500;
  letter-spacing: 0.8px;
  color: #FFFFFF;
  text-transform: uppercase;
  text-align: center;
  white-space: nowrap;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
}

@keyframes ncco-brand-scroll {
  0% {
    transform: translate3d(0, 0, 0);
  }
  100% {
    transform: translate3d(-50%, 0, 0);
  }
}

/* RESPONSIVE */
@media (max-width: 992px) {
  .ncco-industrial-brand {
    padding: 64px 0 70px;
  }

  .ncco-industrial-brand__container {
    flex-direction: column;
    gap: 32px;
    padding: 0 32px;
  }

  .ncco-industrial-brand__left {
    flex: none;
    max-width: 100%;
    width: 100%;
    padding-top: 0;
  }

  .ncco-industrial-brand__right {
    max-width: 100%;
    width: 100%;
  }

  .ncco-industrial-brand__header {
    align-items: flex-start;
    text-align: left;
    margin-bottom: 36px;
  }

  .ncco-industrial-brand__heading {
    text-align: left;
    font-size: 32px;
    line-height: 1.25;
  }

  .ncco-industrial-brand__feature-row {
    gap: 32px;
  }

  .ncco-industrial-brand__carousel-wrap {
    margin-top: 48px;
  }

  .ncco-industrial-brand__card {
    width: 380px;
    height: 270px;
    flex: 0 0 380px;
    border-radius: 16px;
  }

  .ncco-industrial-brand__carousel-group {
    gap: 16px;
    padding-right: 16px;
  }

  .ncco-industrial-brand__label {
    bottom: 18px;
  }

  .ncco-industrial-brand__label-text {
    font-size: 12px;
  }
}

@media (max-width: 640px) {
  .ncco-industrial-brand {
    padding: 48px 0 54px;
  }

  .ncco-industrial-brand__container {
    padding: 0 20px;
    gap: 24px;
  }

  .ncco-industrial-brand__heading {
    font-size: 26px;
    line-height: 1.28;
    margin-bottom: 18px;
  }

  .ncco-industrial-brand__feature-row {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .ncco-industrial-brand__feature {
    padding-top: 18px;
  }

  .ncco-industrial-brand__carousel-wrap {
    margin-top: 36px;
  }

  .ncco-industrial-brand__card {
    width: 290px;
    height: 210px;
    flex: 0 0 290px;
    border-radius: 14px;
  }

  .ncco-industrial-brand__carousel-group {
    gap: 12px;
    padding-right: 12px;
  }

  .ncco-industrial-brand__label {
    bottom: 14px;
    gap: 6px;
  }

  .ncco-industrial-brand__label-text {
    font-size: 11px;
    letter-spacing: 0.5px;
  }
}
</style>
{% schema %}
{
  "name":"NCCO Industrial Brand",
  "tag":"section",
  "settings":[
    {
      "type":"text",
      "id":"eyebrow",
      "label":"Eyebrow",
      "default":"JUST AN INTRO"
    },
    {
      "type":"text",
      "id":"heading",
      "label":"Heading",
      "default":"An Industrial Air Purification Brand Built for Performance"
    },
    {
      "type":"text",
      "id":"button_text",
      "label":"Button text",
      "default":"KNOW MORE ABOUT US"
    },
    {
      "type":"url",
      "id":"button_url",
      "label":"Button URL"
    },
    {
      "type":"checkbox",
      "id":"show_cases",
      "label":"Show Case Studies",
      "default": true
    }
  ],
  "blocks":[
    {
      "type":"feature",
      "name":"Feature",
      "settings":[
        {
          "type":"text",
          "id":"title",
          "label":"Feature title",
          "default":"BRINGING CLEAN AIR TO SCALE"
        },
        {
          "type":"text",
          "id":"text",
          "label":"Feature text",
          "default":"We develop industrial-grade air purification systems for hospitals, transit, and factories built to run continuously and reliably."
        }
      ]
    },
    {
      "type":"case",
      "name":"Case Study Image",
      "settings":[
        {
          "type":"image_picker",
          "id":"image",
          "label":"Image"
        },
        {
          "type":"text",
          "id":"label",
          "label":"Image label",
          "default":"ASIA PACIFIC DATA CENTRE"
        },
        {
          "type":"text",
          "id":"image_alt",
          "label":"Image alt text"
        }
      ]
    }
  ],
  "max_blocks":6,
  "presets":[
    {
      "name":"NCCO Industrial Brand",
      "blocks":[
        {
          "type":"feature",
          "settings":{
            "title":"BRINGING CLEAN AIR TO SCALE",
