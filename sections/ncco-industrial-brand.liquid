            "label":"ASIA PACIFIC DATA CENTRE"
          }
        },
        {
          "type":"case",
          "settings":{
            "label":"YAN OI TONG KINDERGARTEN"
          }
        },
        {
          "type":"case",
          "settings":{
            "label":"HONG KONG BAPTIST HOSPITAL"
          }
        },
        {
          "type":"case",
          "settings":{
            "label":"SINGAPORE AIRPORT AND"
          }
        }
      ]
    }
  ]
}
{% endschema %}