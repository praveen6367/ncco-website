{%- assign pg_cta_v = section.settings.cta_variant | default: 'teal' -%}
{%- assign pg_accent = section.settings.accent_color | default: '#FECB07' -%}

<section class="ncco-pg ncco-section{% if section.settings.dark %} ncco-section--dark{% endif %}" style="--ncco-accent:{{ pg_accent }}">
  <div class="ncco-pg__header ncco-container">
    <div class="ncco-pg__header-left">
      {% if section.settings.eyebrow != blank %}
        <div class="ncco-pg__eyebrow-wrap">
          <span class="ncco-pg__eyebrow-bar"></span>
          <p class="ncco-pg__eyebrow">{{ section.settings.eyebrow }}</p>
        </div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="ncco-pg__heading ncco-reveal">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.tab_1 != blank or section.settings.tab_2 != blank or section.settings.tab_3 != blank %}
        <div class="ncco-pg__tabs" role="tablist">
          {% if section.settings.tab_1 != blank %}
            <button class="ncco-pg__tab ncco-pg__tab--active" data-filter="all" role="tab">{{ section.settings.tab_1 }}</button>
          {% endif %}
          {% if section.settings.tab_2 != blank %}
            <button class="ncco-pg__tab" data-filter="{{ section.settings.tab_2 | downcase }}" role="tab">{{ section.settings.tab_2 }}</button>
          {% endif %}
          {% if section.settings.tab_3 != blank %}
            <button class="ncco-pg__tab" data-filter="{{ section.settings.tab_3 | downcase }}" role="tab">{{ section.settings.tab_3 }}</button>
          {% endif %}
        </div>
      {% endif %}
    </div>
    <div class="ncco-pg__header-right">
      {% if section.settings.subtext != blank %}
        <p class="ncco-pg__subtext ncco-reveal">{{ section.settings.subtext }}</p>
      {% endif %}
      {% if section.settings.cta_label != blank %}
        {%- render 'ncco-cta', label: section.settings.cta_label, url: section.settings.cta_url, variant: pg_cta_v -%}
      {% endif %}
    </div>
  </div>

  <div class="ncco-pg__scroll-wrap">
    <div class="ncco-pg__row" id="ncco-pg-row-{{ section.id }}">
      {% for block in section.blocks %}
        <div class="ncco-pg__card" data-category="{{ block.settings.category | default: 'all' }}" {{ block.shopify_attributes }}>
          <div class="ncco-pg__card-meta">
            {% if block.settings.product_code != blank %}
              <span class="ncco-pg__code">{{ block.settings.product_code }}</span>
            {% endif %}
            {% if block.settings.link_label != blank %}
              <a href="{{ block.settings.link_url | default: '#' }}" class="ncco-pg__learn">
                {{ block.settings.link_label }}
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 13L13 3M13 3H6M13 3V10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            {% endif %}
          </div>
          {% if block.settings.product_name != blank %}
            <p class="ncco-pg__name">{{ block.settings.product_name }}</p>
          {% endif %}
          <div class="ncco-pg__img-wrap">
            {% if block.settings.asset != blank %}
              <img src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.product_name }}" loading="lazy">
            {% elsif block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.product_name }}" loading="lazy">
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
.ncco-pg { background: #fff; padding: 120px 0 0; }

.ncco-pg__header {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 80px;
  align-items: center;
  margin-bottom: 60px;
}
.ncco-pg__header-left { display: flex; flex-direction: column; align-items: flex-start; gap: 28px; }
.ncco-pg__header-right { display: flex; flex-direction: column; align-items: flex-start; gap: 32px; }

.ncco-pg__eyebrow-wrap { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
.ncco-pg__eyebrow-bar { display: block; width: 28px; height: 2px; background: var(--ncco-accent, #FECB07); }
.ncco-pg__eyebrow {
  font-family: 'Geist', sans-serif;
  font-size: 13px; font-weight: 500; letter-spacing: 0.6px;
  color: #647082; text-transform: uppercase; margin: 0;
}
.ncco-pg__heading {
  font-family: 'Geist', sans-serif;
  font-size: 58px; font-weight: 500; line-height: 68px; letter-spacing: -2.32px;
  color: #081D3A; margin: 0;
}
.ncco-pg__subtext {
  font-family: 'Geist', sans-serif;
  font-size: 16px; font-weight: 400; line-height: 24px; letter-spacing: -0.32px;
  color: #647082; margin: 0;
}

/* Filter tabs */
.ncco-pg__tabs {
  display: flex; gap: 4px;
  background: #F0F2F5; padding: 4px; border-radius: 99px;
}
.ncco-pg__tab {
  padding: 10px 24px; border-radius: 99px;
  font-family: 'Geist', sans-serif; font-size: 14px; font-weight: 500; letter-spacing: -0.28px;
  color: #647082; cursor: pointer; border: none; background: transparent;
  transition: all .2s ease;
}
.ncco-pg__tab--active {
  background: #fff; color: #081D3A;
  box-shadow: 0 2px 8px rgba(8,29,58,0.1);
}
.ncco-pg__tab:not(.ncco-pg__tab--active):hover { color: #081D3A; }

/* Scroll row */
.ncco-pg__scroll-wrap {
  background: #F4F6FA;
  padding: 40px 240px;
  overflow-x: auto;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.ncco-pg__scroll-wrap::-webkit-scrollbar { display: none; }
.ncco-pg__row {
  display: flex; gap: 24px; width: max-content;
}

/* Product card */
.ncco-pg__card {
  width: 300px; flex: 0 0 300px;
  background: #fff; border-radius: 20px;
  padding: 20px 20px 0;
  display: flex; flex-direction: column;
  overflow: hidden;
  transition: box-shadow .25s ease;
}
.ncco-pg__card:hover { box-shadow: 0 8px 32px rgba(8,29,58,0.08); }
.ncco-pg__card[style*="display: none"] { display: none !important; }

.ncco-pg__card-meta {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 6px;
}
.ncco-pg__code {
  font-family: 'Geist', sans-serif;
  font-size: 14px; font-weight: 600; letter-spacing: -0.28px;
  color: #22B39F;
}
.ncco-pg__learn {
  display: inline-flex; align-items: center; gap: 4px;
  font-family: 'Geist', sans-serif; font-size: 13px; font-weight: 500; letter-spacing: -0.26px;
  color: #22B39F; text-decoration: none;
}
.ncco-pg__learn:hover { text-decoration: underline; }
.ncco-pg__name {
  font-family: 'Geist', sans-serif;
  font-size: 17px; font-weight: 500; line-height: 1.3; letter-spacing: -0.34px;
  color: #081D3A; margin: 0 0 16px;
}
.ncco-pg__img-wrap {
  flex: 1; background: #fff;
  border-radius: 12px 12px 0 0;
  overflow: hidden;
  margin: 0 -20px;
}
.ncco-pg__img-wrap img {
  width: 100%; aspect-ratio: 4/3;
  object-fit: contain; display: block;
  padding: 16px; box-sizing: border-box;
}

/* Responsive */
@media (max-width: 1600px) {
  .ncco-pg__heading { font-size: 48px; line-height: 56px; letter-spacing: -1.8px; }
  .ncco-pg__scroll-wrap { padding: 40px 80px; }
}
@media (max-width: 1200px) {
  .ncco-pg__header { grid-template-columns: 1fr; gap: 32px; }
  .ncco-pg__heading { font-size: 40px; line-height: 48px; }
  .ncco-pg__scroll-wrap { padding: 32px 40px; }
}
@media (max-width: 989px) {
  .ncco-pg { padding: 80px 0 0; }
  .ncco-pg__scroll-wrap { padding: 28px 24px; }
  .ncco-pg__card { width: 260px; flex: 0 0 260px; }
}
@media (max-width: 600px) {
  .ncco-pg { padding: 60px 0 0; }
  .ncco-pg__heading { font-size: 28px; line-height: 36px; letter-spacing: -0.8px; }
  .ncco-pg__card { width: calc(75vw - 24px); flex: 0 0 calc(75vw - 24px); }
  .ncco-pg__scroll-wrap { padding: 24px 16px; }
}
</style>

<script>
(function() {
  var row = document.getElementById('ncco-pg-row-{{ section.id }}');
  if (!row) return;
  var tabs = row.closest('.ncco-pg').querySelectorAll('.ncco-pg__tab');
  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() {
      tabs.forEach(function(t) { t.classList.remove('ncco-pg__tab--active'); });
      tab.classList.add('ncco-pg__tab--active');
      var filter = tab.dataset.filter;
      row.querySelectorAll('.ncco-pg__card').forEach(function(card) {
        card.style.display = (filter === 'all' || card.dataset.category === filter) ? '' : 'none';
      });
    });
  });
})();
</script>

{% schema %}
{
  "name": "NCCO Product Grid",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "textarea", "id": "subtext", "label": "Subtext"},
    {"type": "text", "id": "cta_label", "label": "CTA label"},
    {"type": "url", "id": "cta_url", "label": "CTA URL"},
    {"type": "select", "id": "cta_variant", "label": "CTA style", "options": [{"value": "yellow", "label": "Yellow"}, {"value": "blue", "label": "Blue"}, {"value": "teal", "label": "Teal"}], "default": "teal"},
    {"type": "header", "content": "Filter tabs"},
    {"type": "text", "id": "tab_1", "label": "Tab 1 (shows all)", "default": "Solutions"},
    {"type": "text", "id": "tab_2", "label": "Tab 2 label (used as filter key, lowercase)", "default": "Industrial"},
    {"type": "text", "id": "tab_3", "label": "Tab 3 label (used as filter key, lowercase)", "default": "Domestic"},
    {"type": "checkbox", "id": "dark", "label": "Dark background", "default": false},
    {"type": "text", "id": "accent_color", "label": "Accent color (hex, default #FECB07 yellow)"}
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {"type": "text", "id": "product_code", "label": "Product code (e.g. RH-490C)"},
        {"type": "text", "id": "product_name", "label": "Product name"},
        {"type": "text", "id": "link_label", "label": "Link text", "default": "Learn More"},
        {"type": "url", "id": "link_url", "label": "Link URL"},
        {"type": "text", "id": "category", "label": "Category — must match Tab 2 or Tab 3 label (lowercase), or 'all'", "default": "all"},
        {"type": "image_picker", "id": "image", "label": "Product image (via Theme Editor)"},
        {"type": "text", "id": "asset", "label": "Image asset filename"}
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{"name": "NCCO Product Grid"}]
}
{% endschema %}
