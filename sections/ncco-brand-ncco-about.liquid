<section class="ncco-bna">
  <div class="ncco-bna__inner">

    <div class="ncco-bna__left">
      <div class="ncco-bna__left-content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ncco-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ncco-bna__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <p class="ncco-bna__body">{{ section.settings.body }}</p>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <div class="ncco-bna__features">
            {%- for block in section.blocks -%}
              <div class="ncco-bna__feat" {{ block.shopify_attributes }}>
                {%- if block.settings.icon_asset != blank -%}
                  <img class="ncco-bna__feat-icon" src="{{ block.settings.icon_asset | asset_url }}" alt="" loading="lazy">
                {%- endif -%}
                <div class="ncco-bna__feat-text">
                  {%- if block.settings.title != blank -%}
                    <h3 class="ncco-bna__feat-title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.body != blank -%}
                    <p class="ncco-bna__feat-body">{{ block.settings.body }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      {%- if section.settings.cta_label != blank -%}
        {%- render 'ncco-cta', label: section.settings.cta_label, url: section.settings.cta_url, variant: 'blue', class: 'ncco-bna__cta' -%}
      {%- endif -%}
    </div>

    <div class="ncco-bna__grid">
      {%- if section.settings.image_1_asset != blank -%}
        <div class="ncco-bna__img-wrap">
          <img class="ncco-bna__img" src="{{ section.settings.image_1_asset | asset_url }}" alt="{{ section.settings.image_1_label }}" loading="lazy">
          <div class="ncco-bna__img-shade"></div>
          {%- if section.settings.image_1_label != blank -%}
            <span class="ncco-bna__img-label">{{ section.settings.image_1_label }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.image_2_asset != blank -%}
        <div class="ncco-bna__img-wrap">
          <img class="ncco-bna__img" src="{{ section.settings.image_2_asset | asset_url }}" alt="{{ section.settings.image_2_label }}" loading="lazy">
          <div class="ncco-bna__img-shade"></div>
          {%- if section.settings.image_2_label != blank -%}
            <span class="ncco-bna__img-label">{{ section.settings.image_2_label }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.image_3_asset != blank -%}
        <div class="ncco-bna__img-wrap">
          <img class="ncco-bna__img" src="{{ section.settings.image_3_asset | asset_url }}" alt="{{ section.settings.image_3_label }}" loading="lazy">
          <div class="ncco-bna__img-shade"></div>
          {%- if section.settings.image_3_label != blank -%}
            <span class="ncco-bna__img-label">{{ section.settings.image_3_label }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.image_4_asset != blank -%}
        <div class="ncco-bna__img-wrap">
          <img class="ncco-bna__img" src="{{ section.settings.image_4_asset | asset_url }}" alt="{{ section.settings.image_4_label }}" loading="lazy">
          <div class="ncco-bna__img-shade"></div>
          {%- if section.settings.image_4_label != blank -%}
            <span class="ncco-bna__img-label">{{ section.settings.image_4_label }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

  </div>
</section>

<style>
.ncco-bna { padding: 120px 240px; background: #fff; }
.ncco-bna__inner {
  display: flex;
  gap: 152px;
  align-items: center;
}

/* Left column */
.ncco-bna__left {
  flex: 0 0 583px;
  display: flex;
  flex-direction: column;
}
.ncco-bna__left-content {
  display: flex;
  flex-direction: column;
  gap: 40px;
  flex: 1;
}
.ncco-bna .ncco-eyebrow { margin-bottom: 0; }
.ncco-bna__heading {
  font-family: 'Geist', sans-serif;
  font-size: 58px; font-weight: 500; line-height: 68px; letter-spacing: -2.32px;
  color: #081D3A; margin: 0;
}
.ncco-bna__body {
  font-family: 'Geist', sans-serif;
  font-size: 18px; font-weight: 400; line-height: 24px; letter-spacing: -0.36px;
  color: #647082; margin: 0;
}
.ncco-bna__features {
  display: flex;
  flex-direction: column;
  gap: 30px;
}
.ncco-bna__feat {
  display: flex;
  gap: 16px;
  align-items: flex-start;
}
.ncco-bna__feat-icon {
  width: 48px; height: 48px;
  flex-shrink: 0; object-fit: contain;
}
.ncco-bna__feat-text {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.ncco-bna__feat-title {
  font-family: 'Geist', sans-serif;
  font-size: 20px; font-weight: 500; letter-spacing: -0.4px;
  color: #081D3A; text-transform: uppercase; margin: 0;
}
.ncco-bna__feat-body {
  font-family: 'Geist', sans-serif;
  font-size: 18px; font-weight: 400; line-height: 28px; letter-spacing: -0.36px;
  color: #647082; margin: 0;
}
.ncco-bna__cta { margin-top: 88px; }

/* Right 2×2 image grid */
.ncco-bna__grid {
  flex: 0 0 705px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px 29px;
}
.ncco-bna__img-wrap {
  position: relative;
  height: 412px;
  border-radius: 28px;
  overflow: hidden;
  border: 1px solid rgba(8,29,58,0.08);
}
.ncco-bna__img {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
}
.ncco-bna__img-shade {
  position: absolute; inset: 0;
  background: rgba(8,29,58,0.48);
  pointer-events: none;
}
.ncco-bna__img-label {
  position: absolute;
  top: 27px;
  left: 50%;
  transform: translateX(-50%);
  white-space: nowrap;
  padding: 16px 32px;
  border-radius: 60px;
  background: rgba(255,255,255,0.16);
  border: 1px solid rgba(255,255,255,0.28);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  font-family: 'Geist', sans-serif;
  font-size: 18px; font-weight: 600; letter-spacing: -0.36px;
  color: #fff; text-transform: uppercase;
}

@media (max-width: 1600px) {
  .ncco-bna { padding: 100px 80px; }
  .ncco-bna__inner { gap: 80px; }
  .ncco-bna__left { flex: 0 0 auto; flex: 1 1 480px; }
  .ncco-bna__grid { flex: 0 0 auto; flex: 1 1 400px; }
}
@media (max-width: 1200px) {
  .ncco-bna { padding: 80px 40px; }
  .ncco-bna__inner { flex-direction: column; gap: 60px; }
  .ncco-bna__left { flex: none; width: 100%; }
  .ncco-bna__grid { flex: none; width: 100%; }
  .ncco-bna__heading { font-size: 44px; line-height: 52px; letter-spacing: -1.5px; }
  .ncco-bna__cta { margin-top: 48px; }
}
@media (max-width: 600px) {
  .ncco-bna { padding: 40px 16px; }
  .ncco-bna__heading { font-size: 32px; line-height: 40px; letter-spacing: -1px; }
  .ncco-bna__img-wrap { height: 280px; }
  .ncco-bna__grid { gap: 12px; }
  .ncco-bna__img-label { font-size: 14px; padding: 10px 20px; }
  .ncco-bna__cta { margin-top: 32px; }
}
</style>

{% schema %}
{
  "name": "Brand About Split",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow"},
    {"type": "text", "id": "heading", "label": "Heading"},
    {"type": "textarea", "id": "body", "label": "Body text"},
    {"type": "text", "id": "cta_label", "label": "CTA label"},
    {"type": "url", "id": "cta_url", "label": "CTA URL"},
    {"type": "header", "content": "Image 1"},
    {"type": "text", "id": "image_1_asset", "label": "Image 1 filename (assets/)"},
    {"type": "text", "id": "image_1_label", "label": "Image 1 label"},
    {"type": "header", "content": "Image 2"},
    {"type": "text", "id": "image_2_asset", "label": "Image 2 filename (assets/)"},
    {"type": "text", "id": "image_2_label", "label": "Image 2 label"},
    {"type": "header", "content": "Image 3"},
    {"type": "text", "id": "image_3_asset", "label": "Image 3 filename (assets/)"},
    {"type": "text", "id": "image_3_label", "label": "Image 3 label"},
    {"type": "header", "content": "Image 4"},
    {"type": "text", "id": "image_4_asset", "label": "Image 4 filename (assets/)"},
    {"type": "text", "id": "image_4_label", "label": "Image 4 label"}
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {"type": "text", "id": "icon_asset", "label": "Icon asset filename"},
        {"type": "text", "id": "title", "label": "Title"},
        {"type": "text", "id": "body", "label": "Body text"}
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{"name": "Brand About Split"}]
}
{% endschema %}
