<section class="ncco-resfeat-wrap">
  <div class="ncco-resfeat">
    <div class="ncco-resfeat__left">
      {%- if section.settings.eyebrow != blank -%}
        <div class="ncco-resfeat__eyebrow-wrap">
          <span class="ncco-resfeat__eyebrow-bar"></span>
          <p class="ncco-resfeat__eyebrow-text">{{ section.settings.eyebrow }}</p>
        </div>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ncco-resfeat__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="ncco-resfeat__body">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <div class="ncco-resfeat__note">{{ section.settings.note }}</div>
      {%- endif -%}
    </div>
    <div class="ncco-resfeat__grid">
      <div class="ncco-resfeat__col ncco-resfeat__col--1">
        {%- for block in section.blocks limit: 2 -%}
          <div class="ncco-resfeat__card" {{ block.shopify_attributes }}>
            {%- if block.settings.icon_asset != blank -%}
              <div class="ncco-resfeat__icon">
                <img src="{{ block.settings.icon_asset | asset_url }}" alt="" width="48" height="48" loading="lazy">
              </div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <p class="ncco-resfeat__card-title">{{ block.settings.title }}</p>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="ncco-resfeat__card-body">{{ block.settings.body }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
      <div class="ncco-resfeat__col ncco-resfeat__col--2">
        {%- for block in section.blocks offset: 2 -%}
          <div class="ncco-resfeat__card" {{ block.shopify_attributes }}>
            {%- if block.settings.icon_asset != blank -%}
              <div class="ncco-resfeat__icon">
                <img src="{{ block.settings.icon_asset | asset_url }}" alt="" width="48" height="48" loading="lazy">
              </div>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <p class="ncco-resfeat__card-title">{{ block.settings.title }}</p>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <div class="ncco-resfeat__card-body">{{ block.settings.body }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<style>
.ncco-resfeat-wrap{ padding:0 16px; background:#fff; box-sizing:border-box; }
.ncco-resfeat{
  background:rgba(100,112,130,0.04);
  border-radius:32px;
  padding:120px clamp(32px,11.667vw,224px);
  display:grid; grid-template-columns:1fr 1fr; gap:clamp(40px,7.9vw,152px);
  align-items:center;
  box-sizing:border-box;
}
.ncco-resfeat__left{ display:flex; flex-direction:column; gap:40px; }
.ncco-resfeat__eyebrow-wrap{ display:flex; flex-direction:column; gap:8px; }
.ncco-resfeat__eyebrow-bar{ width:28px; height:2px; background:#FECB07; display:block; }
.ncco-resfeat__eyebrow-text{ margin:0; font-family:'Geist',sans-serif; font-size:16px; font-weight:500; letter-spacing:-0.32px; text-transform:uppercase; color:#647082; }
.ncco-resfeat__heading{ margin:0; font-family:'Geist',sans-serif; font-weight:500; font-size:clamp(32px,3vw,46px); line-height:1.18; letter-spacing:-1.8px; color:#081D3A; }
.ncco-resfeat__body{ font-family:'Geist',sans-serif; font-size:18px; font-weight:400; line-height:1.55; letter-spacing:-0.36px; color:#647082; }
.ncco-resfeat__body p{ margin:0; }
.ncco-resfeat__note{ font-family:'Geist',sans-serif; font-size:14px; font-weight:400; line-height:1.4; color:#647082; }
.ncco-resfeat__note p{ margin:0 0 8px; }
.ncco-resfeat__note p:last-child{ margin-bottom:0; }

.ncco-resfeat__grid{ display:flex; gap:24px; }
.ncco-resfeat__col{ display:flex; flex-direction:column; gap:24px; flex:1 1 0; min-width:0; }
.ncco-resfeat__col--1{ padding-top:clamp(28px,4vw,56px); }
.ncco-resfeat__col--2{ padding-bottom:clamp(28px,4vw,56px); }
.ncco-resfeat__card{
  background:#fff; border:1px solid rgba(100,112,130,0.12); border-radius:24px;
  padding:24px; display:flex; flex-direction:column; gap:20px;
  box-shadow:0 16px 24px rgba(8,29,58,0.04);
}
.ncco-resfeat__icon{ width:48px; height:48px; }
.ncco-resfeat__icon img{ width:48px; height:48px; object-fit:contain; display:block; }
.ncco-resfeat__card-title{ margin:0; font-family:'Geist',sans-serif; font-weight:500; font-size:18px; letter-spacing:-0.36px; text-transform:uppercase; color:#081D3A; }
.ncco-resfeat__card-body{ font-family:'Geist',sans-serif; font-size:15px; font-weight:400; line-height:1.5; letter-spacing:-0.3px; color:#647082; }
.ncco-resfeat__card-body p{ margin:0; }

@media(max-width:1100px){
  .ncco-resfeat{ grid-template-columns:1fr; padding:80px 32px; gap:48px; }
}
@media(max-width:640px){
  .ncco-resfeat{ padding:56px 20px; border-radius:24px; }
  .ncco-resfeat__heading{ font-size:28px; letter-spacing:-1px; }
  .ncco-resfeat__body{ font-size:16px; }
  .ncco-resfeat__grid{ flex-direction:column; gap:16px; }
  .ncco-resfeat__col{ gap:16px; }
  .ncco-resfeat__col--1,
  .ncco-resfeat__col--2{ padding-top:0; padding-bottom:0; }
  .ncco-resfeat__left{ gap:28px; }
}
</style>

{% schema %}
{
  "name": "NCCO Residential Features",
  "tag": "section",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "WHY CHOOSE NCCO FOR HOME USE"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Built for Daily Comfort & Trusted Protection"},
    {"type": "richtext", "id": "body", "label": "Body text"},
    {"type": "richtext", "id": "note", "label": "Footnote text"}
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {"type": "text", "id": "icon_asset", "label": "Icon asset filename (assets/)"},
        {"type": "text", "id": "title", "label": "Title"},
        {"type": "richtext", "id": "body", "label": "Body text"}
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "NCCO Residential Features",
      "blocks": [
        {"type": "card", "settings": {"icon_asset": "benefit-icon-1.png", "title": "ACTIVE DECOMPOSITION", "body": "<p>Breaks down harmful gases, odors, bacteria, and VOCs at the molecular level.</p>"}},
        {"type": "card", "settings": {"icon_asset": "benefit-icon-3.png", "title": "FAMILY-SAFE TECHNOLOGY", "body": "<p>Zero ozone. Zero chemicals. 100% safe for babies, pets, and elderly family members.</p>"}},
        {"type": "card", "settings": {"icon_asset": "benefit-icon-2.png", "title": "WHISPER-QUIET OPERATION", "body": "<p>Operates silently in bedrooms, nurseries, and study areas.</p>"}},
        {"type": "card", "settings": {"icon_asset": "benefit-icon-6.png", "title": "LOW-MAINTENANCE DESIGN", "body": "<p>Filters last up to 12 years, reducing the need for replacements.</p>"}}
      ]
    }
  ]
}
{% endschema %}
