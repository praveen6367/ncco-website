{%- comment -%}
  NCCO Product Lineup
  Product showcase / collection tabs / draggable edge-to-edge carousel
{%- endcomment -%}

<section
  class="ncco-product-lineup"
  id="ncco-product-lineup-{{ section.id }}"
>
  <div class="ncco-product-lineup__inner">
    <!-- =========================================
         HEADER
    ========================================== -->
    <div class="ncco-product-lineup__header">
      <div class="ncco-product-lineup__header-left">
        {%- if section.settings.eyebrow != blank -%}
          <div class="ncco-product-lineup__eyebrow-wrap">
            <span class="ncco-product-lineup__dash"></span>
            <span class="ncco-product-lineup__eyebrow">{{ section.settings.eyebrow }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="ncco-product-lineup__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
      </div>

      <div class="ncco-product-lineup__header-right">
        {%- if section.settings.description != blank -%}
          <div class="ncco-product-lineup__description">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_url | default: '#' }}"
            class="ncco-product-lineup__button"
          >
            <span>{{ section.settings.button_label }}</span>
            <span class="ncco-product-lineup__button-icon">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2.5 9.5L9.5 2.5M9.5 2.5H4.5M9.5 2.5V7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        {%- endif -%}
      </div>
    </div>

    <!-- =========================================
         NAVIGATION / TABS
    ========================================== -->
    <div class="ncco-product-lineup__navigation">
      <div class="ncco-product-lineup__tabs">
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection_tab' -%}
            <button
              type="button"
              class="ncco-product-lineup__tab{% if forloop.first %} is-active{% endif %}"
              data-tab="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <!-- =========================================
       PRODUCT COLLECTIONS (EDGE TO EDGE CAROUSEL)
  ========================================== -->
  <div class="ncco-product-lineup__collections">
    {%- for block in section.blocks -%}
      {%- if block.type == 'collection_tab' -%}
        <div
          class="ncco-product-lineup__collection{% if forloop.first %} is-active{% endif %}"
          data-collection="{{ block.id }}"
        >
          <div class="ncco-product-lineup__track" id="track-{{ block.id }}">
            {%- if block.settings.image_source == 'images' -%}
              {%- for image_number in (1..4) -%}
                {%- assign image_key = 'image_' | append: image_number -%}
                {%- assign custom_image = block.settings[image_key] -%}
                {%- if custom_image != blank -%}
                  <article class="ncco-product-card">
                    <div class="ncco-product-card__image-wrap">
                      {{
                        custom_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '300, 450, 600, 750, 900',
                          sizes: '(max-width: 768px) 85vw, 340px',
                          class: 'ncco-product-card__image',
                          alt: block.settings.image_alt
                      }}
                    </div>
                  </article>
                {%- endif -%}
              {%- endfor -%}
            {%- elsif block.settings.collection != blank and block.settings.collection.products_count > 0 -%}
              {%- assign lineup_collection = block.settings.collection -%}
              {%- for product in lineup_collection.products limit: section.settings.products_to_show -%}
                <article class="ncco-product-card">
                  <div class="ncco-product-card__top">
                    <div class="ncco-product-card__meta">
                      <span class="ncco-product-card__model">{{ product.type | default: product.vendor | default: 'RHT' }}</span>
                      <a href="{{ product.url }}" class="ncco-product-card__title">{{ product.title }}</a>
                    </div>
                    <a href="{{ product.url }}" class="ncco-product-card__quick-view">
                      <span>{{ section.settings.quick_view_text | default: 'Quick View' }}</span>
                      <span class="ncco-product-card__arrow">↗</span>
                    </a>
                  </div>
                  <a href="{{ product.url }}" class="ncco-product-card__image-wrap">
                    {%- if product.featured_image != blank -%}
                      {{
                        product.featured_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '300, 450, 600, 750, 900',
                          sizes: '(max-width: 768px) 85vw, 340px',
                          class: 'ncco-product-card__image'
                      }}
                    {%- else -%}
                      <div class="ncco-product-card__placeholder">No image</div>
                    {%- endif -%}
                  </a>
                </article>
              {%- endfor -%}
            {%- else -%}
              <!-- Default / Fallback RHT Products from UI -->
              <article class="ncco-product-card">
                <div class="ncco-product-card__top">
                  <div class="ncco-product-card__meta">
                    <span class="ncco-product-card__model">RM-480</span>
                    <h3 class="ncco-product-card__title">Mobile Filtration Unit</h3>
                  </div>
                  <a href="{{ section.settings.button_url | default: '#' }}" class="ncco-product-card__quick-view">
                    <span>{{ section.settings.quick_view_text | default: 'Quick View' }}</span>
                    <span class="ncco-product-card__arrow">↗</span>
                  </a>
                </div>
                <div class="ncco-product-card__image-wrap">
                  <img src="{{ 'RM-480.png' | asset_url }}" alt="RM-480 Mobile Filtration Unit" class="ncco-product-card__image" loading="lazy">
                </div>
              </article>

              <article class="ncco-product-card">
                <div class="ncco-product-card__top">
                  <div class="ncco-product-card__meta">
                    <span class="ncco-product-card__model">RA-805</span>
                    <h3 class="ncco-product-card__title">Customised Deodorising System</h3>
                  </div>
                  <a href="{{ section.settings.button_url | default: '#' }}" class="ncco-product-card__quick-view">
                    <span>{{ section.settings.quick_view_text | default: 'Quick View' }}</span>
                    <span class="ncco-product-card__arrow">↗</span>
                  </a>
                </div>
                <div class="ncco-product-card__image-wrap">
                  <img src="{{ 'RA-805.png' | asset_url }}" alt="RA-805 Customised Deodorising System" class="ncco-product-card__image" loading="lazy">
                </div>
              </article>

              <article class="ncco-product-card">
                <div class="ncco-product-card__top">
                  <div class="ncco-product-card__meta">
                    <span class="ncco-product-card__model">RH-490C</span>
                    <h3 class="ncco-product-card__title">Ceiling Filtration Unit</h3>
                  </div>
                  <a href="{{ section.settings.button_url | default: '#' }}" class="ncco-product-card__quick-view">
                    <span>{{ section.settings.quick_view_text | default: 'Quick View' }}</span>
                    <span class="ncco-product-card__arrow">↗</span>
                  </a>
                </div>
                <div class="ncco-product-card__image-wrap">
                  <img src="{{ 'RH-490C.png' | asset_url }}" alt="RH-490C Ceiling Filtration Unit" class="ncco-product-card__image" loading="lazy">
                </div>
              </article>

              <article class="ncco-product-card">
                <div class="ncco-product-card__top">
                  <div class="ncco-product-card__meta">
                    <span class="ncco-product-card__model">RH-220</span>
                    <h3 class="ncco-product-card__title">Duct mounted mobile Unit</h3>
                  </div>
                  <a href="{{ section.settings.button_url | default: '#' }}" class="ncco-product-card__quick-view">
                    <span>{{ section.settings.quick_view_text | default: 'Quick View' }}</span>
                    <span class="ncco-product-card__arrow">↗</span>
                  </a>
                </div>
                <div class="ncco-product-card__image-wrap">
                  <img src="{{ 'RH-220.png' | asset_url }}" alt="RH-220 Duct mounted mobile Unit" class="ncco-product-card__image" loading="lazy">
                </div>
              </article>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<style>
#ncco-product-lineup-{{ section.id }} {
  --lineup-background: {{ section.settings.background_color | default: '#FFFFFF' }};
  --lineup-heading: {{ section.settings.heading_color | default: '#0A1C2E' }};
  --lineup-eyebrow: {{ section.settings.eyebrow_color | default: '#8295A8' }};
  --lineup-accent: {{ section.settings.accent_color | default: '#22B39F' }};
  --lineup-description: {{ section.settings.description_color | default: '#63778B' }};
  --lineup-card-background: {{ section.settings.card_background | default: '#F9F9FA' }};
  --lineup-card-radius: {{ section.settings.card_radius | default: 18 }}px;
  background: var(--lineup-background);
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  padding: 80px 0 90px;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 40px;
  box-sizing: border-box;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 48px;
  margin-bottom: 36px;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__header-left {
  flex: 1;
  max-width: 620px;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__eyebrow-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 16px;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__dash {
  display: block;
  width: 28px;
  height: 2.5px;
  background: var(--lineup-accent);
  border-radius: 2px;
  margin-bottom: 12px;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__eyebrow {
  font-family: 'Geist', sans-serif;
  font-size: 13px;
  line-height: 1.35;
  font-weight: 500;
  letter-spacing: 0.6px;
  color: var(--lineup-eyebrow);
  text-transform: uppercase;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__heading {
  margin: 0;
  font-family: 'Geist', sans-serif;
  font-size: clamp(34px, 3.8vw, 44px);
  line-height: 1.2;
  font-weight: 500;
  letter-spacing: -0.6px;
  color: var(--lineup-heading);
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  text-align: right;
  max-width: 480px;
  padding-top: 8px;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__description {
  font-family: 'Geist', sans-serif;
  font-size: 14px;
  line-height: 1.68;
  font-weight: 400;
  color: var(--lineup-description);
  margin-bottom: 24px;
  text-align: right;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__button {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  background-color: var(--lineup-accent);
  color: #FFFFFF;
  text-decoration: none;
  font-family: 'Geist', sans-serif;
  font-size: 13px;
  line-height: 1;
  font-weight: 500;
  letter-spacing: 0.3px;
  text-transform: uppercase;
  padding: 6px 6px 6px 20px;
  border-radius: 9999px;
  box-sizing: border-box;
  box-shadow: 0 4px 14px rgba(34, 179, 159, 0.22);
  transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  cursor: pointer;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__button:hover {
  background-color: #1CA290;
  transform: translateY(-1px);
  box-shadow: 0 6px 18px rgba(34, 179, 159, 0.32);
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__button-icon {
  width: 28px;
  height: 28px;
  min-width: 28px;
  border-radius: 50%;
  background-color: #FFFFFF;
  color: var(--lineup-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__button:hover .ncco-product-lineup__button-icon {
  transform: scale(1.05);
}

/* NAVIGATION / TABS */
#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__navigation {
  display: flex;
  align-items: center;
  margin-bottom: 36px;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__tabs {
  display: inline-flex;
  align-items: center;
  background: #F1F4F6;
  border-radius: 999px;
  padding: 4px;
  gap: 2px;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__tab {
  appearance: none;
  border: 0;
  background: transparent;
  border-radius: 999px;
  padding: 8px 22px;
  min-height: 34px;
  white-space: nowrap;
  cursor: pointer;
  font-family: 'Geist', sans-serif;
  font-size: 13px;
  font-weight: 500;
  color: #63778B;
  transition: all 0.2s ease;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__tab:hover {
  color: #0A1C2E;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__tab.is-active {
  background: #FFFFFF;
  color: #0A1C2E;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

/* CAROUSEL TRACK (EDGE TO EDGE) */
#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__collections {
  width: 100vw;
  position: relative;
  left: 50%;
  right: 50%;
  margin-left: -50vw;
  margin-right: -50vw;
  overflow: hidden;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__collection {
  display: none;
  width: 100%;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__collection.is-active {
  display: block;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__track {
  display: flex;
  gap: 24px;
  width: 100%;
  overflow-x: auto;
  scroll-behavior: smooth;
  scrollbar-width: none;
  -ms-overflow-style: none;
  padding: 8px calc(max(40px, (100vw - 1280px) / 2 + 40px)) 24px;
  box-sizing: border-box;
  cursor: grab;
  user-select: none;
  -webkit-overflow-scrolling: touch;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__track::-webkit-scrollbar {
  display: none;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-lineup__track.is-dragging {
  cursor: grabbing;
  scroll-behavior: auto;
}

/* CARDS */
#ncco-product-lineup-{{ section.id }} .ncco-product-card {
  position: relative;
  flex: 0 0 340px;
  width: 340px;
  min-width: 340px;
  height: 440px;
  background: #F9F9FA !important;
  border-radius: 18px !important;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 26px 26px 22px;
  box-sizing: border-box;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  overflow: hidden;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.05);
}

#ncco-product-lineup-{{ section.id }} .ncco-product-card__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  width: 100%;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-card__meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-card__model {
  font-family: 'Geist', sans-serif;
  font-size: 13.5px;
  font-weight: 600;
  color: var(--lineup-accent);
  letter-spacing: 0.2px;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-card__title {
  margin: 0;
  font-family: 'Geist', sans-serif;
  font-size: 15px;
  font-weight: 600;
  line-height: 1.35;
  color: #0A1C2E;
  text-decoration: none;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-card__quick-view {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-family: 'Geist', sans-serif;
  font-size: 13px;
  font-weight: 500;
  color: var(--lineup-accent);
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
  padding-top: 2px;
  transition: opacity 0.2s ease, transform 0.2s ease;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-card__quick-view:hover {
  opacity: 0.8;
  transform: translateX(1px);
}

#ncco-product-lineup-{{ section.id }} .ncco-product-card__arrow {
  font-size: 14px;
  line-height: 1;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-card__image-wrap {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px 0 0;
  box-sizing: border-box;
  text-decoration: none;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-card__image {
  max-width: 100%;
  max-height: 240px;
  width: auto;
  height: auto;
  object-fit: contain;
  transition: transform 0.35s ease;
}

#ncco-product-lineup-{{ section.id }} .ncco-product-card:hover .ncco-product-card__image {
  transform: scale(1.035);
}

/* RESPONSIVE */
@media (max-width: 992px) {
  #ncco-product-lineup-{{ section.id }} {
    padding: 60px 0 70px;
  }
  #ncco-product-lineup-{{ section.id }} .ncco-product-lineup__inner {
    padding: 0 32px;
  }
  #ncco-product-lineup-{{ section.id }} .ncco-product-lineup__header {
    flex-direction: column;
    gap: 24px;
    align-items: flex-start;
  }
  #ncco-product-lineup-{{ section.id }} .ncco-product-lineup__header-right {
    align-items: flex-start;
    text-align: left;
    max-width: 100%;
    padding-top: 0;
  }
  #ncco-product-lineup-{{ section.id }} .ncco-product-lineup__description {
    text-align: left;
    margin-bottom: 20px;
  }
  #ncco-product-lineup-{{ section.id }} .ncco-product-lineup__track {
    padding-left: 32px;
    padding-right: 32px;
  }
}

@media (max-width: 640px) {
  #ncco-product-lineup-{{ section.id }} {
    padding: 44px 0 54px;
  }
  #ncco-product-lineup-{{ section.id }} .ncco-product-lineup__inner {
    padding: 0 20px;
  }
  #ncco-product-lineup-{{ section.id }} .ncco-product-lineup__heading {
    font-size: 28px;
  }
  #ncco-product-lineup-{{ section.id }} .ncco-product-lineup__track {
    padding-left: 20px;
    padding-right: 20px;
    gap: 16px;
  }
  #ncco-product-lineup-{{ section.id }} .ncco-product-card {
    flex: 0 0 280px;
    width: 280px;
    min-width: 280px;
    height: 380px;
    padding: 20px 20px 18px;
  }
  #ncco-product-lineup-{{ section.id }} .ncco-product-card__image {
    max-height: 200px;
  }
}
</style>

<script>
(function () {
  const section = document.getElementById('ncco-product-lineup-{{ section.id }}');
  if (!section) return;

  const tabs = section.querySelectorAll('.ncco-product-lineup__tab');
  const collections = section.querySelectorAll('.ncco-product-lineup__collection');

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      const target = tab.getAttribute('data-tab');
      tabs.forEach(t => t.classList.remove('is-active'));
      collections.forEach(c => c.classList.remove('is-active'));
      tab.classList.add('is-active');
      const targetCollection = section.querySelector(
        '.ncco-product-lineup__collection[data-collection="' + target + '"]'
      );
      if (targetCollection) {
        targetCollection.classList.add('is-active');
      }
    });
  });

  const tracks = section.querySelectorAll('.ncco-product-lineup__track');
  tracks.forEach(function (track) {
    let isDown = false;
    let startX;
    let scrollLeft;
    let hasMoved = false;

    track.addEventListener('mousedown', function (e) {
      isDown = true;
      hasMoved = false;
      track.classList.add('is-dragging');
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
    });

    track.addEventListener('mouseleave', function () {
      isDown = false;
      track.classList.remove('is-dragging');
    });

    track.addEventListener('mouseup', function () {
      isDown = false;
      track.classList.remove('is-dragging');
    });

    track.addEventListener('mousemove', function (e) {
      if (!isDown) return;
      e.preventDefault();
      hasMoved = true;
      const x = e.pageX - track.offsetLeft;
      const walk = (x - startX) * 1.5;
      track.scrollLeft = scrollLeft - walk;
    });

    track.addEventListener('click', function (e) {
      if (hasMoved) {
        e.preventDefault();
      }
    });
  });
})();
</script>

{% schema %}

{
  "name": "NCCO Product Lineup",
  "tag": "section",

  "settings": [

    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Product Lineup"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NCCO-IG Skin Recovery Essence"
    },

    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "A clinically-tested skin recovery formula that hydrates, heals, and protects. Kills 99.9% of viruses and germs while soothing dry, sensitive, and allergy-prone skin all without toxins or alcohol."
    },

    {
      "type": "text",
      "id": "quick_view_text",
      "label": "Quick view text",
      "default": "Quick View"
    },

    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "View All Products"
    },

    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },


    {
      "type": "header",
      "content": "Product Settings"
    },

