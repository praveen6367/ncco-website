<section class="ncco-brands ncco-section">

  <div class="ncco-brands__header">
    <p class="ncco-brands__eyebrow">{{ section.settings.eyebrow | default: 'Our Brands' }}</p>
    <h2 class="ncco-brands__heading">{{ section.settings.heading | default: 'One Technology. Many Solutions.' }}</h2>
    <p class="ncco-brands__subtext">{{ section.settings.subtext | default: 'From home to industry, explore how each of our brands brings NCCO purification to life.' }}</p>
  </div>

  <div class="ncco-brands__grid">
    {% for block in section.blocks %}
      <div class="ncco-brands__card" {{ block.shopify_attributes }}>
        <div class="ncco-brands__logo-wrap">
          {% if block.settings.logo_asset != blank %}
            <img src="{{ block.settings.logo_asset | asset_url }}" alt="{{ block.settings.name }}" class="ncco-brands__logo" loading="lazy">
          {% endif %}
        </div>
        <div class="ncco-brands__text">
          <h3 class="ncco-brands__name">{{ block.settings.name }}</h3>
          <p class="ncco-brands__desc">{{ block.settings.description }}</p>
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.settings.cta_label != blank %}
    <div class="ncco-brands__cta-wrap">
      {%- render 'ncco-cta', label: section.settings.cta_label, url: section.settings.cta_url, variant: 'blue' -%}
    </div>
  {% endif %}

</section>

<style>
/* ── Figma Brands (1423:25625, 1920×1015) ── */
.ncco-brands { background: #fff; padding: 120px 240px; }

.ncco-brands__header {
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  max-width: 900px; margin: 0 auto 70px; text-align: center;
}
.ncco-brands__eyebrow {
  order: -1;
  font-family: 'Geist', sans-serif;
  font-size: 16px; font-weight: 500; letter-spacing: -0.32px;
  color: #647082; text-transform: uppercase; margin: 0;
}
.ncco-brands__eyebrow::before {
  content: ''; display: block; width: 28px; height: 2px; background: #FECB07; margin: 0 auto 8px;
}
.ncco-brands__heading {
  font-family: 'Geist', sans-serif;
  font-size: 58px; font-weight: 500; line-height: 68px; letter-spacing: -2.32px;
  color: #081D3A; margin: 24px 0 20px;
}
.ncco-brands__subtext {
  font-family: 'Geist', sans-serif;
  font-size: 18px; font-weight: 400; line-height: 24px; letter-spacing: -0.36px;
  color: #647082; margin: 0;
}

/* 6-col grid — items 1-2 span 3, items 3-5 span 2 */
.ncco-brands__grid {
  width: 100%;
  margin: 0 auto 48px;
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  column-gap: 30px;
  row-gap: 30px;
}
.ncco-brands__card:nth-child(1),
.ncco-brands__card:nth-child(2) {
  grid-column: span 3;
}
.ncco-brands__card:nth-child(3),
.ncco-brands__card:nth-child(4),
.ncco-brands__card:nth-child(5) {
  grid-column: span 2;
}

/* Card: horizontal logo + text — outer pastel wrapper 24, inner white 20 */
.ncco-brands__card {
  display: flex;
  align-items: stretch;
  gap: 0;
  border-radius: 24px;
  overflow: hidden;
  border: none;
}
/* Per-brand card colors — exact WP values */
.ncco-brands__card:nth-child(1) { background: rgba(255,203,8,0.08); }
.ncco-brands__card:nth-child(2) { background: rgba(16,149,146,0.08); }
.ncco-brands__card:nth-child(3) { background: rgba(0,176,217,0.08); }
.ncco-brands__card:nth-child(4) { background: rgba(57,181,74,0.05); }
.ncco-brands__card:nth-child(5) { background: rgba(16,149,146,0.08); }

.ncco-brands__logo-wrap {
  flex-shrink: 0;
  width: 180px;
  display: flex; align-items: center; justify-content: center;
  padding: 24px;
}
.ncco-brands__logo {
  max-width: 140px; max-height: 80px; width: 100%; height: auto; object-fit: contain;
}
.ncco-brands__text {
  padding: 28px 32px;
  flex: 1;
  gap: 12px;
  display: flex; flex-direction: column; justify-content: center;
  background: #ffffff;
  border-radius: 20px;
  margin: 24px 24px 24px 0;
  align-self: stretch;
  border: 1px solid rgba(100,112,130,0.08);
}
.ncco-brands__name {
  font-family: 'Geist', sans-serif;
  font-size: 24px; font-weight: 500; letter-spacing: -0.48px;
  color: #081D3A; margin: 0;
}
.ncco-brands__desc {
  font-family: 'Geist', sans-serif;
  font-size: 16px; font-weight: 400; line-height: 22px; letter-spacing: -0.32px;
  color: #647082; margin: 0;
}

.ncco-brands__cta-wrap { display: flex; justify-content: center; }

@media (max-width: 1600px) {
  .ncco-brands { padding: 100px 80px; }
  .ncco-brands__logo-wrap { width: 130px; padding: 16px; }
}
@media (max-width: 1400px) {
  /* Bottom row (span 2 in 6-col) gets cramped — collapse to 3-col so all cards span 2 equally */
  .ncco-brands__grid { grid-template-columns: repeat(4, 1fr); }
  .ncco-brands__card:nth-child(1),
  .ncco-brands__card:nth-child(2) { grid-column: span 2; }
  .ncco-brands__card:nth-child(3),
  .ncco-brands__card:nth-child(4),
  .ncco-brands__card:nth-child(5) { grid-column: span 2; }
  .ncco-brands__logo-wrap { width: 110px; padding: 14px; }
}
@media (max-width: 1200px) {
  .ncco-brands { padding: 80px 40px; }
  .ncco-brands__heading { font-size: 44px; line-height: 52px; letter-spacing: -1.5px; }
  .ncco-brands__grid { grid-template-columns: repeat(2, 1fr); }
  .ncco-brands__card:nth-child(n) { grid-column: span 1; }
  .ncco-brands__logo-wrap { width: 120px; padding: 14px; }
}
@media (max-width: 989px) {
  .ncco-brands { padding: 60px 24px; }
  .ncco-brands__heading { font-size: 36px; line-height: 44px; letter-spacing: -1.2px; }
  .ncco-brands__grid { grid-template-columns: 1fr; }
  .ncco-brands__logo-wrap { width: 120px; padding: 18px; }
  .ncco-brands__text { padding: 22px; margin: 16px 16px 16px 0; }
}
@media (max-width: 600px) {
  .ncco-brands { padding: 40px 16px; }
  .ncco-brands__heading { font-size: 28px; line-height: 36px; letter-spacing: -0.8px; }
  .ncco-brands__subtext { font-size: 15px; }
  .ncco-brands__header { margin-bottom: 32px; }

  /* Horizontal scroll row of vertical cards */
  .ncco-brands__grid {
    display: flex;
    flex-direction: row;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    gap: 12px;
    padding-bottom: 4px;
    scrollbar-width: none;
    margin-bottom: 32px;
  }
  .ncco-brands__grid::-webkit-scrollbar { display: none; }

  /* Vertical card: logo on top, text below */
  .ncco-brands__card {
    flex: 0 0 calc(75vw - 24px);
    scroll-snap-align: start;
    flex-direction: column;
    align-items: stretch;
  }
  .ncco-brands__logo-wrap {
    width: 100%;
    height: 180px;
    padding: 24px;
    box-sizing: border-box;
    border-radius: 0;
  }
  .ncco-brands__logo { max-width: 160px; max-height: 80px; }
  .ncco-brands__text {
    margin: 0 12px 12px;
    padding: 16px;
    border-radius: 16px;
  }
  .ncco-brands__name { font-size: 18px; }
  .ncco-brands__desc { font-size: 13px; line-height: 1.5; }

  /* Full-width CTA */
  .ncco-brands__cta-wrap { display: block; }
  .ncco-brands__cta-wrap .ncco-cta { width: 100%; justify-content: space-between; }
}
</style>

{% schema %}
{
  "name": "NCCO Brands",
  "tag": "section",
  "settings": [
    {"type": "text",     "id": "eyebrow",   "label": "Eyebrow",   "default": "Our Brands"},
    {"type": "text",     "id": "heading",   "label": "Heading",   "default": "One Technology. Many Solutions."},
    {"type": "textarea", "id": "subtext",   "label": "Subtext",   "default": "From home to industry, explore how each of our brands brings NCCO purification to life."},
    {"type": "text",     "id": "cta_label", "label": "CTA label", "default": "Explore All Brands"},
    {"type": "url",      "id": "cta_url",   "label": "CTA URL"}
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {"type": "text",     "id": "name",        "label": "Brand name"},
        {"type": "text",     "id": "logo_asset",  "label": "Logo filename (assets/)"},
        {"type": "textarea", "id": "description", "label": "Description"}
      ]
    }
  ],
  "presets": [{"name": "NCCO Brands"}]
}
{% endschema %}
