<section class="ncco-products">
  <div class="ncco-products__container">
    <div class="ncco-products__header">
      {% if section.settings.eyebrow != blank %}
        <div class="ncco-products__eyebrow">
          <span></span>
          {{ section.settings.eyebrow }}
        </div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="ncco-products__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="ncco-products__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>
    <div class="ncco-products__grid">
      {% for block in section.blocks %}
        <a
          {% if block.settings.link != blank %}
            href="{{ block.settings.link }}"
          {% else %}
            href="#"
          {% endif %}
          class="ncco-products__card ncco-products__card--{{ forloop.index }}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              srcset="
                {{ block.settings.image | image_url: width: 400 }} 400w,
                {{ block.settings.image | image_url: width: 700 }} 700w,
                {{ block.settings.image | image_url: width: 1200 }} 1200w
              "
              sizes="(max-width: 600px) 100vw, 33vw"
              alt="{{ block.settings.title | escape }}"
              loading="lazy"
              class="ncco-products__image"
            >
          {% else %}
            <div class="ncco-products__placeholder">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
          {% if block.settings.overlay %}
            <div
              class="ncco-products__overlay"
              style="opacity:{{ block.settings.overlay_opacity | divided_by: 100.0 }}"
            ></div>
          {% endif %}
          {% if block.settings.title != blank %}
            <div class="ncco-products__content">
              <h3>{{ block.settings.title }}</h3>
              {% if block.settings.text != blank %}
                <p>{{ block.settings.text }}</p>
              {% endif %}
            </div>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>
<style>
.ncco-products{
  width:100%;
  background:#fff;
  box-sizing:border-box;
  overflow:hidden;
}
.ncco-products__container{
  width:100%;
  max-width:1100px;
  margin:0 auto;
  padding:48px 24px 62px;
  box-sizing:border-box;
}
.ncco-products__header{
  display:flex;
  flex-direction:column;
  align-items:center;
  text-align:center;
  margin-bottom:27px;
}
.ncco-products__eyebrow{
  display:flex;
  align-items:center;
  justify-content:center;
  gap:0;
  margin:0 0 14px;
  font-family:'Geist',sans-serif;
  font-size:12px;
  line-height:16px;
  font-weight:400;
  color:#8295A8;
  text-transform:uppercase;
}
.ncco-products__eyebrow span{
  display:block;
  width:15px;
  height:1px;
  margin-right:0;
  background:#21B9A8;
}
.ncco-products__heading{
  margin:0;
  font-family:'Geist',sans-serif;
  font-size:44px;
  line-height:52px;
  font-weight:500;
  letter-spacing:-1.5px;
  color:#0D2028;
}
.ncco-products__description{
  max-width:390px;
  margin:8px auto 0;
  font-family:'Geist',sans-serif;
  font-size:16px;
  line-height:24px;
  font-weight:400;
  color:#8295A8;
}
.ncco-products__description p{
  margin:0;
}
.ncco-products__grid{
  width:100%;
  display:grid;
  grid-template-columns:1fr 1.72fr 1.36fr;
  grid-template-rows:180px 180px;
  column-gap:15px;
  row-gap:15px;
}

.ncco-products__card{
  position:relative;
  display:block;
  overflow:hidden;
  border-radius:12px;
  text-decoration:none;
  background:#E8ECEE;
  box-sizing:border-box;
}
.ncco-products__card--1{
  grid-column:1;
  grid-row:1;
}
.ncco-products__card--2{
  grid-column:2;
  grid-row:1;
}
.ncco-products__card--3{
  grid-column:3;
  grid-row:1;
}
.ncco-products__card--4{
  grid-column:1;
  grid-row:2;
  transform:scaleX(1.36);
  transform-origin:left center;
  width:73.5%;
}
.ncco-products__card--5{
  grid-column:2;
  grid-row:2;
  transform:translateX(-0.5px);
}
.ncco-products__card--6{
  grid-column:3;
  grid-row:2;
  transform:scaleX(1.27);
  transform-origin:right center;
  width:78.7%;
  justify-self:end;
}
.ncco-products__image{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  display:block;
  object-fit:cover;
  object-position:center center;
  transition:transform .35s ease;
}
.ncco-products__card:hover .ncco-products__image{
  transform:scale(1.04);
}
.ncco-products__overlay{
  position:absolute;
  inset:0;
  background:#081D3A;
  z-index:1;
  pointer-events:none;
}
.ncco-products__content{
  position:absolute;
  left:0;
  right:0;
  bottom:0;
  z-index:2;
  padding:22px 20px;
  color:#fff;
  text-align:center;
}
.ncco-products__content h3{
  margin:0;
  font-family:'Geist',sans-serif;
  font-size:16px;
  line-height:21px;
  font-weight:500;
  color:#fff;
}
.ncco-products__content p{
  margin:5px 0 0;
  font-family:'Geist',sans-serif;
  font-size:14px;
  line-height:21px;
  font-weight:400;
  color:#fff;
}
.ncco-products__placeholder{
  position:absolute;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#E8ECEE;
}
.ncco-products__placeholder svg{
  width:45px;
  height:45px;
  opacity:.35;
}
@media(max-width:900px){
  .ncco-products__container{
    max-width:760px;
    padding:45px 25px 50px;
  }
  .ncco-products__heading{
    font-size:40px;
    line-height:48px;
  }
  .ncco-products__grid{
    grid-template-rows:150px 150px;
  }
}
@media(max-width:600px){
  .ncco-products__container{
    padding:40px 20px 45px;
  }
  .ncco-products__header{
    margin-bottom:25px;
  }
  .ncco-products__eyebrow{
    font-size:11px;
    line-height:15px;
    margin-bottom:12px;
  }
  .ncco-products__heading{
    font-size:34px;
    line-height:41px;
    letter-spacing:-1px;
  }
  .ncco-products__description{
    max-width:330px;
    margin-top:8px;
    font-size:15px;
    line-height:23px;
  }
  .ncco-products__grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    grid-template-rows:170px 170px 170px 170px;
    gap:12px;
  }
  .ncco-products__card--1{
    grid-column:1;
    grid-row:1;
    width:100%;
    transform:none;
  }
  .ncco-products__card--2{
    grid-column:2;
    grid-row:1;
    width:100%;
    transform:none;
  }
  .ncco-products__card--3{
    grid-column:1 / span 2;
    grid-row:2;
    width:100%;
    transform:none;
  }
  .ncco-products__card--4{
    grid-column:1;
    grid-row:3;
    width:100%;
    transform:none;
  }
  .ncco-products__card--5{
    grid-column:2;
    grid-row:3;
    width:100%;
    transform:none;
  }
  .ncco-products__card--6{
    grid-column:1 / span 2;
    grid-row:4;
    width:100%;
    transform:none;
  }
  .ncco-products__content{
    padding:18px 15px;
  }
  .ncco-products__content h3{
    font-size:15px;
    line-height:20px;
  }
  .ncco-products__content p{
    font-size:14px;
    line-height:21px;
  }
}
</style>
{% schema %}
{
  "name":"NCCO Products",
  "tag":"section",
  "settings":[
    {
      "type":"text",
      "id":"eyebrow",
      "label":"Eyebrow",
      "default":"OUR PRODUCTS"
    },
    {
      "type":"text",
      "id":"heading",
      "label":"Heading",
      "default":"Explore Our Purifiers"
    },
    {
      "type":"richtext",
      "id":"description",
      "label":"Description",
      "default":"<p>Explore our range of portable air purifiers designed to deliver advanced protection in every environment.</p>"
    }
  ],
  "blocks":[
    {
      "type":"product",
      "name":"Product Image",
      "settings":[
        {
          "type":"image_picker",
          "id":"image",
          "label":"Image"
        },
        {
          "type":"text",
          "id":"title",
          "label":"Title"
        },
        {
          "type":"text",
          "id":"text",
          "label":"Description"
        },
        {
          "type":"url",
          "id":"link",
          "label":"Link"
        },
        {
          "type":"checkbox",
          "id":"overlay",
          "label":"Dark overlay",
          "default":false
        },
        {
          "type":"range",
          "id":"overlay_opacity",
          "min":0,
          "max":100,
          "step":5,
          "unit":"%",
          "label":"Overlay opacity",
          "default":45
        }
      ]
    }
  ],
  "max_blocks":6,
  "presets":[
    {
      "name":"NCCO Products",
      "blocks":[
        {
          "type":"product"
        },
        {
          "type":"product",
          "settings":{
            "title":"Yan Oi Tong Kindergarten",
            "overlay":true,
            "overlay_opacity":45
          }
        },
        {
          "type":"product"
        },
        {
          "type":"product"
        },
        {
          "type":"product"
        },
        {
          "type":"product"
        }
      ]
    }
  ]
}
{% endschema %}