{% assign img_asset = section.settings.asset %}
{% assign img_asset2 = section.settings.asset_secondary %}
{% assign reverse_layout = section.settings.reverse_layout %}
{% assign dual = false %}

{% if img_asset != blank and img_asset2 != blank %}
  {% assign dual = true %}
{% endif %}

{%- if section.settings.custom_css != blank -%}
  <style>{{ section.settings.custom_css }}</style>
{%- endif -%}
<section class="ncco-iwt ncco-section{% if section.settings.dark %} ncco-section--dark{% endif %}">

  <div class="ncco-container ncco-iwt__inner{% if reverse_layout %} ncco-iwt__inner--reverse{% endif %}">

    <!-- MOBILE INTRO -->
    <div class="ncco-iwt__mobile-intro">

      {% if section.settings.eyebrow != blank %}
        <p class="ncco-eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="ncco-iwt__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.intro != blank %}
        <div class="ncco-iwt__intro">
          {{ section.settings.intro }}
        </div>
      {% endif %}

    </div>


    <!-- IMAGE -->
    <div class="ncco-iwt__img{% if dual %} ncco-iwt__img--dual{% endif %}">

      {% if dual %}

        <img
          class="ncco-iwt__img-top"
          src="{{ img_asset | asset_url }}"
          alt="{{ section.settings.heading }}"
          loading="lazy"
        >

        <img
          class="ncco-iwt__img-bottom"
          src="{{ img_asset2 | asset_url }}"
          alt=""
          loading="lazy"
        >

        {% if section.settings.overlay_text != blank %}
          <div class="ncco-iwt__overlay-card">
            {{ section.settings.overlay_text }}
          </div>
        {% endif %}

      {% elsif section.settings.image != blank %}

        <img
          src="{{ section.settings.image | image_url: width: 800 }}"
          alt="{{ section.settings.heading }}"
          loading="lazy"
        >

      {% elsif img_asset != blank %}

        <img
          src="{{ img_asset | asset_url }}"
          alt="{{ section.settings.heading }}"
          loading="lazy"
        >

      {% else %}

        <div class="ncco-iwt__placeholder"></div>

      {% endif %}

    </div>


    <!-- DESKTOP TEXT -->
    <div class="ncco-iwt__text">

      {% if section.settings.eyebrow != blank %}
        <p class="ncco-eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="ncco-iwt__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="ncco-iwt__body">
          {{ section.settings.text }}
        </div>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        <div class="ncco-iwt__cta">
          {%- render 'ncco-cta',
            label: section.settings.cta_label,
            url: section.settings.cta_url,
            variant: 'blue'
          -%}
        </div>
      {% endif %}

    </div>


    <!-- MOBILE BODY -->
    <div class="ncco-iwt__mobile-body">

      {% if section.settings.text != blank %}
        <div class="ncco-iwt__body">
          {{ section.settings.text }}
        </div>
      {% endif %}

      {% if section.settings.cta_label != blank %}
        <div class="ncco-iwt__cta">
          {%- render 'ncco-cta',
            label: section.settings.cta_label,
            url: section.settings.cta_url,
            variant: 'blue'
          -%}
        </div>
      {% endif %}

    </div>

  </div>

</section>


<style>

/* ================================
   SECTION
================================ */

.ncco-iwt {
  padding: 100px 240px;
}

.ncco-iwt .ncco-container {
  max-width: 100%;
  padding: 0;
}

.ncco-iwt__inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 100px;
  align-items: center;
}


/* ================================
   DESKTOP POSITION
================================ */

/* DEFAULT:
   TEXT LEFT / IMAGE RIGHT
*/

.ncco-iwt__text {
  order: 1;
}

.ncco-iwt__img {
  order: 2;
}


/* TOGGLE ON:
   IMAGE LEFT / TEXT RIGHT
*/

.ncco-iwt__inner--reverse .ncco-iwt__text {
  order: 2;
}

.ncco-iwt__inner--reverse .ncco-iwt__img {
  order: 1;
}


/* ================================
   MOBILE ELEMENTS HIDDEN DESKTOP
================================ */

.ncco-iwt__mobile-intro,
.ncco-iwt__mobile-body {
  display: none;
}


/* ================================
   NORMAL IMAGE
================================ */

.ncco-iwt__img:not(.ncco-iwt__img--dual) img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 24px;
}


/* ================================
   DUAL IMAGE
================================ */

.ncco-iwt__img--dual {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.ncco-iwt__img-top {
  flex: 0 0 252px;
  width: 62%;
  object-fit: cover;
  border-radius: 16px;
  display: block;
}

.ncco-iwt__img-bottom {
  flex: 0 0 252px;
  width: 100%;
  object-fit: cover;
  border-radius: 16px;
  display: block;
}


/* ================================
   OVERLAY CARD
================================ */

.ncco-iwt__overlay-card {
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);

  width: 36%;
  height: 210px;

  background: #081D3A;
  border-radius: 20px;

  display: flex;
  align-items: center;
  justify-content: center;

  font-family: 'Geist', sans-serif;
  font-size: 22px;
  font-weight: 700;
  line-height: 1.4;

  color: #fff;
  text-align: center;

  white-space: pre-line;

  padding: 16px;
  box-sizing: border-box;
}


/* ================================
   TEXT
================================ */

.ncco-iwt__text .ncco-eyebrow {
  margin-bottom: 40px;
}

.ncco-iwt__heading {
  font-family: 'Geist', sans-serif;

  font-size: 48px;
  font-weight: 600;
  line-height: 56px;
  letter-spacing: -1.5px;

  margin: 0 0 24px;

  color: #081D3A;
}

.ncco-section--dark .ncco-iwt__heading {
  color: #fff;
}

.ncco-iwt__body {
  font-family: 'Geist', sans-serif;

  font-size: 18px;
  font-weight: 400;
  line-height: 28px;
  letter-spacing: -0.36px;

  color: #647082;
}

.ncco-section--dark .ncco-iwt__body {
  color: #97A0AC;
}

.ncco-iwt__body p {
  margin: 0 0 16px;
}

.ncco-iwt__body p:last-child {
  margin-bottom: 0;
}

.ncco-iwt__cta {
  margin-top: 40px;
}


/* ================================
   PLACEHOLDER
================================ */

.ncco-iwt__placeholder {
  aspect-ratio: 5/4;
  background: var(--ncco-grey-bg);
  border-radius: 24px;
}


/* ================================
   1600px
================================ */

@media (max-width: 1600px) {

  .ncco-iwt {
    padding: 80px 80px;
  }

  .ncco-iwt__inner {
    gap: 60px;
  }

}


/* ================================
   TABLET
================================ */

@media (max-width: 1024px) {

  .ncco-iwt {
    padding: 60px 40px;
  }

  .ncco-iwt__inner {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .ncco-iwt__heading {
    font-size: 40px;
    line-height: 48px;
  }

  /* Reset desktop ordering on stacked layout */

  .ncco-iwt__img,
  .ncco-iwt__text,
  .ncco-iwt__inner--reverse .ncco-iwt__img,
  .ncco-iwt__inner--reverse .ncco-iwt__text {
    order: unset;
  }

}


/* ================================
   PHONE
================================ */

@media (max-width: 768px) {

  .ncco-iwt {
    padding: 40px 18px;
  }

  .ncco-iwt__inner {
    display: flex;
    flex-direction: column;
    gap: 0;
    align-items: center;
  }


  /* --------------------------------
     INTRO ABOVE IMAGE
  -------------------------------- */

  .ncco-iwt__mobile-intro {
    display: block;
    width: 100%;
    text-align: center;

    order: 1;

    margin-bottom: 32px;
  }

  .ncco-iwt__mobile-intro .ncco-eyebrow {
    margin: 0 0 24px;
  }

  .ncco-iwt__mobile-intro .ncco-eyebrow::before {
    margin-left: auto;
    margin-right: auto;
  }

  .ncco-iwt__mobile-intro .ncco-iwt__heading {
    margin-bottom: 20px;
  }

  .ncco-iwt__intro {
    font-family: 'Geist', sans-serif;
    font-size: 15px;
    line-height: 23px;
    color: #647082;
    text-align: center;
  }


  /* --------------------------------
     IMAGE
  -------------------------------- */

  .ncco-iwt__img {
    width: 100%;
    order: 2;
  }

  .ncco-iwt__img--dual {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;

    position: relative;
  }


  /* TOP IMAGE */

  .ncco-iwt__img-top {
    flex: none;

    width: 82%;
    height: 160px;

    object-fit: cover;

    border-radius: 16px;

    margin: 0 auto;
  }


  /* BOTTOM IMAGE */

  .ncco-iwt__img-bottom {
    flex: none;

    width: 100%;
    height: 210px;

    object-fit: cover;

    border-radius: 16px;

    margin: 0 auto;
  }


  /* --------------------------------
     OVERLAY CARD
  -------------------------------- */

  .ncco-iwt__overlay-card {

    top: 50%;
    right: 3%;

    transform: translateY(-50%);

    width: 48%;
    height: 105px;

    border-radius: 12px;

    font-size: 16px;
    line-height: 1.5;

    padding: 12px;

  }


  /* --------------------------------
     BODY BELOW IMAGE
  -------------------------------- */

  .ncco-iwt__mobile-body {

    display: block;

    width: 100%;

    order: 3;

    margin-top: 40px;

    text-align: center;
  }

  .ncco-iwt__mobile-body .ncco-iwt__body {
    font-size: 15px;
    line-height: 23px;
    text-align: center;
  }

  .ncco-iwt__mobile-body .ncco-iwt__body p {
    margin-bottom: 16px;
  }


  /* --------------------------------
     HIDE DESKTOP TEXT
  -------------------------------- */

  .ncco-iwt__text {
    display: none;
  }


  /* --------------------------------
     CTA
  -------------------------------- */

  .ncco-iwt__mobile-body .ncco-iwt__cta {
    margin-top: 28px;

    display: flex;
    justify-content: center;
  }


  /* --------------------------------
     HEADING
  -------------------------------- */

  .ncco-iwt__heading {

    font-size: 30px;
    line-height: 38px;
    letter-spacing: -1px;

    text-align: center;
  }

}


/* ================================
   SMALL PHONE
================================ */

@media (max-width: 480px) {

  .ncco-iwt {
    padding: 36px 16px;
  }

  .ncco-iwt__mobile-intro {
    margin-bottom: 28px;
  }

  .ncco-iwt__heading {
    font-size: 28px;
    line-height: 36px;
  }

  .ncco-iwt__img-top {
    width: 82%;
    height: 150px;
  }

  .ncco-iwt__img-bottom {
    width: 100%;
    height: 205px;
  }

  .ncco-iwt__overlay-card {
    width: 48%;
    height: 100px;
    font-size: 15px;
  }

}

</style>


{% schema %}

{
  "name": "NCCO Image + Text",
  "tag": "section",

  "settings": [

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },

    {
      "type": "richtext",
      "id": "intro",
      "label": "Mobile Intro Text"
    },

    {
      "type": "richtext",
      "id": "text",
      "label": "Body text"
    },

    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (use Theme Editor)"
    },

    {
      "type": "text",
      "id": "asset",
      "label": "Image asset filename"
    },

    {
      "type": "text",
      "id": "asset_secondary",
      "label": "Second image asset"
    },

    {
      "type": "text",
      "id": "overlay_text",
      "label": "Overlay card text"
    },

    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse image and text position",
      "default": false
    },

    {
      "type": "text",
      "id": "cta_label",
      "label": "Button text"
    },

    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },

    {
      "type": "checkbox",
      "id": "dark",
      "label": "Dark background",
      "default": false
    },

    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS (advanced, this page only)"
    }

  ],

  "presets": [
    {
      "name": "NCCO Image + Text"
    }
  ]
}

{% endschema %}