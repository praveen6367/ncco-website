    "ncco-iwt-mission": {
      "type": "ncco-image-with-text",
      "settings": {
        "eyebrow": "我們的使命與願景",
        "heading": "目標驅動，科學賦能。",
        "text": "<p><strong>我們的使命</strong><br/>透過尖端納米催化技術提供可持續的空氣淨化方案，讓每個人都能呼吸到潔淨健康的空氣。我們致力於消除室內空氣污染——不只是過濾，而是在分子層面將污染物徹底分解，提供更安全、更長效的保護。</p><p><strong>我們的願景</strong><br/>讓每個空間——從家居到醫院、從學校到工廠——都受到智能、科學支撐的空氣淨化系統保護。我們期望實現一個潔淨空氣不再是奢侈品，而是每個人基本權利的未來，以創新與責任為本。</p>",
        "asset": "ncco-about-mission-collage.png",
        "asset_secondary": "",
        "overlay_text": "",
        "layout": "image_first",
        "dark": false,
        "bg_color": "#ffffff"
      }
    },
    "ncco-iwt-science": {
      "type": "ncco-feature-split",
      "settings": {
        "eyebrow": "我們的故事",
        "heading": "科學為根，走向全球。",
        "body": "<p>NCCO（氧聚解，Nano Confined Catalytic Oxidation）是我們專利空氣淨化系統的核心技術。</p><p>由頂尖科研專家創立，我們已發展為享譽全球的專業品牌，旗下擁有五個專屬子品牌，深受超過30個國家的信賴。我們的技術不僅是捕捉污染物，而是在分子層面將其徹底分解消除。</p>",
        "dark": false,
        "bg_color": "#6470820A"
      },
      "blocks": {
        "feat_1": {
          "type": "feature",
          "settings": {
            "icon_asset": "patendedtech.png",
            "title": "國際專利技術",
            "body": "經科學實證並獲專利認證，能在分子層面分解污染物，實現長效空氣淨化。"
          }
        },
        "feat_2": {
          "type": "feature",
          "settings": {
            "icon_asset": "secondarypollution.png",
            "title": "零二次污染",
            "body": "NCCO淨化空氣時不會釋放任何有害副產品，確保潔淨空氣持久純淨，適用於各類環境。"
          }
        },
        "feat_3": {
          "type": "feature",
          "settings": {
            "icon_asset": "12year.png",
            "title": "12年長效濾芯",
            "body": "耐用濾芯專為長效高效設計，在維持十多年卓越性能的同時，大幅減少耗材浪費。"
          }
        },
        "feat_4": {
          "type": "feature",
          "settings": {
            "icon_asset": "multibrand.png",
            "title": "多品牌體系",
            "body": "一項核心技術，五個全球子品牌，深獲超過30個國家的醫院、家居、工廠及公共場所信賴。"
          }
        }
      },
      "block_order": [
