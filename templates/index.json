    "ncco-faq": {
      "type": "ncco-faq",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "heading": "Is there any oxygen consumed during the NCCO process?",
            "answer": "<p>No. The NCCO process is a catalytic reaction — the catalyst facilitates the oxidation of pollutants without being consumed itself. Oxygen acts as the oxidising agent, but the catalyst remains intact for up to 12 years under normal use.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "heading": "What contaminants can NCCO technology break down?",
            "answer": "<p>NCCO technology effectively breaks down VOCs (volatile organic compounds), formaldehyde, benzene, toluene, bacteria, viruses, mould spores, and odours at the molecular level — converting them into harmless water vapour and CO₂.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "heading": "How long does the NCCO catalyst last?",
            "answer": "<p>The NCCO catalyst has a lifespan of up to 12 years under normal maintenance conditions. Unlike HEPA filters which require frequent replacement, the catalyst does not degrade during the purification process.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "heading": "Does NCCO technology produce any harmful by-products?",
            "answer": "<p>No. The catalytic oxidation process converts pollutants exclusively into water vapour and carbon dioxide — both harmless and naturally occurring. There is no secondary pollution, ozone generation, or toxic residue.</p>"
          }
        }
      },
      "block_order": [
        "faq_1",
