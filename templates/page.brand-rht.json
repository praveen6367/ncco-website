    "ncco_industrial_brand_ApdFX7": {
      "type": "ncco-industrial-brand",
      "blocks": {
        "feature_LbzTLz": {
          "type": "feature",
          "settings": {
            "title": "擴大潔淨空氣規模",
            "text": "我們為醫院、交通設施（如港鐵、香港國際機場）和工廠（如 CPL Aromas、新科磁電製品廠）開發工業級空氣淨化系統，這些系統旨在連續可靠地運行。"
          }
        },
        "feature_rtFdXz": {
          "type": "feature",
          "settings": {
            "title": "為關鍵基礎設施而建",
            "text": "RHT 設備採用 NCCO 專利技術，專為高要求空間設計。這些空間包括需要致癌物控制的醫院病理科實驗室，以及用於隔離的防疫流動方艙。NCCO 系統高效且適應性強，具備模組化安裝能力（可整合到 AHU/PAU 中），因而深受專業人士的信賴。"
          }
        },
