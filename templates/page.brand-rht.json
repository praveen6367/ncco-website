    "ncco_industrial_solutions_xibykQ": {
      "type": "ncco-industrial-solutions",
      "blocks": {
        "solution_nXUHnb": {
          "type": "solution",
          "settings": {
            "title": "NCCO-AIR",
            "description": "<p>NCCO（氧聚解）適合家居空氣淨化，亦廣泛應用於商業、工業及醫療機構。</p>",
            "link_text": "了解更多",
            "link_url": ""
          }
        },
        "solution_jkR36W": {
          "type": "solution",
          "settings": {
            "title": "NCCO-INVISIBLE GLOVE",
            "description": "<p>NCCO技術利用納米技術在皮膚表面形成薄膜，具消毒、保濕及保護受損皮膚免受感染的功效。</p>",
            "link_text": "了解更多",
            "link_url": ""
          }
        },
        "solution_7N4keU": {
          "type": "solution",
          "settings": {
            "title": "NCCO-ZRD",
            "description": "<p>ZRD（沸石放射性塵埃清除系統）是RHT的專利技術之一。ZRD系統能有效清除空氣中的放射性物質及有毒氣體，可用作緊急系統。</p>",
            "link_text": "了解更多",
            "link_url": ""
          }
        },
        "solution_LY8hcU": {
          "type": "solution",
          "settings": {
            "title": "NCCO-PIS",
            "description": "<p>工業生產在日常製造過程中釋放大量污染物，對附近建築物造成嚴重污染。污染物隔離系統（PIS）創建室內空氣屏障，防止室外污染物進入室內。</p>",
            "link_text": "了解更多",
            "link_url": ""
          }
        },
        "solution_t8ACQ7": {
          "type": "solution",
          "settings": {
            "title": "NCCO-MASKS",
            "description": "<p>工業生產中常使用許多有毒化合物，嚴重危害員工健康。RHT研究團隊成功利用NCCO技術開發了NCCO口罩。</p>",
            "link_text": "了解更多",
            "link_url": ""
          }
        },
        "solution_HBj6m6": {
          "type": "solution",
          "settings": {
            "title": "NCCO-MDS",
            "description": "<p>污水處理廠長期散發惡臭。目前主要採用活性炭空氣淨化系統去除異味。</p>",
            "link_text": "了解更多",
            "link_url": ""
          }
        }
      },
