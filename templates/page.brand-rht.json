    "ncco_industrial_benefits_Gb7TbA": {
      "type": "ncco-industrial-benefits",
      "blocks": {
        "benefit_gaXwt9": {
          "type": "benefit",
          "settings": {
            "icon": "layers",
            "title": "專為大型空間淨化設計",
            "text": "系統能在醫院、車站和工廠等場所淨化高空氣流量。它能高效分解包括甲醛等一級致癌物、VOCs 以及殺滅病毒。"
          }
        },
        "benefit_JmLr8h": {
          "type": "benefit",
          "settings": {
            "icon": "puzzle",
            "title": "模組化安裝能力",
            "text": "RHT設備具備模組化安裝特性，能適應多樣化的基礎設施。NCCO 反應層附加組件可加裝到現有的 PAU/AHU (空氣處理機組) 通風系統中。"
          }
        },
        "benefit_gNBeX3": {
          "type": "benefit",
          "settings": {
            "icon": "clock",
            "title": "24/7 可靠運作",
            "text": "NCCO 系統能夠進行不間斷的空氣處理。由於污染物被徹底分解為水和二氧化碳，濾芯不會積存污染物，從而確保無二次污染。"
          }
        },
        "benefit_4WnhnD": {
          "type": "benefit",
          "settings": {
            "icon": "technology",
            "title": "專利 NCCO 技術支持",
            "text": "NCCO 技術由香港科技大學創業計畫成員研發，利用專利納米技術 驅動淨化，在分子層面上分解污染物。"
          }
        },
        "benefit_DckJhc": {
          "type": "benefit",
          "settings": {
            "icon": "energy",
            "title": "能源效益設計",
            "text": "系統能有效去除異味，從而減少換氣次數及冷氣使用量。這設計能直接降低能源消耗和營運成本。"
          }
        },
        "benefit_n9pQK9": {
          "type": "benefit",
          "settings": {
            "icon": "tools",
            "title": "低維護，長壽命",
            "text": "NCCO反應層使用可循環再用的人工礦物作為催化劑，並具備循環再生能力。在正常維護保養下，濾芯壽命長達 12 年，有效減少濾芯更換週期和成本。"
          }
        }
      },
