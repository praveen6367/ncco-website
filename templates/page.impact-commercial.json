    "ncco_res_commitment": {
      "type": "ncco-residential-commitment",
      "name": "NCCO Residential Commitment",
      "settings": {
        "image_1": "ncco-res-collage-1.jpg",
        "image_2": "ncco-res-collage-2.jpg",
        "image_3": "ncco-res-collage-3.jpg",
        "image_4": "ncco-res-collage-4.jpg",
        "image_5": "ncco-res-collage-5.jpg",
        "image_6": "ncco-res-collage-6.jpg",
        "stat_number": "99%",
        "stat_label": "空氣淨化效率",
        "eyebrow": "我們對家居的承諾",
        "heading": "潔淨空氣，香港家庭信賴之選",
        "body": "<p>我們很榮幸成為香港最暢銷的家用空氣淨化品牌，將日常生活空間轉化為更潔淨、更安全的環境。我們成熟的 NCCO 技術，透過長效保護與智能設計，為您帶來安心。</p>",
        "point_1_title": "為何重要",
        "point_1_body": "<p>室內空氣看似潔淨，但往往藏有來自清潔劑、傢俬及日常生活的有害污染物。這些肉眼看不見的微粒可能影響睡眠、呼吸及家人健康。NCCO 淨化器不僅捕捉污染物，更主動將其分解，確保真正潔淨的空氣。</p>",
        "point_2_title": "我們解決的問題",
        "point_2_body": "<p>從化學氣味、烹飪油煙到過敏原及寵物毛屑，NCCO 系統淨化您家中每個角落。無論是睡房、嬰兒房或廚房，我們寧靜的醫療級技術，為小孩、長者及寵物締造更潔淨健康的空間。</p>",
        "cta_label": "預約免費諮詢",
        "cta_url": "/pages/contact-us"
      }
    },
    "ncco_res_features": {
      "type": "ncco-residential-features",
      "name": "NCCO Residential Features",
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "icon_asset": "benefit-icon-1.png",
            "title": "主動分解技術",
            "body": "<p>在分子層面分解有害氣體、異味、細菌及揮發性有機物，只留下潔淨、可自由呼吸的空氣。</p>"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "icon_asset": "benefit-icon-3.png",
            "title": "家庭安全科技",
            "body": "<p>零臭氧、零化學物質——以健康為本的設計，100% 適合嬰兒、寵物及家中長者。</p>"
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "icon_asset": "benefit-icon-2.png",
            "title": "靜音運作",
            "body": "<p>於睡房、嬰兒房及書房靜音運作，不打擾家人休息與生活。</p>"
          }
        },
        "card_4": {
          "type": "card",
          "settings": {
            "icon_asset": "benefit-icon-6.png",
            "title": "低維護設計",
            "body": "<p>耐用工程設計，濾芯使用壽命長達12年，大幅減少更換需求，讓您安心無憂。</p>"
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2",
        "card_3",
        "card_4"
      ],
      "settings": {
        "eyebrow": "家居專用，選擇NCCO的理由",
        "heading": "為日常舒適而生，值得信賴的保護",
        "body": "<p>NCCO 將醫療級空氣淨化技術帶入日常家居，結合持久效能、寧靜運作及家庭安全科技。從細小的市區單位到寬敞的大宅，NCCO 為香港家庭提供值得信賴的保護。</p>",
        "note": "<p>NCCO（納米局限催化氧化）不僅止於過濾——它能徹底分解有害污染物，而非僅僅隱藏它們。</p><p>它不只捕捉污染物，更將其徹底分解。</p>"
      }
    },
    "ncco_res_before_after": {
      "type": "ncco-residential-before-after",
      "name": "NCCO Residential Before/After",
      "settings": {
        "image_before": "ncco-img-residential-room.png",
        "label_before": "淨化前",
        "image_after": "ncco-img-air-purifier-room.png",
        "label_after": "淨化後",
        "eyebrow": "家居淨化成效",
        "heading": "看得見、呼吸得到的真實轉變",
        "body": "<p>NCCO 技術為您家中的空氣質素帶來明顯而持久的改善。從濃重異味、過敏原到有害室內污染物，我們的系統不僅過濾空氣——更徹底轉化它。</p><p>NCCO 原本專為醫院設計，如今已獲香港數千個家庭信賴，將醫療級保護帶到您最重視的地方：客廳、睡房及家庭生活空間。</p><p>親身感受淨化前後的分別——更新鮮、更安全的空氣，由此開始。</p>",
        "cta_label": "預約免費諮詢",
        "cta_url": "/pages/contact-us"
      }
    },
    "ncco_res_pollutants": {
      "type": "ncco-residential-pollutants",
      "name": "NCCO Residential Pollutants",
      "blocks": {
        "card_1": {
          "type": "card",
          "settings": {
            "light": false,
            "title": "傢俬釋出的甲醛",
            "body": "<p>來自油漆、木製品及黏合劑，這種有害毒素可在室內空氣中殘留多年。</p>"
          }
        },
        "card_2": {
          "type": "card",
          "settings": {
            "light": true,
            "title": "寵物毛屑及過敏原",
            "body": "<p>來自寵物、塵蟎及布藝的微細顆粒，可能引發過敏、哮喘及皮膚敏感，對兒童影響尤甚。</p>"
          }
        },
        "card_3": {
          "type": "card",
          "settings": {
            "light": true,
            "title": "烹飪油煙及異味",
            "body": "<p>日常烹飪產生的油煙與氣味會黏附於傢俬及布藝，在用餐後久久不散。</p>"
          }
        },
        "card_4": {
          "type": "card",
          "settings": {
            "light": false,
            "title": "清潔劑及噴霧中的VOC",
            "body": "<p>日常清潔用品釋放的揮發性有機化合物（VOCs），可能刺激皮膚、眼睛及呼吸系統。</p>"
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2",
        "card_3",
        "card_4"
      ],
      "settings": {
        "eyebrow": "常見室內污染物",
        "heading": "您家中的空氣，藏著什麼？",
        "body": "<p>即使看似一塵不染的家居，仍可能潛藏影響家人健康的有害污染物。NCCO 的先進技術能針對性分解這些污染物，為您帶來真正潔淨、安全的空氣。</p>"
      }
    },
    "ncco_res_faq": {
      "type": "ncco-faq",
      "name": "NCCO Residential FAQ",
      "blocks": {
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "heading": "NCCO 空氣淨化器有何獨特之處？",
            "answer": "<p>NCCO 不僅捕捉污染物，更將其徹底分解，確保空氣更潔淨，不會產生二次污染。</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "heading": "什麼是活性氧？對人體有害嗎？",
            "answer": "<p>活性氧是 NCCO 催化程序中產生的高反應性氧分子。其濃度遠低於對人體有害的水平，並已通過認證，可安全於有人使用的空間內持續運作。</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "heading": "淨化過程中產生的活性氧會影響健康嗎？",
            "answer": "<p>不會。NCCO 納米孔反應層內產生的活性氧，會在進入環境空氣前已用於分解污染物，對人、寵物及植物均完全安全。</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "heading": "為何殺菌效率未能達到100%？",
            "answer": "<p>在現實環境中，由於空氣中的污染物會持續產生，沒有任何淨化技術能達致絕對100%殺菌。NCCO 在標準化測試條件下，可分解超過99%的目標污染物，處於業界領先水平。</p>"
          }
        },
        "faq_5": {
          "type": "faq_item",
          "settings": {
            "heading": "NCCO 氧聚解反應層的實際使用壽命有多長？",
            "answer": "<p>NCCO 催化反應層在正常家居使用下，設計壽命長達12年。與需要頻密更換的傳統濾網不同，反應層能透過催化程序自我再生，大幅降低長期維護成本。</p>"
          }
        }
      },
      "block_order": [
        "faq_1",
        "faq_2",
        "faq_3",
        "faq_4",
        "faq_5"
      ],
      "settings": {
        "eyebrow": "",
        "heading": "你需要知道的一切",
        "bg_image": "ncco-faq-bg.png"
      }
    }
