    "ncco_text_image_tw4rWp": {
      "type": "ncco-text-image",
      "name": "NCCO Image + Text",
      "settings": {
        "eyebrow": "產品認證",
        "heading": "權威認證・全球信賴",
        "intro": "",
        "text": "<p>NCCO空氣淨化技術不只是創新——更獲國際認可認證及實際使用性能支持。從FDA批准到CE合規，NCCO達到全球最高安全及性能標準。獲全球醫院、機場、公共交通系統及家庭信賴，NCCO為可持續高效空氣淨化樹立新標準。</p>",
        "image": "",
        "asset": "ncco-certifications-web.png",
        "asset_secondary": "",
        "overlay_text": "",
        "cta_label": "探索NCCO",
        "cta_url": "",
        "dark": false,
        "custom_css": ".ncco-iwt{padding:clamp(32px,4.0625vw,78px) clamp(24px,9.27vw,178px) !important;}"
      }
