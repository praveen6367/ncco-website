    "ncco-contact-cta": {
      "type": "ncco-contact-cta",
      "settings": {
        "eyebrow": "聯絡我們",
        "heading": "隨時為你提供專業方案",
        "subtext": "無論你有任何查詢、需要產品詳情，或想探討合作機會，我們都非常樂意與你聯繫。",
        "email": "sales@rhtind.com.hk",
